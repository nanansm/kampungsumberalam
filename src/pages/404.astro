---
/* Wajib ada. Tanpa berkas ini Cloudflare Pages melayani beranda dengan status 200
   untuk path tak dikenal, dan Google membacanya sebagai beranda terduplikasi. */
import Situs from "../layouts/Situs.astro";
import id from "../i18n/id.json";
---
<Situs lang="id" T={id} title="Halaman tidak ditemukan · Kampung Sumber Alam" description="Halaman yang dicari tidak ada di kampungsumberalam.com." waPesan={id["wa.umum"]} noindex>
  <section style="min-height:62svh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:64px var(--pad);background:var(--putih)">
    <p class="lbl">404</p>
    <h1 style="margin-top:14px;font-size:clamp(2rem,6vw,3.4rem)">Halaman ini tidak ada</h1>
    <p style="margin-top:14px;color:var(--tinta-2)">Tautannya mungkin sudah berubah atau salah ketik. <span lang="en">This page does not exist.</span></p>
    <div style="margin-top:28px;display:flex;gap:12px;flex-wrap:wrap;justify-content:center">
      <a class="btn btn-isi" href="/">Kembali ke beranda</a>
      <a class="btn" href="/en/" hreflang="en" lang="en">English homepage</a>
    </div>
  </section>
</Situs>
