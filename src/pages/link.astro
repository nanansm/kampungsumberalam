---
/* Biolink untuk Instagram/TikTok/Facebook. Pola Sibentang /link: foto atas, logo, tombol pil.
   Carousel = foto hero HP homepage, ganti tiap 3 detik. Tidak masuk sitemap. */
import { getImage } from "astro:assets";
import { BOOKING_URL, TRAVELOKA_URL, AGODA_URL, MAPS_URL, IG_URL, FB_URL, TIKTOK_URL, SITE, waLink } from "../data/content";
import id from "../i18n/id.json";
const T: Record<string, string> = id;
const mods = import.meta.glob<{ default: ImageMetadata }>("../assets/foto/hero-hp-*.jpg", { eager: true });
const W = [480, 720, 960];
const slides = await Promise.all([1, 2, 3, 4, 5].map(async (n) => {
  const src = mods[`../assets/foto/hero-hp-${n}.jpg`].default;
  return {
    n, alt: T[`hero.alt${n}`],
    avif: (await getImage({ src, widths: W, format: "avif", quality: 34 })).srcSet.attribute,
    webp: (await getImage({ src, widths: W, format: "webp", quality: 70 })).srcSet.attribute,
    jpg: (await getImage({ src, width: 720, format: "webp", quality: 70 })).src,
  };
}));
const SZ = "(min-width: 520px) 480px, 100vw";
const GIF = "data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==";
const wa = waLink("Halo Kampung Sumber Alam, saya mau tanya kamar.");
const tautan = [
  { teks: "Cek kamar & booking", url: BOOKING_URL, utama: true },
  { teks: "Chat WhatsApp", url: wa },
  { teks: "Cek tanggal & harga di Traveloka", url: TRAVELOKA_URL },
  { teks: "Booking di Agoda", url: AGODA_URL },
  { teks: "Lokasi di Google Maps", url: MAPS_URL },
  { teks: "Website Kampung Sumber Alam", url: SITE + "/" },
];
const judul = "Kampung Sumber Alam Resort · Link";
const desk = T["meta.desc"];
const og = new URL("/og/beranda.jpg", SITE).href;
---
<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{judul}</title>
  <meta name="description" content={desk} />
  <link rel="canonical" href={SITE + "/link/"} />
  <meta name="theme-color" content="#FFFFFF" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={judul} />
  <meta property="og:description" content={desk} />
  <meta property="og:image" content={og} />
  <meta property="og:url" content={SITE + "/link/"} />
  <link rel="icon" href="/logo/logogram-color.svg" type="image/svg+xml" />
  <link rel="preload" as="image" imagesrcset={slides[0].avif} imagesizes={SZ} type="image/avif" fetchpriority="high" />
  <style is:global>
    @font-face { font-family: "Albert Sans"; src: url("/fonts2/AlbertSans.woff2") format("woff2"); font-weight: 400 600; font-display: swap; unicode-range: U+0020-007E, U+00A0-00FF, U+2013-2026, U+2192; }
    @font-face { font-family: "Sans Fallback"; src: local("Arial"), local("Liberation Sans"), local("Helvetica"); size-adjust: 101%; ascent-override: 92%; }
    :root { --alam: #06735F; --tinta: #0E3A31; --garis: rgba(14, 58, 49, .22); --sans: "Albert Sans", "Sans Fallback", system-ui, sans-serif; }
    *, *::before, *::after { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body { margin: 0; background: #F3F1EA; color: var(--tinta); font: 400 1rem/1.5 var(--sans); -webkit-font-smoothing: antialiased; }
    .bio { max-width: 480px; margin: 0 auto; min-height: 100svh; background: #fff; display: flex; flex-direction: column; }
    .hero { position: relative; aspect-ratio: 4 / 5; background: #c9cfc9; overflow: hidden; }
    .sl { position: absolute; inset: 0; margin: 0; opacity: 0; transition: opacity .8s ease; }
    .sl.tampil { opacity: 1; }
    .sl img { display: block; width: 100%; height: 100%; object-fit: cover; }
    .logo { padding: 26px 24px 6px; display: flex; justify-content: center; }
    .logo img { width: 168px; height: auto; display: block; }
    h1 { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .tautan { list-style: none; margin: 0; padding: 18px 20px 8px; display: grid; gap: 12px; }
    .tautan a { display: flex; align-items: center; justify-content: center; min-height: 54px; padding: 12px 22px; border: 1px solid var(--garis); border-radius: 999px; color: var(--tinta); text-decoration: none; font-weight: 500; font-size: .98rem; text-align: center; transition: background .2s, color .2s, border-color .2s; }
    .tautan a:hover { border-color: var(--alam); }
    .tautan .utama a { background: var(--alam); border-color: var(--alam); color: #fff; font-weight: 600; }
    .tautan .utama a:hover { background: var(--tinta); border-color: var(--tinta); }
    .sosmed { display: flex; justify-content: center; gap: 12px; padding: 18px 20px 8px; }
    .sosmed a { width: 46px; height: 46px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--garis); border-radius: 50%; color: var(--tinta); }
    .sosmed a:hover { background: var(--alam); border-color: var(--alam); color: #fff; }
    .kaki { margin-top: auto; padding: 14px 20px 26px; text-align: center; font-size: .875rem; color: var(--tinta); }
    @media (prefers-reduced-motion: reduce) { .sl { transition: none; } }
  </style>
</head>
<body>
  <main class="bio">
    <h1>Kampung Sumber Alam Resort, Cipanas Garut</h1>
    <section class="hero" aria-roledescription="carousel" aria-label="Foto Kampung Sumber Alam">
      {slides.map((sl, i) => (
        <figure class:list={["sl", { tampil: i === 0 }]} aria-hidden={i === 0 ? undefined : "true"}>
          <picture>
            <source type="image/avif" {...(i === 0 ? { srcset: sl.avif } : { "data-srcset": sl.avif })} sizes={SZ} />
            <source type="image/webp" {...(i === 0 ? { srcset: sl.webp } : { "data-srcset": sl.webp })} sizes={SZ} />
            <img src={i === 0 ? sl.jpg : GIF} alt={sl.alt} width="1440" height="1800" fetchpriority={i === 0 ? "high" : "low"} decoding={i === 0 ? "sync" : "async"} />
          </picture>
        </figure>
      ))}
    </section>
    <div class="logo"><img src="/logo/lockup-color.svg" alt="Kampung Sumber Alam Resort" width="1948" height="1396" /></div>
    <ul class="tautan">
      {tautan.map((l) => <li class:list={[{ utama: l.utama }]}><a href={l.url} rel="noopener" target="_blank">{l.teks}</a></li>)}
    </ul>
    <div class="sosmed"><a href={IG_URL} rel="noopener" target="_blank" aria-label="Instagram Kampung Sumber Alam"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.2c3.2 0 3.6 0 4.8.1 3.2.1 4.8 1.7 4.9 4.9.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-3.3-.1-4.8-1.7-4.9-4.9C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8C2.4 4 3.9 2.4 7.2 2.3 8.4 2.2 8.8 2.2 12 2.2ZM12 0C8.7 0 8.3 0 7.1.1 2.7.3.3 2.7.1 7.1 0 8.3 0 8.7 0 12s0 3.7.1 4.9c.2 4.4 2.6 6.8 7 7 1.2.1 1.6.1 4.9.1s3.7 0 4.9-.1c4.4-.2 6.8-2.6 7-7 .1-1.2.1-1.6.1-4.9s0-3.7-.1-4.9c-.2-4.4-2.6-6.8-7-7C15.7 0 15.3 0 12 0Zm0 5.8a6.2 6.2 0 1 0 0 12.4 6.2 6.2 0 0 0 0-12.4ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.4-11.8a1.4 1.4 0 1 0 0 2.9 1.4 1.4 0 0 0 0-2.9Z"/></svg></a><a href={FB_URL} rel="noopener" target="_blank" aria-label="Facebook Kampung Sumber Alam"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M24 12a12 12 0 1 0-13.9 11.9v-8.4H7.1V12h3V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9V12h3.4l-.5 3.5h-2.9v8.4A12 12 0 0 0 24 12Z"/></svg></a><a href={TIKTOK_URL} rel="noopener" target="_blank" aria-label="TikTok Kampung Sumber Alam"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.6 5.3A4.8 4.8 0 0 1 16.4 2h-3.5v13.6a2.9 2.9 0 1 1-2-2.7V9.3a6.4 6.4 0 1 0 5.5 6.3V8.7a8.2 8.2 0 0 0 4.8 1.5V6.8a4.8 4.8 0 0 1-3.6-1.5Z"/></svg></a></div>
    <p class="kaki">Jl. Raya Cipanas No. 122, Tarogong Kaler, Garut</p>
  </main>
  <script is:inline>(()=>{const S=[...document.querySelectorAll('.sl')];if(S.length<2||matchMedia('(prefers-reduced-motion: reduce)').matches)return;const jalan=()=>{document.querySelectorAll('source[data-srcset]').forEach(x=>{x.srcset=x.dataset.srcset;x.removeAttribute('data-srcset')});let k=0;setInterval(()=>{if(document.hidden)return;const n=(k+1)%S.length;const im=S[n].querySelector('img');const ganti=()=>{S[k].classList.remove('tampil');S[n].classList.add('tampil');k=n};if(im.complete&&im.naturalWidth>1)ganti();else im.addEventListener('load',ganti,{once:true})},3000)};const t0=()=>setTimeout(jalan,600);document.readyState==='complete'?t0():addEventListener('load',t0,{once:true})})()</script>
</body>
</html>
