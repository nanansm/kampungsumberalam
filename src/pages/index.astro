---
import { Picture, getImage } from "astro:assets";
import Situs from "../layouts/Situs.astro";
import { BOOKING_URL, SIBENTANG_URL, MAPS_URL, ULASAN, waLink } from "../data/content";

import heroHp from "../assets/foto/hero-hp.jpg";
import heroDesk from "../assets/foto/hero-desk.jpg";
import sambut1 from "../assets/foto/sambut-1.jpg";
import sambut2 from "../assets/foto/sambut-3.jpg";
import berendamHp from "../assets/foto/berendam-hp.jpg";
import berendamDesk from "../assets/foto/berendam-desk.jpg";
import menginapImg from "../assets/foto/menginap.jpg";
import caraBerdua from "../assets/foto/cara-berdua.jpg";
import caraKeluarga from "../assets/foto/cara-keluarga.jpg";
import caraKantor from "../assets/foto/cara-kantor.jpg";
import lokasiDesk from "../assets/foto/lokasi-desk.jpg";
import lokasiHp from "../assets/foto/lokasi-hp.jpg";

const kataImg = Object.values(import.meta.glob<{ default: ImageMetadata }>("../assets/foto/kata-*.jpg", { eager: true })).map((m) => m.default);
const turImg = Object.values(import.meta.glob<{ default: ImageMetadata }>("../assets/foto/tur-*.jpg", { eager: true })).map((m) => m.default);
const kampungImg = Object.values(import.meta.glob<{ default: ImageMetadata }>("../assets/foto/kampung-*.jpg", { eager: true })).map((m) => m.default);

/* Hero: dua potongan (HP tegak, desktop lebar). AVIF + preload supaya LCP cepat. */
const Q = 34;
const heroHpW = [480, 640, 800];
const heroDeskW = [1024, 1440, 1920, 2400];
const hpAvif = await getImage({ src: heroHp, widths: heroHpW, format: "avif", quality: Q });
const hpWebp = await getImage({ src: heroHp, widths: heroHpW, format: "webp", quality: 70 });
const dkAvif = await getImage({ src: heroDesk, widths: heroDeskW, format: "avif", quality: Q });
const dkWebp = await getImage({ src: heroDesk, widths: heroDeskW, format: "webp", quality: 70 });
const MQ_HP = "(max-width: 767px)";
const MQ_DK = "(min-width: 768px)";

const pesanWa = "Halo Kampung Sumber Alam, saya dari website. Mau tanya kamar.";

const berendam = [
  { nama: "Bak air panas di kamar", isi: "Tiap bungalow punya bak di kamar mandinya, dengan keran khusus air panas Gunung Guntur." },
  { nama: "Kamar Rendam", isi: "Kamu berendam 25 menit di bilik privat, Rp50.000 sudah dapat bandrek atau bajigur." },
  { nama: "Kolam Renang Tasik Madu", isi: "Ini kolam renang umum berisi air panas, letaknya di tengah kawasan." },
  { nama: "Kolam pribadi Villa Sibentang", isi: "Di Villa Sibentang, kamu berendam air panas alami di private pool villamu sendiri.", url: SIBENTANG_URL },
];

const kataAlt = [
  "Sundanese Thermal Escape Village: empat kata tentang Kampung Sumber Alam",
  "Sundanese: teras rumah kayu dengan kursi dan dinding bilik",
  "Thermal: air panas Gunung Guntur mengalir di talang ke balong",
  "Escape: kolam air panas dengan kanopi, Gunung Guntur di belakang",
  "Village: rumah kayu beratap ijuk di atas balong, tersambung jalan setapak",
];
const turCap = [
  "Pov: kamu baru check-in",
  "Yang pertama kelihatan",
  "Kamarmu, rumah kayu beratap ijuk",
  "Air panasnya sampai kamar mandi",
  "Jalan kaki ke kolam air panas",
  "Makan malam lesehan",
  "Menginap semalam, berendam dua kali",
];

const cara = [
  { lbl: "Berdua · weekday", nama: "Menginap berdua, Minggu–Jumat", isi: "Kamu check-in berdua antara Minggu dan Jumat di kamar kawasan utama, sudah termasuk berendam di Kamar Rendam.", harga: "Mulai Rp1.189.000", img: caraBerdua, alt: "Bungalow kayu beratap ijuk di seberang balong berbatu", wa: "Halo, saya mau tanya paket menginap berdua Minggu–Jumat." },
  { lbl: "Keluarga · weekend", nama: "Menginap Sabtu", isi: "Kalau pesan lewat WhatsApp, check-in Sabtu sudah termasuk makan pagi, makan malam, live music, paket pancingan, tiket kolam renang, dan Kamar Rendam.", harga: "Mulai Rp1.989.000 per kamar per malam (Kawung, 2 dewasa)", img: caraKeluarga, alt: "Tamu berjalan di antara rumah kayu dan balong teratai", wa: "Halo, saya mau tanya paket menginap Sabtu untuk keluarga." },
  { lbl: "Kantor · weekday", nama: "Fullboard Meeting", isi: "Timmu menginap semalam di Bungalow: 3 kali buffet, 2 kali coffee break, ruang pertemuan sampai 350 orang, kolam renang, dan Kamar Rendam.", harga: "Rp1.433.000 per orang, Twin Share, weekday", img: caraKantor, alt: "Kawasan Kampung Sumber Alam dilihat dari udara", wa: "Halo, saya mau tanya Fullboard Meeting untuk kantor." },
];

const kampungCap = [
  "Makan malam lesehan, tanpa lihat jam",
  "Kacapi Suling dimainkan langsung di sini",
  "Rumahnya beratap ijuk, berdinding bilik",
  "Ikan berenang di antara teratai balong",
];
const kampungAlt = [
  "Saung kayu terbuka untuk makan malam lesehan",
  "Pemain kacapi dan suling Sunda",
  "Atap ijuk rumah kayu dengan bunga bugenvil",
  "Ikan koi di balong, bayangan pohon kelapa di air",
];
const tipe = ["Bungalow", "Bungalow Siceeh", "Kawung", "Pondok Kalapa", "Junior Suite", "Deluxe Suite", "Babakan Siluhur"];
---
<Situs
  title="Kampung Sumber Alam · Berendam air panas Gunung Guntur di kampung Sunda, Garut"
  description="Menginap di rumah kayu beratap ijuk di atas balong, Cipanas Garut. Air panas alami Gunung Guntur ngalir sampai kamar mandi kamarmu."
  waPesan={pesanWa}
  preload={[
    { srcset: hpAvif.srcSet.attribute, sizes: "100vw", media: MQ_HP, type: "image/avif" },
    { srcset: dkAvif.srcSet.attribute, sizes: "100vw", media: MQ_DK, type: "image/avif" },
  ]}
>
  <!-- Hero -->
  <section class="hero" aria-labelledby="h-hero">
    <picture>
      <source media={MQ_HP} type="image/avif" srcset={hpAvif.srcSet.attribute} sizes="100vw" />
      <source media={MQ_HP} type="image/webp" srcset={hpWebp.srcSet.attribute} sizes="100vw" />
      <source media={MQ_DK} type="image/avif" srcset={dkAvif.srcSet.attribute} sizes="100vw" />
      <source media={MQ_DK} type="image/webp" srcset={dkWebp.srcSet.attribute} sizes="100vw" />
      <img src={dkWebp.src} alt="Rumah kayu beratap ijuk di atas balong teratai, Gunung Guntur di belakangnya" width={heroDesk.width} height={heroDesk.height} fetchpriority="high" decoding="async" />
    </picture>
    <div class="hero-tx">
      <h1 id="h-hero">Berendam air panas Gunung&nbsp;Guntur di kampung Sunda</h1>
    </div>
  </section>

  <!-- Penanda merek -->
  <div class="merek">
    <img src="/logo/logogram-color.svg" alt="" width="64" height="64" />
    <p class="nama">Kampung Sumber Alam</p>
    <p class="sub">Sundanese Thermal Escape Village · Cipanas, Garut</p>
    <p class="lead">Kamu menginap di rumah kayu di Cipanas,&nbsp;Garut, dan air panasnya ngalir sampai kamar mandi kamarmu.</p>
    <div class="dua"><a class="btn btn-isi" href={waLink(pesanWa)} rel="noopener">Chat WhatsApp</a><a class="btn" href={BOOKING_URL} rel="noopener">Cek Kamar Kosong</a></div>
  </div>

  <!-- Sambutan -->
  <section class="sambut cv" aria-labelledby="h-sambut">
    <div class="teks">
      <p class="lbl">Wilujeng Sumping</p>
      <h2 id="h-sambut">Kampung Sunda di atas balong</h2>
      <p>Selamat datang di Kampung Sumber Alam, kampung Sunda di Cipanas, Garut. Rumah kayunya beratap ijuk dan berdiri di atas balong, kolam tempat teratai tumbuh dan ikan berenang.</p>
      <p>Air panas di sini datang dari Gunung Guntur. Orang Garut sudah biasa berendam di Cipanas jauh sebelum kata healing ramai dipakai, dan di kampung ini kamu ikut kebiasaan itu.</p>
    </div>
    <figure class="f1">
      <Picture src={sambut1} formats={["avif", "webp"]} widths={[400, 640, 900]} sizes="(min-width: 900px) 34vw, 78vw" quality={45} alt="Teras rumah kayu dengan kursi berbantal putih dan dinding bilik" loading="lazy" />
    </figure>
    <figure class="f2">
      <Picture src={sambut2} formats={["avif", "webp"]} widths={[360, 560, 800]} sizes="(min-width: 900px) 28vw, 64vw" quality={45} alt="Teras rumah panggung terlihat di antara dedaunan, balong di bawahnya" loading="lazy" />
    </figure>
  </section>

  <div class="bilik" role="presentation"></div>

  <!-- Berendam -->
  <section id="berendam" class="berendam on-gelap cv" aria-labelledby="h-berendam">
    <div class="pita-img">
      <picture>
        <source media="(min-width: 768px)" srcset={(await getImage({ src: berendamDesk, widths: [768, 1280, 1920], format: "avif", quality: 45 })).srcSet.attribute} sizes="100vw" type="image/avif" />
        <source media="(max-width: 767px)" srcset={(await getImage({ src: berendamHp, widths: [400, 614], format: "avif", quality: 45 })).srcSet.attribute} sizes="100vw" type="image/avif" />
        <source media="(max-width: 767px)" srcset={(await getImage({ src: berendamHp, widths: [400, 614], format: "webp", quality: 65 })).srcSet.attribute} sizes="100vw" type="image/webp" />
        <img src={(await getImage({ src: berendamDesk, width: 1280, format: "webp", quality: 70 })).src} alt="Air panas mengalir dari pancuran batu ke kolam" width={berendamDesk.width} height={berendamDesk.height} loading="lazy" decoding="async" style="width:100%;height:auto" />
      </picture>
    </div>
    <div class="kepala">
      <div class="judul-garis"><h2 id="h-berendam">Berendam</h2></div>
      <p class="pengantar">Kamu bisa berendam air panas di empat tempat, mulai dari kamar mandi kamarmu sendiri.</p>
    </div>
    <ol class="empat">
      {berendam.map((b, i) => (
        <li>
          <span class="no">0{i + 1}</span>
          <h3>{b.nama}</h3>
          <p>{b.isi}{b.url && <> <a class="panah" href={b.url} rel="noopener">Lihat Sibentang →</a></>}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Empat kata -->
  <section class="kata cv" aria-labelledby="h-kata">
    <div class="kepala">
      <h2 id="h-kata">Sundanese Thermal Escape Village</h2>
      <p>Tiap kata di nama ini menunjuk hal nyata yang bisa kamu lihat di Kampung Sumber Alam. Geser untuk membaca →</p>
    </div>
    <div class="geser" tabindex="0" aria-label="Empat kata tentang Kampung Sumber Alam">
      {kataImg.map((img, i) => (
        <figure class="kartu-foto">
          <Picture src={img} formats={["avif", "webp"]} widths={[320, 480, 640, 800]} sizes="(min-width: 1024px) 28vw, (min-width: 640px) 44vw, 78vw" quality={45} alt={kataAlt[i]} loading="lazy" />
          <figcaption><span class="n">0{i + 1}</span><span>/ 05</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- Menginap -->
  <section id="menginap" class="menginap on-gelap cv" aria-labelledby="h-menginap">
    <div class="kepala">
      <div class="judul-garis"><h2 id="h-menginap">Menginap</h2></div>
      <p>Ada 14 tipe rumah kayu beratap ijuk di atas balong, dari Bungalow untuk berdua sampai Babakan Siluhur untuk 18 orang, semuanya tersambung jalan setapak.</p>
    </div>
    <div class="geser" tabindex="0" aria-label="Tur singkat menginap di Kampung Sumber Alam">
      <figure class="kartu-foto">
        <Picture src={menginapImg} formats={["avif", "webp"]} widths={[320, 480, 640, 800]} sizes="(min-width: 1024px) 28vw, (min-width: 640px) 44vw, 78vw" quality={45} alt="Dua rumah kayu beratap ijuk di atas balong teratai" loading="lazy" />
        <figcaption><span class="n">01</span><span>Rumah kayu di atas balong</span></figcaption>
      </figure>
      {turImg.map((img, i) => (
        <figure class="kartu-foto">
          <Picture src={img} formats={["avif", "webp"]} widths={[320, 480, 640, 800]} sizes="(min-width: 1024px) 28vw, (min-width: 640px) 44vw, 78vw" quality={45} alt={turCap[i]} loading="lazy" />
          <figcaption><span class="n">{String(i + 2).padStart(2, "0")}</span><span>{turCap[i]}</span></figcaption>
        </figure>
      ))}
    </div>
    <div class="aksi">
      <a class="btn" href={BOOKING_URL} rel="noopener">Lihat semua kamar</a>
      <p class="tipe">{tipe.map((t) => <span>{t}</span>)}</p>
    </div>
  </section>

  <!-- Tiga cara datang -->
  <section id="datang" class="cara cv" aria-labelledby="h-cara">
    <div class="cara-in">
      <h2 id="h-cara">Kamu datang berdua, sekeluarga, atau bareng kantor?</h2>
      <div class="cara-grid">
        {cara.map((c) => (
          <article class="kartu">
            <p class="lbl">{c.lbl}</p>
            <h3>{c.nama}</h3>
            <Picture src={c.img} formats={["avif", "webp"]} widths={[360, 560, 800]} sizes="(min-width: 900px) 30vw, 90vw" quality={45} alt={c.alt} loading="lazy" />
            <p>{c.isi}</p>
            <p class="harga">{c.harga}</p>
            <a class="btn" href={waLink(c.wa)} rel="noopener">Tanya via WhatsApp</a>
          </article>
        ))}
      </div>
      <p class="catatan">Tarif kami konfirmasi ulang waktu kamu memesan lewat WhatsApp.</p>
    </div>
  </section>

  <!-- Kampung -->
  <section id="kampung" class="kampung cv" aria-labelledby="h-kampung">
    <div class="kepala">
      <h2 id="h-kampung">Seharian di kampung</h2>
      <p>Kamu makan Nasi Liwet atau Nasi Tutug Oncom di restoran Tunjung Balebat, mampir ke Pitaloka Spa, dan anak-anak ikut Melukis Caping, Melukis Layangan, atau Jaipong.</p>
    </div>
    <div class="jajar">
      {kampungImg.map((img, i) => (
        <figure>
          <Picture src={img} formats={["avif", "webp"]} widths={[240, 400, 600]} sizes="(min-width: 900px) 25vw, 50vw" quality={45} alt={kampungAlt[i]} loading="lazy" />
          <figcaption>{kampungCap[i]}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- Guntur + lokasi -->
  <section id="lokasi" class="guntur cv" aria-labelledby="h-lokasi">
    <picture>
      <source media="(min-width: 768px)" srcset={(await getImage({ src: lokasiDesk, widths: [768, 1280, 1920], format: "avif", quality: 45 })).srcSet.attribute} sizes="100vw" type="image/avif" />
      <source media="(max-width: 767px)" srcset={(await getImage({ src: lokasiHp, widths: [400, 614], format: "avif", quality: 45 })).srcSet.attribute} sizes="100vw" type="image/avif" />
      <source media="(max-width: 767px)" srcset={(await getImage({ src: lokasiHp, widths: [400, 614], format: "webp", quality: 65 })).srcSet.attribute} sizes="100vw" type="image/webp" />
      <img src={(await getImage({ src: lokasiDesk, width: 1280, format: "webp", quality: 70 })).src} alt="Kampung Sumber Alam dan Cipanas dilihat dari udara" width={lokasiDesk.width} height={lokasiDesk.height} loading="lazy" decoding="async" />
    </picture>
    <div class="kotak on-gelap">
      <p class="lbl">Kaki Guntur</p>
      <h2 id="h-lokasi">Kami ada di Cipanas, Garut</h2>
      <p>Kaki Gunung Guntur, asal air panas yang kamu pakai berendam, sekitar 15 menit perjalanan dari Kampung Sumber Alam.</p>
      <p style="margin-top:12px">Alamat kami Jl. Raya Cipanas No. 122, Tarogong Kaler, Garut, Jawa Barat, dan kalau bingung jalannya, telepon saja <a href="tel:+62262238000">(0262) 238000</a>.</p>
      <a class="btn" href={MAPS_URL} rel="noopener" style="margin-top:20px">Buka Google Maps</a>
    </div>
  </section>

  <!-- Ulasan -->
  <section class="ulasan cv" aria-labelledby="h-ulasan">
    <div class="ulasan-in">
      <h2 id="h-ulasan" style="font-size:clamp(1.9rem,3.4vw,2.8rem)">Begini penilaian tamu Kampung Sumber Alam di Tripadvisor dan Traveloka.</h2>
      <div class="angka">
        {ULASAN.map((u) => (
          <div>
            <p class="lbl">{u.sumber}</p>
            <p class="skor">{u.nilai}<small> / {u.dari}</small></p>
            <p>{u.jumlah} ulasan · {u.catatan.id}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="bilik" role="presentation"></div>

  <!-- Penutup -->
  <section class="penutup cv" aria-labelledby="h-tutup">
    <h2 id="h-tutup">Kalau tanggalnya sudah ada, cek kamarnya, atau ngobrol dulu sama kami juga boleh.</h2>
    <div class="dua">
      <a class="btn btn-isi" href={waLink(pesanWa)} rel="noopener">Chat WhatsApp</a>
      <a class="btn" href={BOOKING_URL} rel="noopener">Cek Kamar Kosong</a>
    </div>
  </section>
</Situs>
