---
/* Kerangka halaman dalam (Tentang, Menginap, Rapat, Acara, Galeri, Lokasi).
   Pola sama dengan beranda: foto paling atas, header putih di bawahnya lalu menempel saat scroll. */
import { altTeks } from "../data/alt-en";
import "../styles/halaman.css";
import Situs from "./Situs.astro";
import { getImage } from "astro:assets";
import id from "../i18n/id.json";
import en from "../i18n/en.json";

type Dua = { id: string; en: string };
interface Props {
  lang: "id" | "en";
  /** path versi ID, mis. "/about/" */
  path: string;
  title: Dua;
  description: Dua;
  penanda: Dua;
  judul: Dua;
  foto: string;
  w: number;
  h: number;
  alt: string;
  og?: string;
  waPesan?: Dua;
  noindex?: boolean;
}
const { lang, path, title, description, penanda, judul, foto, w, h, alt, og, waPesan, noindex = false } = Astro.props;
const T: Record<string, string> = lang === "en" ? en : id;
const pesan = waPesan ? waPesan[lang] : T["wa.umum"];
const semua = import.meta.glob<{ default: ImageMetadata }>("../assets/images/*.{webp,jpg,png}", { eager: true });
const m = semua[`../assets/images/${foto.split("/").pop()}`];
if (!m) throw new Error(`Foto hero tidak ada: ${foto}`);
const W = [480, 720, 960, 1280, 1600].filter((x) => x <= m.default.width);
const avif = await getImage({ src: m.default, widths: W, format: "avif", quality: 40 });
const ukuran = `(max-width: 767px) max(100vw, ${Math.ceil((62 * w) / h)}vh), 100vw`;
const webp = await getImage({ src: m.default, widths: W, format: "webp", quality: 65 });
/* satu goresan kampung per halaman (Creative Direction 2027: satu warna, satu per tata letak) */
const GORESAN: Record<string, string> = { "/about/": "kelapa", "/accommodation/": "rumah", "/meetings/": "bunga", "/events/": "bunga", "/gallery/": "teratai", "/location/": "kelapa" };
const goresan = GORESAN[path] ?? "teratai";
---
<Situs lang={lang} T={T} title={title[lang]} description={description[lang]} waPesan={pesan} path={path} og={og} noindex={noindex}>
  <section class="hal-hero" slot="hero" aria-labelledby="h-hal" data-hero data-parallax="7">
    <picture class="hal-hero-foto">
      <source type="image/avif" srcset={avif.srcSet.attribute} sizes={ukuran} />
      <source type="image/webp" srcset={webp.srcSet.attribute} sizes={ukuran} />
      <img src={webp.src} width={w} height={h} alt={altTeks(alt, lang)} fetchpriority="high" decoding="async" />
    </picture>
    <div class="hal-hero-tx">
      <p class="lbl" data-muncul>{penanda[lang]}</p>
      <h1 id="h-hal" data-judul>{judul[lang]}</h1>
    </div>
  </section>
  <div class="bilik hal-bilik" role="presentation"></div>
  <div class="hal"><span class:list={["goresan", `goresan--${goresan}`, "hal-goresan"]} aria-hidden="true"></span><slot /></div>
</Situs>
