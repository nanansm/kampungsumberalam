---
import "../styles/situs.css";
import { getImage } from "astro:assets";
import fotoMenu from "../assets/cerita/menu-foto.jpg";
import { NAMA_PANJANG, ALAMAT_SATU_BARIS, TELEPON, TELEPON_TAMPIL, EMAIL, IG_URL, FB_URL, TIKTOK_URL, IG_HANDLE, MAPS_URL, BOOKING_URL, SIBENTANG_URL, TRAVELOKA_URL, SITE, GEO, waLink } from "../data/content";

interface Props {
  lang: "id" | "en";
  T: Record<string, string>;
  title: string;
  description: string;
  waPesan: string;
  preload?: { srcset: string; sizes: string; media?: string; type?: string }[];
  /** path halaman versi ID tanpa awalan bahasa, mis. "/about/". Beranda = "/" */
  path?: string;
  /** gambar share link (1200x630), path di /public */
  og?: string;
  noindex?: boolean;
}
const { lang, T, title, description, waPesan, preload = [], path = "/", og = "/og/beranda.jpg", noindex = false } = Astro.props;
const t = (k: string) => {
  if (T[k] === undefined) throw new Error(`Teks hilang: ${lang}.${k}`);
  return T[k];
};
const akar = lang === "en" ? "/en/" : "/";
const pathEn = path === "/" ? "/en/" : `/en${path}`;
const urlId = new URL(path, SITE).href;
const urlEn = new URL(pathEn, SITE).href;
const ogUrl = new URL(og, SITE).href;
const kanonik = lang === "en" ? urlEn : urlId;
const tahun = new Date().getFullYear();
const tel = `tel:${TELEPON}`;

const schema = {
  "@context": "https://schema.org",
  "@type": "Resort",
  name: NAMA_PANJANG,
  url: SITE,
  telephone: TELEPON,
  email: EMAIL,
  address: { "@type": "PostalAddress", streetAddress: "Jl. Raya Cipanas No. 122", addressLocality: "Garut", addressRegion: "Jawa Barat", postalCode: "44151", addressCountry: "ID" },
  geo: { "@type": "GeoCoordinates", latitude: GEO.lat, longitude: GEO.lng },
  sameAs: [IG_URL, FB_URL, TIKTOK_URL],
};
const adaHero = Astro.slots.has("hero");
/* foto menu layar penuh: dimuat hanya saat menu dibuka (loading lazy di dalam popover tertutup) */
const fotoMenuAvif = await getImage({ src: fotoMenu, widths: [480, 720, 960], format: "avif", quality: 48 });
const fotoMenuWebp = await getImage({ src: fotoMenu, width: 720, format: "webp", quality: 62 });
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {!noindex && <>
  <link rel="canonical" href={kanonik} />
  <link rel="alternate" hreflang="id" href={urlId} />
  <link rel="alternate" hreflang="en" href={urlEn} />
  <link rel="alternate" hreflang="x-default" href={urlId} />
  </>}
  <meta name="theme-color" content="#FCFAE6" />
  <script is:inline>(()=>{const d=document.documentElement;d.classList.add("js");if(matchMedia("(prefers-reduced-motion: reduce)").matches)return;d.classList.add("gerak");addEventListener("load",()=>setTimeout(()=>{if(!window.__gerakSiap){d.classList.remove("gerak")}},2500),{once:true})})()</script>
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={NAMA_PANJANG} />
  <meta property="og:image" content={ogUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={NAMA_PANJANG} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={kanonik} />
  <meta property="og:locale" content={lang === "en" ? "en_US" : "id_ID"} />
  <meta property="og:locale:alternate" content={lang === "en" ? "id_ID" : "en_US"} />
  <link rel="icon" href="/logo/logogram-color.svg" type="image/svg+xml" />
  <slot name="head" />
  {preload.map((p) => <link rel="preload" as="image" imagesrcset={p.srcset} imagesizes={p.sizes} media={p.media} type={p.type} fetchpriority="high" />)}
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
  <a class="skip" href="#isi">{t("ui.skip")}</a>
  <div class="garis-progres" aria-hidden="true"><span></span></div>
  <header class:list={["hdr", { "tanpa-hero": !adaHero, "di-hero": adaHero }]}>
    <div class="hdr-in">
      <div class="kiri">
      <button class="burger" type="button" popovertarget="menu" aria-label={t("ui.menu")}><svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18" stroke="currentColor" stroke-width="1.6" fill="none"/></svg><span class="burger-tx">{t("ui.menu")}</span></button>
        <nav class="bahasa" aria-label="Bahasa / Language">
          <a href={path} hreflang="id" lang="id" aria-current={lang === "id" ? "true" : undefined}>ID</a>
          <a href={pathEn} hreflang="en" lang="en" aria-current={lang === "en" ? "true" : undefined}>EN</a>
        </nav>
      </div>
      <a class="logo" href={akar} aria-label={NAMA_PANJANG}><img class="logo-warna" src="/logo/logotype-color.svg" alt={NAMA_PANJANG} width="113" height="36" /><img class="logo-putih" src="/logo/logotype-putih.svg" alt="" width="113" height="36" aria-hidden="true" /></a>
      <div class="kanan">
        <a class="lbl-a pesan" href={BOOKING_URL} rel="noopener">{t("ui.pesan")}</a>
      </div>
    </div>
  </header>

  <div id="menu" class="menu" popover data-lenis-prevent>
    <div class="bilik menu-bilik" role="presentation"></div>
    <div class="menu-in">
      <div class="menu-top">
        <button type="button" popovertarget="menu" popovertargetaction="hide">{t("ui.tutup")}</button>
        <img src="/logo/logotype-color.svg" alt="" width="113" height="36" loading="lazy" />
        <a class="lbl" href={BOOKING_URL} style="text-decoration:none">{t("ui.pesan")}</a>
      </div>
      <div class="menu-badan">
      <nav aria-label={t("ui.menu")}>
        <a href={akar}>{t("nav.beranda")}</a>
        <a href={`${akar}#berendam`}>{t("nav.berendam")}</a>
        <a href={`${akar}accommodation/`}>{t("nav.menginap")}</a>
        <a href={`${akar}meetings/`}>{t("nav.rapat")}</a>
        <a href={`${akar}events/`}>{t("nav.acara")}</a>
        <a href={`${akar}gallery/`}>{t("nav.galeri")}</a>
        <a href={`${akar}about/`}>{t("nav.tentang")}</a>
        <a href={`${akar}location/`}>{t("nav.lokasi")}</a>
        <a href={SIBENTANG_URL} rel="noopener">Villa Sibentang</a>
      </nav>
      <aside class="menu-samping">
        <figure class="menu-foto">
          <picture>
            <source type="image/avif" srcset={fotoMenuAvif.srcSet.attribute} sizes="(min-width: 900px) 30vw, 0px" />
            <img src={fotoMenuWebp.src} width={fotoMenu.width} height={fotoMenu.height} alt={t("menu.foto")} loading="lazy" decoding="async" />
          </picture>
        </figure>
        <div class="menu-kontak">
          <p class="lbl">{t("menu.reservasi")}</p>
          <a class="btn btn-isi btn-wa" href={waLink(waPesan)} rel="noopener"><span class="btn-tx">{t("menu.wa")}</span></a>
          <dl>
            <dt class="lbl">{t("menu.telepon")}</dt><dd><a href={tel}>{TELEPON_TAMPIL}</a></dd>
            <dt class="lbl">Email</dt><dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd>
            <dt class="lbl">{t("menu.alamat")}</dt><dd>{ALAMAT_SATU_BARIS}</dd>
          </dl>
          <span class="goresan goresan--teratai" aria-hidden="true"></span>
        </div>
      </aside>
      </div>
      <div class="kecil lbl">
        <a href={path} hreflang="id" lang="id">Bahasa Indonesia</a>
        <a href={pathEn} hreflang="en" lang="en">English</a>
        <a href={waLink(waPesan)} rel="noopener">WhatsApp</a>
        <a href={tel}>{TELEPON_TAMPIL}</a>
        <a href={IG_URL} rel="noopener">Instagram</a>
      </div>
    </div>
  </div>

  <main id="isi" class:list={[{ "isi-tanpa-hero": !adaHero }]}><slot name="hero" /><slot /></main>

  <footer class="ftr cv">
    <div class="bilik ftr-bilik" role="presentation"></div>
    <div class="ftr-in">
      <div class="ftr-merek">
        <img src="/logo/lockup-color.svg" alt={NAMA_PANJANG} width="89" height="64" loading="lazy" />
        <p style="margin-top:18px;max-width:34ch">{ALAMAT_SATU_BARIS}</p>
        <p class="ftr-slogan" lang="en">Rest. Recover. Rejuvenate.</p>
        <span class="goresan goresan--kelapa" aria-hidden="true"></span>
      </div>
      <div>
        <p class="lbl">{t("ui.hubungi")}</p>
        <ul>
          <li><a href={waLink(waPesan)} rel="noopener">WhatsApp</a></li>
          <li><a href={tel}>{TELEPON_TAMPIL}</a></li>
          <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
        </ul>
      </div>
      <div>
        <p class="lbl">{t("ui.pesan")}</p>
        <ul>
          <li><a href={BOOKING_URL} rel="noopener">{t("penutup.tombol2")}</a></li>
          <li><a href={TRAVELOKA_URL} rel="noopener">Traveloka</a></li>
          <li><a href={SIBENTANG_URL} rel="noopener">Villa Sibentang</a></li>
        </ul>
      </div>
      <div>
        <p class="lbl">{t("ui.menu")}</p>
        <ul>
          <li><a href={`${akar}accommodation/`}>{t("nav.menginap")}</a></li>
          <li><a href={`${akar}meetings/`}>{t("nav.rapat")}</a></li>
          <li><a href={`${akar}events/`}>{t("nav.acara")}</a></li>
          <li><a href={`${akar}gallery/`}>{t("nav.galeri")}</a></li>
          <li><a href={`${akar}about/`}>{t("nav.tentang")}</a></li>
          <li><a href={`${akar}location/`}>{t("nav.lokasi")}</a></li>
        </ul>
      </div>
      <div>
        <p class="lbl">{t("ui.ikuti")}</p>
        <ul>
          <li class="sosmed"><a href={IG_URL} rel="noopener" target="_blank" aria-label="Instagram Kampung Sumber Alam"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.2c3.2 0 3.6 0 4.8.1 3.2.1 4.8 1.7 4.9 4.9.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-3.3-.1-4.8-1.7-4.9-4.9C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8C2.4 4 3.9 2.4 7.2 2.3 8.4 2.2 8.8 2.2 12 2.2ZM12 0C8.7 0 8.3 0 7.1.1 2.7.3.3 2.7.1 7.1 0 8.3 0 8.7 0 12s0 3.7.1 4.9c.2 4.4 2.6 6.8 7 7 1.2.1 1.6.1 4.9.1s3.7 0 4.9-.1c4.4-.2 6.8-2.6 7-7 .1-1.2.1-1.6.1-4.9s0-3.7-.1-4.9c-.2-4.4-2.6-6.8-7-7C15.7 0 15.3 0 12 0Zm0 5.8a6.2 6.2 0 1 0 0 12.4 6.2 6.2 0 0 0 0-12.4ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.4-11.8a1.4 1.4 0 1 0 0 2.9 1.4 1.4 0 0 0 0-2.9Z"/></svg></a><a href={FB_URL} rel="noopener" target="_blank" aria-label="Facebook Kampung Sumber Alam"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M24 12a12 12 0 1 0-13.9 11.9v-8.4H7.1V12h3V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9V12h3.4l-.5 3.5h-2.9v8.4A12 12 0 0 0 24 12Z"/></svg></a><a href={TIKTOK_URL} rel="noopener" target="_blank" aria-label="TikTok Kampung Sumber Alam"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.6 5.3A4.8 4.8 0 0 1 16.4 2h-3.5v13.6a2.9 2.9 0 1 1-2-2.7V9.3a6.4 6.4 0 1 0 5.5 6.3V8.7a8.2 8.2 0 0 0 4.8 1.5V6.8a4.8 4.8 0 0 1-3.6-1.5Z"/></svg></a></li>
          <li><a href={MAPS_URL} rel="noopener">Google Maps</a></li>
          <li><a href={lang === "en" ? path : pathEn} hreflang={lang === "en" ? "id" : "en"}>{lang === "en" ? "Bahasa Indonesia" : "English"}</a></li>
        </ul>
      </div>
      <p class="bawah">© {tahun} {NAMA_PANJANG} · Cipanas, Garut</p>
    </div>
  </footer>

  <a class="wa-float" href={waLink(waPesan)} rel="noopener" aria-label={t("penutup.tombol1")}><svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg></a>
  <script>import "../scripts/situs";</script>
</body>
</html>
