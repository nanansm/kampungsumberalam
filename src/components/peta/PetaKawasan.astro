---
/**
 * Peta kawasan interaktif (beranda).
 *
 * Diadaptasi dari bedah peta udara ownprimland.com (19 Nov 2026), diterjemahkan ke
 * Kampung Sumber Alam: uap air panas yang tersibak (bukan awan), enam pemberhentian
 * mengikuti alur tamu. Dasar peta: foto udara drone kalau public/peta/foto-udara/zona.json
 * sudah ada (src/data/foto-udara.ts), kalau belum ilustrasi isometrik Opsi E.
 *
 * Kelemahan Primland yang diperbaiki di sini:
 * - label nama terlihat juga di layar sentuh (titik pemberhentian aktif selalu berlabel)
 * - jalan pintas di HP: daftar pemberhentian + Lewati peta
 * - ubah ukuran jendela tidak melempar ke awal peta (posisi gulir dipertahankan)
 * - panel = <dialog> modal: Esc, klik luar, fokus pindah & kembali, gulir terkunci (Lenis juga)
 * - prefers-reduced-motion: versi diam yang tetap lengkap (peta + daftar)
 * - aset berat dimuat saat mendekat, ubin tajam hanya di layar yang butuh
 * - semua 21 zona terjangkau: titik di peta, chip di kotak keterangan, dan daftar zona
 *
 * Tanpa JavaScript, bagian ini tampil sebagai peta diam + daftar pemberhentian +
 * daftar zona lengkap (bisa dibaca mesin pencari).
 */
import { Picture } from "astro:assets";
import "../../styles/peta.css";
import { ZONA, HENTI, PANDANG_AWAL, DUNIA, PLAT, PINTU_MASUK, FOTO_UDARA, TEPI, TEKS_PETA as TX, hargaZona, dekatnya, SIBENTANG, type Zona } from "../../data/peta";
import lensaUdara from "../../data/lensa-udara.json";
import { KLIP_ZONA } from "../../data/drone";
import { BOOKING_URL, waLink } from "../../data/content";
import { lekat, rapi, rapiIsi } from "../../data/rag";

interface Props { lang: "id" | "en" }
const { lang } = Astro.props;
const L = (d: { id: string; en: string }) => rapi(d[lang]);
/* paragraf isi di kotak dan panel: nama tidak disambung (kotak HP sempit), angka tetap */
const I = (d: { id: string; en: string }) => rapiIsi(d[lang]);

const fotoMod = import.meta.glob<{ default: ImageMetadata }>("../../assets/peta/*.jpg", { eager: true });
const fotoLama = import.meta.glob<{ default: ImageMetadata }>("../../assets/images/*.webp", { eager: true });
/* foto peta (src/assets/peta, sudah ditoning) atau foto situs lama yang sudah berlabel (src/assets/images) */
const foto = (k: string) => {
  const m = fotoMod[`../../assets/peta/${k}.jpg`] ?? fotoLama[`../../assets/images/${k}.webp`];
  if (!m) throw new Error(`Foto peta tidak ada: ${k}`);
  return m.default;
};

/* Panjang tiap babak gulir, dalam satuan tinggi layar. Juga dipakai skrip. */
const BABAK = { buka: 1.6, henti: 1.05, tutup: 0.9 };
const TOTAL = BABAK.buka + BABAK.henti * HENTI.length + BABAK.tutup;

/* Bingkai versi diam: pelat kawasan saja (unit SVG), tanpa langit di atas Guntur */
const STATIS = FOTO_UDARA ? { x: 0, y: 0, w: DUNIA.lebar, h: DUNIA.tinggi } : { x: 40, y: 30, w: 1940, h: 1920 };
/* letak titik di dalam potongan lensa foto udara (persen), dari tools/peta/lensa_udara.py */
const LENSA_U: Record<string, { x: number; y: number }> = FOTO_UDARA ? lensaUdara : {};
const pct = (v: number, o: number, w: number) => `${(((v - o) / w) * 100).toFixed(3)}%`;

/* satu format rupiah per bahasa: Rp1.189.000 (ID) · Rp1,189,000 (EN) */
const rupiah = (s: string) => (lang === "en" ? `Rp${s.replace(/\./g, ",")}` : `Rp${s}`);
const pesanWa = (zn: Zona) =>
  lang === "en"
    ? `Hello Kampung Sumber Alam, I saw the map on your website and would like to ask about ${zn.label}.`
    : `Halo Kampung Sumber Alam, saya lihat peta di website dan mau tanya ${zn.label}.`;
const hrefRapat = lang === "en" ? "/en/meetings/" : "/meetings/";
/* kalimat pembuka mengikuti jumlah pemberhentian yang benar-benar ada di peta */
const ANGKA = { id: ["nol", "satu", "dua", "tiga", "empat", "lima", "enam", "tujuh"], en: ["zero", "one", "two", "three", "four", "five", "six", "seven"] };
const akhir = HENTI[HENTI.length - 1]?.id === "belakang" ? { id: "area belakang", en: "the back of the grounds" } : { id: "Tegal Pangulinan", en: "Tegal Pangulinan" };
const ajak = TX.ajak[lang].replace("{n}", ANGKA[lang][HENTI.length] ?? String(HENTI.length)).replace("{akhir}", akhir[lang]);

const dataSkrip = {
  babak: BABAK,
  plat: PLAT.map((p) => ({ lebar: p.lebar, tinggi: p.tinggi, foto: p.foto, ubin: p.ubin, kolom: p.kolom, baris: p.baris, tajam: p.tajam })),
  awal: PANDANG_AWAL,
  henti: HENTI.map((h) => ({ id: h.id, cx: h.cx, cy: h.cy, vw: h.vw, vh: h.vh, plat: h.plat ?? 0, sisi: h.sisi ?? "kiri" })),
  teksTutup: L(TX.tutupNav),
};
/* gambar dasar tiap plat: HP selalu versi HP/1600 (tidak ikut DPR), desktop 2560 */
const imgDasar = (p: (typeof PLAT)[number]) => p.dk.webp ?? p.dk.jpg ?? p.dk.avif;
---
<div class="peta-wadah" data-peta data-skrip={JSON.stringify(dataSkrip)}>
<section class="peta" id="peta" aria-labelledby="h-peta" style={`--total:${TOTAL}`}>
  <div class="peta-panggung">
    <div class="peta-pembuka">
      <p class="lbl">{L(TX.penanda)}</p>
      <h2 id="h-peta">{L(TX.judul)}</h2>
      <p class="peta-ajak">{rapi(ajak)}</p>
      <span class="peta-garis" aria-hidden="true"></span>
    </div>

    <!-- Daftar pemberhentian + lewati (desktop: kiri atas; HP: tombol ringkas di atas) -->
    <nav class="peta-nav" aria-label={L(TX.keliling)}>
      <button type="button" class="nav-ringkas" aria-expanded="false" aria-controls="peta-nav-daftar">
        <span class="nav-nomor"><span data-nav-no>01</span>/{String(HENTI.length).padStart(2, "0")}</span>
        <span class="nav-nama" data-nav-nama>{L(HENTI[0].label)}</span>
        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4.5 6 8.5l4-4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
      </button>
      <div class="nav-daftar" id="peta-nav-daftar">
        <p class="lbl nav-judul">{L(TX.keliling)}</p>
        <ol>
          {HENTI.map((h, i) => (
            <li><button type="button" data-ke={i}><span class="nav-no">{String(i + 1).padStart(2, "0")}</span>{L(h.label)}</button></li>
          ))}
        </ol>
        <span class="nav-penanda" aria-hidden="true"></span>
      </div>
      <a class="peta-lewati" href="#setelah-peta" data-lewati>{L(TX.lewati)}<svg width="10" height="12" viewBox="0 0 10 12" aria-hidden="true"><path d="M5 1v9M1.5 6.8 5 10.3l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></a>
    </nav>

    <!-- Kotak keterangan tiap pemberhentian -->
    <div class="peta-kotak-lapis">
      {HENTI.map((h, i) => {
        const zh = ZONA.filter((zn) => zn.henti === i);
        return (
          <article class:list={["peta-kotak", { "kotak-kanan": h.sisi === "kanan" }]} data-henti-kotak={i} aria-labelledby={`h-henti-${h.id}`}>
            <figure class="kotak-foto">
              <Picture src={foto(h.foto)} formats={["avif", "webp"]} widths={[360, 560, 800]} sizes="(min-width: 900px) 380px, 40vw" quality={52} alt={L(h.fotoAlt)} loading="lazy" decoding="async" />
            </figure>
            <div class="kotak-teks">
              <p class="lbl"><span class="kotak-no">{String(i + 1).padStart(2, "0")}</span> {L(h.label)}</p>
              <h3 id={`h-henti-${h.id}`}>{L(h.judul)}</h3>
              <p class="kotak-isi">{I(h.teks)}</p>
              <ul class="kotak-chip" aria-label={L(TX.zona)}>
                {zh.map((zn) => (
                  <li><button type="button" data-buka={zn.no} aria-haspopup="dialog"><span>{zn.no}</span>{zn.label}</button></li>
                ))}
              </ul>
            </div>
            <span class="kotak-progres" aria-hidden="true"><span></span></span>
          </article>
        );
      })}
    </div>

    <div class="peta-penutup">
      <p class="lbl">{L(TX.penanda)}</p>
      <h3>{L(TX.penutup)}</h3>
      <div class="dua">
        <a class="btn btn-isi" href={waLink(lang === "en" ? "Hello Kampung Sumber Alam, I saw the map on your website and would like to ask about rooms." : "Halo Kampung Sumber Alam, saya lihat peta di website dan mau tanya kamar.")} rel="noopener"><span class="btn-tx">{L(TX.tanyaWa)}</span></a>
        <a class="btn" href={BOOKING_URL} rel="noopener"><span class="btn-tx">{L(TX.cekKamar)}</span></a>
      </div>
    </div>
    <!-- Dunia peta: satu gambar ilustrasi + ubin tajam yang dimuat saat dibutuhkan -->
    <div class:list={["peta-bingkai", { "peta-bingkai--foto": !!FOTO_UDARA }]} style={`--sx:${STATIS.x};--sy:${STATIS.y};--sw:${STATIS.w};--sh:${STATIS.h};--dw:${DUNIA.lebar};--dh:${DUNIA.tinggi}`}>
      {PLAT.map((pl, i) => (
        <div class:list={["peta-dunia", { "plat-aktif": i === 0 }]} data-plat={i} aria-hidden="true" style={`--dw:${pl.lebar};--dh:${pl.tinggi}`}>
          <picture>
            {pl.hp.avif && <source media="(max-width: 899px)" type="image/avif" srcset={pl.hp.avif} />}
            {pl.hp.webp && <source media="(max-width: 899px)" type="image/webp" srcset={pl.hp.webp} />}
            {pl.dk.avif && <source type="image/avif" srcset={pl.dk.avif} />}
            <img class="peta-dasar" src={imgDasar(pl)} width={pl.lebar} height={pl.tinggi} alt="" loading="lazy" decoding="async" />
          </picture>
          <div class="peta-ubin"></div>
          {pl.batas.length > 0 && (
            <svg class="peta-batas" viewBox={`0 0 ${pl.lebar} ${pl.tinggi}`} preserveAspectRatio="none" aria-hidden="true">
              {/* luar kawasan diredupkan supaya atap tetangga tidak menarik mata; batas dijepit ke foto */}
              <path class="peta-selubung" fill-rule="evenodd" d={`M0 0H${pl.lebar}V${pl.tinggi}H0Z ` + pl.batas.map((pg) => "M" + pg.map((t) => `${t.x.toFixed(1)} ${t.y.toFixed(1)}`).join("L") + "Z").join(" ")} />
              {pl.batas.map((pg) => <polygon points={pg.map((t) => `${t.x.toFixed(1)},${t.y.toFixed(1)}`).join(" ")} pathLength="1" />)}
            </svg>
          )}
        </div>
      ))}

      <!-- Titik zona. Posisi persen untuk versi diam; skrip menimpanya dengan posisi layar. -->
      <div class="peta-titik">
        {ZONA.filter((zn) => !zn.hilang).map((zn) => (
          <>
            {zn.titikLain?.map((t) => (
              <span class="titik-lain" data-induk={zn.no} data-plat={zn.plat} data-x={t.x} data-y={t.y} style={`--x:${pct(t.x, STATIS.x, STATIS.w)};--y:${pct(t.y, STATIS.y, STATIS.h)}`} aria-hidden="true"></span>
            ))}
            <button type="button" class="pin" data-zona={zn.no} data-henti={zn.henti} data-plat={zn.plat} data-arah={zn.arah} data-x={zn.x} data-y={zn.y}
              style={`--x:${pct(zn.x, STATIS.x, STATIS.w)};--y:${pct(zn.y, STATIS.y, STATIS.h)}`}
              aria-label={`${L(TX.zona)} ${zn.no}: ${zn.nama}`} aria-haspopup="dialog">
              <span class="pin-garis" aria-hidden="true"></span>
              <span class="pin-isi">
                <span class="pin-kepala">{zn.no}</span>
                <span class="pin-label">{zn.label}</span>
              </span>
            </button>
          </>
        ))}
        {TEPI.map((t) => (
          <span class:list={["tepi-arah", `tepi-${t.arah}`]} data-x={t.x} data-y={t.y} data-henti={t.henti} data-plat={t.plat} style={`--x:${pct(t.x, STATIS.x, STATIS.w)};--y:${pct(t.y, STATIS.y, STATIS.h)}`}>
            <span class="tepi-isi">
              <svg class="tepi-panah" width="10" height="16" viewBox="0 0 10 16" aria-hidden="true"><path d="M5 15V2M1 6l4-4 4 4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
              {t.zona.length ? (
                <>
                  {t.zona.map((no) => {
                    const zn = ZONA.find((q) => q.no === no)!;
                    return <button type="button" class="tepi-tombol" data-buka={no} aria-haspopup="dialog" aria-label={`${L(TX.zona)} ${no}: ${zn.nama} (${L(TX.diLuarFoto)})`}>{zn.label}</button>;
                  })}
                </>
              ) : (
                <span class="tepi-teks">{L(t.label!)}</span>
              )}
            </span>
          </span>
        ))}
        {PINTU_MASUK && (
          <span class="pintu" data-plat="0" data-x={PINTU_MASUK.x} data-y={PINTU_MASUK.y} style={`--x:${pct(PINTU_MASUK.x, STATIS.x, STATIS.w)};--y:${pct(PINTU_MASUK.y, STATIS.y, STATIS.h)}`}>
            <span class="pintu-isi">{L(TX.pintu)}</span>
          </span>
        )}
      </div>
    </div>

    <!-- Kabut pindah plat: menutup sebentar saat kamera pindah dari plat utama ke plat lain -->
    {PLAT.length > 1 && (
      <div class="peta-kabut" aria-hidden="true">
        <span class="kabut-dasar"></span>
        <img class="kabut-uap" src="/peta/uap-tengah.webp" alt="" width="1200" height="900" decoding="async" loading="lazy" />
      </div>
    )}

    <!-- Uap air panas yang tersibak saat digulir -->
    <div class="peta-uap" aria-hidden="true">
      <span class="uap-dasar"></span>
      <img class="uap uap-kiri" src="/peta/uap-kiri.webp" alt="" width="1200" height="900" decoding="async" loading="lazy" />
      <img class="uap uap-kanan" src="/peta/uap-kanan.webp" alt="" width="1200" height="900" decoding="async" loading="lazy" />
      <img class="uap uap-tengah" src="/peta/uap-tengah.webp" alt="" width="1200" height="900" decoding="async" loading="lazy" />
    </div>

  </div>

</section>

  <!-- Daftar semua zona: sumber isi panel, juga versi tanpa JavaScript -->
  <details class="peta-daftar" id="setelah-peta">
    <summary><span class="lbl">{L(TX.daftar)}</span><span class="daftar-jml">{ZONA.length}</span></summary>
    <div class="daftar-isi">
      {[...ZONA].sort((a, b) => a.no.localeCompare(b.no)).map((zn) => {
        const harga = hargaZona(zn);
        const klip = KLIP_ZONA[zn.no];
        const dekat = dekatnya(zn);
        return (
          <article class="zona" id={`zona-${zn.no}`} data-zona-isi={zn.no} aria-labelledby={`h-zona-${zn.no}`}>
            <div class="zona-media">
              {klip ? (
                <video class="zona-video" muted playsinline preload="none" aria-hidden="true"
                  data-poster-dk={klip.desktop?.posterAvif ?? klip.desktop?.poster} data-poster-hp={klip.hp?.posterAvif ?? klip.hp?.poster ?? klip.desktop?.posterAvif}
                  data-mp4-dk={klip.desktop?.mp4} data-webm-dk={klip.desktop?.webm}
                  data-mp4-hp={klip.hp?.mp4 ?? klip.desktop?.mp4} data-webm-hp={klip.hp?.webm ?? klip.desktop?.webm}></video>
              ) : null}
              {zn.foto ? (
                <Picture class="zona-foto" src={foto(zn.foto)} formats={["avif", "webp"]} widths={[480, 720, 1040]} sizes="(min-width: 640px) 520px, 100vw" quality={55} alt={zn.fotoAlt ? L(zn.fotoAlt) : ""} loading="lazy" decoding="async" />
              ) : (
                <div class="zona-lensa">
                  {LENSA_U[zn.no] ? (
                    <>
                      <img src={`/peta/lensa-udara-${zn.no}.webp`} width="720" height="540" alt={lang === "en" ? `${zn.label} seen from the air` : `${zn.label} dilihat dari udara`} loading="lazy" decoding="async" />
                      <span class="lensa-titik" aria-hidden="true" style={`left:${LENSA_U[zn.no].x}%;top:${LENSA_U[zn.no].y}%`}>{zn.no}</span>
                    </>
                  ) : (
                    <>
                      <img src={`/peta/lensa-${zn.no}.webp`} width="720" height="540" alt={lang === "en" ? `Where ${zn.label} sits on the site map` : `Letak ${zn.label} di peta kawasan`} loading="lazy" decoding="async" />
                      <span class="lensa-titik" aria-hidden="true">{zn.no}</span>
                    </>
                  )}
                </div>
              )}
            </div>
            <div class="zona-teks">
              <p class="lbl">{L(TX.zona)} {zn.no} · {L(TX.kelompok[zn.kelompok])}</p>
              <h3 id={`h-zona-${zn.no}`}>{lekat(zn.nama)}</h3>
              <p class="zona-isi">{I(zn.isi)}</p>
              <ul class="zona-fakta">
                {zn.fakta.map((f) => <li>{L(f)}</li>)}
              </ul>
              {harga && (
                <div class="zona-harga">
                  <p class="harga-utama"><span class="lbl">{L(TX.mulai)}</span> <strong>{rupiah(harga.weekday)}</strong></p>
                  <p class="harga-ket">{L(zn.kamar?.startsWith("babakan-siluhur") ? TX.malamKompleks : TX.malam)} · {L(TX.weekend)}: {rupiah(harga.weekend)}</p>
                  <p class="harga-ket">{L(TX.termasukWeekday)} {L(TX.dinamis)}</p>
                </div>
              )}
              <div class="zona-aksi">
                {zn.cta === "sibentang" ? (
                  <>
                    <a class="btn btn-sibentang" href={SIBENTANG} rel="noopener"><span class="btn-tx">{L(TX.keSibentang)}</span></a>
                    <p class="harga-ket">{L(TX.noSibentang)}</p>
                  </>
                ) : zn.cta === "rapat" ? (
                  <>
                    <a class="btn btn-isi" href={hrefRapat}><span class="btn-tx">{L(TX.keRapat)}</span></a>
                    <a class="btn btn-wa" href={waLink(pesanWa(zn))} rel="noopener"><span class="btn-tx">{L(TX.tanyaWa)}</span></a>
                  </>
                ) : (
                  <>
                    <a class="btn btn-isi btn-wa" href={waLink(pesanWa(zn))} rel="noopener"><span class="btn-tx">{L(TX.tanyaWa)}</span></a>
                    {harga && zn.dip !== false && <a class="btn" href={BOOKING_URL} rel="noopener"><span class="btn-tx">{L(TX.cekKamar)}</span></a>}
                  </>
                )}
              </div>
              <div class="zona-dekat">
                <p class="lbl">{L(TX.dekat)}</p>
                <ul>
                  {dekat.map((d) => (
                    <li><a href={`#zona-${d.no}`} data-ganti={d.no}><span class="dekat-no">{d.no}</span><span class="dekat-nama">{d.label}</span><span class="dekat-kel">{L(TX.kelompok[d.kelompok])}</span></a></li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </details>

  <dialog class="zona-panel" aria-labelledby="zona-panel-judul">
    <div class="panel-kain">
      <button type="button" class="panel-tutup" aria-label={L(TX.tutup)}>
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 2l14 14M16 2 2 16" stroke="currentColor" stroke-width="1.6" fill="none" /></svg>
      </button>
      <div class="panel-isi" data-lenis-prevent>
        <div class="panel-badan"></div>
      </div>
      <span class="panel-tirai" aria-hidden="true"></span>
    </div>
  </dialog>
</div>

<script>
  import { mulaiPeta } from "../../scripts/peta";
  document.querySelectorAll<HTMLElement>("[data-peta]").forEach((el) => mulaiPeta(el));
</script>
