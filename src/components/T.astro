---
/**
 * Teks dwibahasa. Halaman ID ada di "/", EN di "/en/".
 * Komponen ini cuma merender satu bahasa, ditentukan dari URL halaman.
 * Pemakaian: <T id="Kolam air panas alami" en="Natural hot spring pool" />
 */
interface Props {
  id: string;
  en: string;
}
const { id, en } = Astro.props;
const isEn = Astro.url.pathname === "/en" || Astro.url.pathname.startsWith("/en/");
---
{isEn ? en : id}
