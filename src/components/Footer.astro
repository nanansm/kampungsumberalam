---
import T from "./T.astro";
import {
  NAMA_PANJANG,
  ALAMAT_SATU_BARIS,
  TELEPON,
  TELEPON_TAMPIL,
  TELEPON_ALT_TAMPIL,
  EMAIL,
  IG_URL,
  IG_HANDLE,
  SIBENTANG_URL,
  MAPS_URL,
} from "../data/content";

const tahun = 2026;

/* Kaki halaman ikut jadi peta situs. Menu utama sembunyi di balik tombol
   hamburger, jadi tanpa daftar ini satu-satunya jalan antar halaman
   mengharuskan tamu membuka menu lebih dulu. */
const halaman = [
  { href: "/accommodation/", id: "Menginap", en: "Stay" },
  { href: "/meetings/", id: "Rapat dan outing", en: "Meetings and outings" },
  { href: "/events/", id: "Acara dan perayaan", en: "Events" },
  { href: "/gallery/", id: "Galeri", en: "Gallery" },
  { href: "/location/", id: "Lokasi", en: "Location" },
  { href: "/about/", id: "Tentang", en: "About" },
];
---

<footer class="border-t border-garis">
  <div
    class="mx-auto grid max-w-[1200px] gap-10 px-5 py-14 sm:grid-cols-2 sm:px-8 sm:py-20 lg:grid-cols-[1.3fr_1fr_1fr_1fr]"
  >
    <div>
      <img
        src="/logo/logotype-hitam.svg"
        alt={NAMA_PANJANG}
        width="140"
        height="30"
        class="h-7 w-auto"
      />
      <p class="mt-5 max-w-[30ch] text-sm text-tinta-lembut">
        {ALAMAT_SATU_BARIS}
      </p>
      <a
        href={MAPS_URL}
        rel="noopener"
        target="_blank"
        class="mt-3 inline-block border-b border-hutan pb-0.5 text-sm text-hutan"
      >
        <T id="Buka di Google Maps" en="Open in Google Maps" />
      </a>
    </div>

    <div class="text-sm">
      <p class="penanda"><T id="Halaman" en="Pages" /></p>
      <ul class="mt-3 space-y-2">
        {
          halaman.map((h) => (
            <li>
              <a href={h.href}>
                <T id={h.id} en={h.en} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="text-sm">
      <p class="penanda"><T id="Reservasi" en="Reservations" /></p>
      <ul class="mt-3 space-y-2">
        <li><a href={`tel:${TELEPON}`}>{TELEPON_TAMPIL}</a></li>
        <li>{TELEPON_ALT_TAMPIL}</li>
        <li class="break-all">
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </li>
      </ul>
    </div>

    <div class="text-sm">
      <p class="penanda"><T id="Tautan" en="Links" /></p>
      <ul class="mt-3 space-y-2">
        <li>
          <a href={IG_URL} rel="noopener" target="_blank">{IG_HANDLE}</a>
        </li>
        <li>
          <a href={SIBENTANG_URL} rel="noopener">Private Villa Sibentang</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="mx-auto max-w-[1200px] px-5 pb-10 sm:px-8">
    <p class="text-xs text-tinta-lembut">
      &copy; {tahun} {NAMA_PANJANG}
    </p>
  </div>
</footer>
