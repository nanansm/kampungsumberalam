---
/**
 * Beranda. Urutannya bercerita dulu, menawarkan belakangan:
 * hero → prolog air Guntur → satu hari di kampung (Cerita) → peta kawasan →
 * cara berendam → kamar → cara menginap (harga) → perjalanan & lokasi → ulasan → ajakan.
 * Tawaran dan harga muncul sebagai akibat cerita (arahan CD, 20 Nov 2026).
 */
import { Picture, getImage } from "astro:assets";
import Situs from "../layouts/Situs.astro";
import Hero from "./Hero.astro";
import Cerita from "./Cerita.astro";
import PetaKawasan from "./peta/PetaKawasan.astro";
import PetaPerjalanan from "./PetaPerjalanan.astro";
import { HERO_VIDEO } from "../data/drone";
import { BOOKING_URL, SIBENTANG_URL, MAPS_URL, ULASAN, TELEPON, TELEPON_TAMPIL, KAMAR, DAY_VISIT, waLink } from "../data/content";
import { lekat, rapi, rapiIsi } from "../data/rag";
import id from "../i18n/id.json";
import en from "../i18n/en.json";

import caraBerdua from "../assets/foto/cara-berdua.jpg";
import caraKeluarga from "../assets/foto/cara-keluarga.jpg";
/* kartu kantor: ruang makan kayu Restoran Tunjung Balebat, lebih dekat ke suasana kampung
   daripada foto ballroom (QA putaran 2) */
import caraKantor from "../assets/images/restoran-tunjung.webp";
import lokasiDesk from "../assets/foto/lokasi-desk.jpg";
import lokasiHp from "../assets/foto/lokasi-hp.jpg";
/* galeri kamar: satu foto Catalog per tipe kamar (src/assets/peta), keterangannya tipe + satu fakta */
import fKawung from "../assets/peta/kawung.jpg";
import fPondok from "../assets/peta/pondok-kalapa.jpg";
import fB114 from "../assets/peta/bungalow-1-14.jpg";
import fSiceeh from "../assets/peta/henti-belakang.jpg";
import fArileu from "../assets/peta/bungalow-arileu.jpg";
import fCouple from "../assets/peta/suite-couple.jpg";
import fJunior from "../assets/peta/jr-suite.jpg";
import fSiluhur from "../assets/peta/babakan-siluhur-1.jpg";
import vHp from "../assets/foto/video-hp.jpg";
import vDk from "../assets/foto/video-dk.jpg";

interface Props { lang: "id" | "en" }
const { lang } = Astro.props;
const T: Record<string, string> = lang === "en" ? en : id;
const t = (k: string) => {
  const v = T[k];
  if (v === undefined) throw new Error(`Teks hilang: ${lang}.${k}`);
  return v;
};
const L = (k: string) => rapi(t(k));
const I = (k: string) => rapiIsi(t(k));


/* Poster hero = gambar LCP. Poster manifest drone kalau sudah ada, kalau belum poster video udara lama. */
const MQ_HP = "(max-width: 767px)";
const MQ_DK = "(min-width: 768px)";
const lamaHp = await getImage({ src: vHp, widths: [480, 720], format: "avif", quality: 42 });
const lamaDk = await getImage({ src: vDk, widths: [1024, 1600, 2048], format: "avif", quality: 42 });
const lamaDkWebp = await getImage({ src: vDk, width: 1600, format: "webp", quality: 70 });
const posterHp = HERO_VIDEO.hp.posterAvif ?? lamaHp.srcSet.attribute;
const posterDk = HERO_VIDEO.desktop.posterAvif ?? lamaDk.srcSet.attribute;
const posterSrc = HERO_VIDEO.desktop.poster ?? lamaDkWebp.src;

const pesanWa = t("wa.umum");
const berendam = [1, 2, 3, 4].map((n) => ({ nama: t(`berendam.${n}.nama`), isi: I(`berendam.${n}.isi`), url: n === 4 ? SIBENTANG_URL : undefined }));
const fotoKamar = [fKawung, fPondok, fB114, fSiceeh, fArileu, fCouple, fJunior, fSiluhur];
const capKamar = fotoKamar.map((_, i) => L(`menginap.foto${i + 1}`));
const caraImg = [caraBerdua, caraKeluarga, caraKantor];
const waKey = ["wa.berdua", "wa.keluarga", "wa.kantor"];
const cara = [1, 2, 3].map((n, i) => ({ lbl: t(`cara.${n}.label`), nama: L(`cara.${n}.nama`), isi: I(`cara.${n}.isi`), harga: L(`cara.${n}.harga`), img: caraImg[i], alt: t(`alt.cara${n}`), wa: t(waKey[i]) }));
const tipe = KAMAR.map((k) => ({ nama: k.nama, villa: k.kelompok === "villa" }));
const telHref = `tel:${TELEPON}`;
const p2 = t("lokasi.p2").split(TELEPON_TAMPIL);
const geser = lang === "en" ? "Drag" : "Geser";
const rapat = lang === "en" ? "/en/meetings/" : "/meetings/";
/* format angka Inggris di halaman EN: 4.5 dan 9,902 */
const angka = (v: string) => (lang === "en" ? v.replace(",", ".") : v);
const ribuan = (v: string) => (lang === "en" ? v.replace(/\./g, ",") : v);
const kamarHal = lang === "en" ? "/en/accommodation/" : "/accommodation/";
---
<Situs
  lang={lang}
  T={T}
  title={t("meta.title")}
  description={t("meta.desc")}
  waPesan={pesanWa}
  preload={[
    { srcset: posterHp, sizes: "100vw", media: MQ_HP, type: "image/avif" },
    { srcset: posterDk, sizes: "100vw", media: MQ_DK, type: "image/avif" },
  ]}
>
  <Hero slot="hero" lang={lang} judul={t("hero.h1")} sub={t("hero.sub")} gulir={t("hero.gulir")} alt={t("video.label")} posterHp={posterHp} posterDk={posterDk} posterSrc={posterSrc} />

  <!-- Prolog: dua kalimat yang menyala kata demi kata saat digulir -->
  <div class="pembuka" id="pembuka">
    <p class="pembuka-lead" data-nyala>{I("pembuka.lead")}</p>
  </div>

  <Cerita t={t} />

  <div class="bilik" role="presentation"></div>

  <PetaKawasan lang={lang} />

  <!-- Cara berendam -->
  <section id="berendam" class="berendam cv" aria-labelledby="h-berendam">
    <div class="kepala">
      <div class="judul-garis"><h2 id="h-berendam" data-judul>{L("berendam.judul")}</h2></div>
      <p class="pengantar" data-muncul>{I("berendam.pengantar")}</p>
    </div>
    <ol class="empat">
      {berendam.map((b, i) => (
        <li data-muncul>
          <span class="no">0{i + 1}</span>
          <h3>{b.nama}</h3>
          <p>{b.isi}{b.url && <> <a class="panah" href={b.url} rel="noopener">{t("berendam.4.link")}</a></>}</p>
        </li>
      ))}
    </ol>
    <div class="dv">
      <h3 class="dv-judul" data-muncul>{t("dv.judul")}</h3>
      <ul>
        {DAY_VISIT.map((d) => (
          <li data-muncul>
            <p class="dv-nama">{d.nama}</p>
            <p class="dv-harga">{lekat(d.harga[lang])}</p>
            <p>{rapiIsi(d.isi[lang])}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Kamar -->
  <section id="menginap" class="menginap cv" aria-labelledby="h-menginap">
    <div class="kepala">
      <div class="judul-garis"><h2 id="h-menginap" data-judul>{L("menginap.judul")}</h2></div>
      <p data-muncul>{I("menginap.p")}</p>
    </div>
    <div class="geser-kepala" aria-hidden="true"><span></span><span class="geser-no"><span data-geser-no>01</span> / {String(fotoKamar.length).padStart(2, "0")}</span></div>
    <div class="geser geser--lebar" tabindex="0" aria-label={t("menginap.judul")} data-kursor={geser}>
      {fotoKamar.map((img, i) => (
        <figure class="kartu-foto">
          <Picture src={img} formats={["avif", "webp"]} widths={[320, 480, 640, 800]} sizes="(min-width: 1024px) 28vw, (min-width: 640px) 44vw, 78vw" quality={48} alt={capKamar[i]} loading="lazy" draggable="false" />
          <figcaption><span class="n">{String(i + 1).padStart(2, "0")}</span><span class="cap">{capKamar[i]}</span></figcaption>
        </figure>
      ))}
    </div>
    <div class="aksi" data-muncul>
      <a class="btn" href={BOOKING_URL} rel="noopener"><span class="btn-tx">{t("menginap.tombol")}</span></a>
      <a class="panah" href={kamarHal}>{t("menginap.semua")}</a>
      <p class="tipe">{tipe.map((x) => (x.villa ? <span><a href={SIBENTANG_URL} rel="noopener">{lekat(x.nama)}</a></span> : <span>{lekat(x.nama)}</span>))}</p>
    </div>
  </section>

  <!-- Cara menginap: harga sebagai akibat cerita -->
  <section id="datang" class="cara cv" aria-labelledby="h-cara">
    <div class="cara-in">
      <h2 id="h-cara" data-judul>{L("cara.judul")}</h2>
      <span class="goresan goresan--rumah" aria-hidden="true"></span>
      <div class="cara-grid">
        {cara.map((c) => (
          <article class="kartu" data-muncul>
            <p class="lbl">{c.lbl}</p>
            <h3>{c.nama}</h3>
            <div class="kartu-gbr"><Picture src={c.img} formats={["avif", "webp"]} widths={[360, 560, 800]} sizes="(min-width: 900px) 30vw, 90vw" quality={45} alt={c.alt} loading="lazy" /></div>
            <p>{c.isi}</p>
            <p class="harga">{c.harga}</p>
            <a class="btn btn-wa" href={waLink(c.wa)} rel="noopener"><span class="btn-tx">{t("cara.tombol")}</span></a>
          </article>
        ))}
      </div>
      <div class="cara-bawah">
        <p class="catatan">{I("cara.catatan")}</p>
        <p class="catatan">{I("cara.ruang")} <a class="panah" href={rapat}>{t("cara.semua")}</a></p>
      </div>
    </div>
  </section>

  <PetaPerjalanan lang={lang} />

  <!-- Guntur + lokasi -->
  <section id="lokasi" class="guntur cv" aria-labelledby="h-lokasi">
    <div class="guntur-gbr" data-parallax="6">
      <picture>
        <source media="(min-width: 768px)" srcset={(await getImage({ src: lokasiDesk, widths: [768, 1280, 1920], format: "avif", quality: 45 })).srcSet.attribute} sizes="100vw" type="image/avif" />
        <source media="(max-width: 767px)" srcset={(await getImage({ src: lokasiHp, widths: [400, 614], format: "avif", quality: 45 })).srcSet.attribute} sizes="100vw" type="image/avif" />
        <source media="(max-width: 767px)" srcset={(await getImage({ src: lokasiHp, widths: [400, 614], format: "webp", quality: 65 })).srcSet.attribute} sizes="100vw" type="image/webp" />
        <img src={(await getImage({ src: lokasiDesk, width: 1280, format: "webp", quality: 70 })).src} alt={t("alt.lokasi")} width={lokasiDesk.width} height={lokasiDesk.height} loading="lazy" decoding="async" />
      </picture>
    </div>
    <div class="kotak" data-muncul>
      <p class="lbl">{t("lokasi.label")}</p>
      <h2 id="h-lokasi">{L("lokasi.judul")}</h2>
      <p>{I("lokasi.p1")}</p>
      <p style="margin-top:12px">{rapiIsi(p2[0])}{p2.length > 1 && <><a href={telHref} style="white-space:nowrap">{TELEPON_TAMPIL}</a>{p2[1]}</>}</p>
      <a class="btn" href={MAPS_URL} rel="noopener" style="margin-top:20px"><span class="btn-tx">{t("lokasi.tombol")}</span></a>
    </div>
  </section>

  <!-- Ulasan -->
  <section class="ulasan cv" aria-labelledby="h-ulasan">
    <div class="ulasan-in">
      <h2 id="h-ulasan" data-judul>{L("ulasan.judul")}</h2>
      <div class="angka">
        {ULASAN.map((u) => (
          <div data-muncul>
            <p class="lbl">{u.sumber}</p>
            <p class="skor"><span data-angka={angka(u.nilai)}>{angka(u.nilai)}</span><small> / {u.dari}</small></p>
            <p>{ribuan(u.jumlah)} {t("ulasan.kata")} · {lekat(u.catatan[lang])}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="bilik" role="presentation"></div>

  <!-- Penutup -->
  <section class="penutup cv" aria-labelledby="h-tutup">
    <span class="goresan goresan--teratai" aria-hidden="true"></span>
    <h2 id="h-tutup" data-judul>{L("penutup.judul")}</h2>
    <p class="penutup-ket" data-muncul>{I("penutup.ket")}</p>
    <div class="dua" data-muncul>
      <a class="btn btn-isi btn-wa" href={waLink(pesanWa)} rel="noopener"><span class="btn-tx">{t("penutup.tombol1")}</span></a>
      <a class="btn" href={BOOKING_URL} rel="noopener"><span class="btn-tx">{t("penutup.tombol2")}</span></a>
    </div>
  </section>
</Situs>
