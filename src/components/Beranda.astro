---
import { Picture, getImage } from "astro:assets";
import Situs from "../layouts/Situs.astro";
import { BOOKING_URL, SIBENTANG_URL, MAPS_URL, ULASAN, TELEPON, TELEPON_TAMPIL, waLink } from "../data/content";
import id from "../i18n/id.json";
import en from "../i18n/en.json";

import sambut1 from "../assets/foto/sambut-1.jpg";
import sambut2 from "../assets/foto/sambut-3.jpg";
import berendamHp from "../assets/foto/berendam-hp.jpg";
import berendamDesk from "../assets/foto/berendam-desk.jpg";
import menginapImg from "../assets/foto/menginap.jpg";
import caraBerdua from "../assets/foto/cara-berdua.jpg";
import caraKeluarga from "../assets/foto/cara-keluarga.jpg";
import caraKantor from "../assets/foto/cara-kantor.jpg";
import lokasiDesk from "../assets/foto/lokasi-desk.jpg";
import lokasiHp from "../assets/foto/lokasi-hp.jpg";
import vHp from "../assets/foto/video-hp.jpg";
import vDk from "../assets/foto/video-dk.jpg";

interface Props { lang: "id" | "en" }
const { lang } = Astro.props;
const T: Record<string, string> = lang === "en" ? en : id;
const t = (k: string) => {
  const v = T[k];
  if (v === undefined) throw new Error(`Teks hilang: ${lang}.${k}`);
  return v;
};

const kataImg = Object.values(import.meta.glob<{ default: ImageMetadata }>("../assets/foto/kata-*.jpg", { eager: true })).map((m) => m.default);
const turImg = Object.values(import.meta.glob<{ default: ImageMetadata }>("../assets/foto/tur-*.jpg", { eager: true })).map((m) => m.default);
const kampungImg = Object.values(import.meta.glob<{ default: ImageMetadata }>("../assets/foto/kampung-*.jpg", { eager: true })).map((m) => m.default);

/* Hero = auto carousel ala Bambu Indah.
   HP: 5 slide statement utuh (4:5, teks sudah di gambar).
   Desktop: 4 foto dari slide yang sama (S2-S5) dipotong lebar tanpa teks, judul satu kata dari HTML.
   Hanya slide pertama dimuat saat buka halaman; sisanya dimuat setelah halaman selesai (lihat script). */
const Q = 34;
const GIF = "data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==";
const hpMods = import.meta.glob<{ default: ImageMetadata }>("../assets/foto/hero-hp-*.jpg", { eager: true });
const dkMods = import.meta.glob<{ default: ImageMetadata }>("../assets/foto/hero-dk-*.jpg", { eager: true });
const HP_W = [480, 720, 960, 1440];
const DK_W = [1024, 1440, 1920];
const kata = ["", "Sundanese", "Thermal", "Escape", "Village"];
const slides = await Promise.all([1, 2, 3, 4, 5].map(async (n) => {
  const hp = hpMods[`../assets/foto/hero-hp-${n}.jpg`].default;
  const dk = n > 1 ? dkMods[`../assets/foto/hero-dk-${n}.jpg`].default : undefined;
  return {
    n,
    alt: t(`hero.alt${n}`),
    kata: kata[n - 1],
    hpAvif: (await getImage({ src: hp, widths: HP_W, format: "avif", quality: Q })).srcSet.attribute,
    hpWebp: (await getImage({ src: hp, widths: HP_W, format: "webp", quality: 70 })).srcSet.attribute,
    dkAvif: dk ? (await getImage({ src: dk, widths: DK_W, format: "avif", quality: Q })).srcSet.attribute : GIF,
    dkWebp: dk ? (await getImage({ src: dk, widths: DK_W, format: "webp", quality: 70 })).srcSet.attribute : GIF,
  };
}));
/* LCP: HP = slide 1, desktop = slide 2 (slide 1 hanya untuk HP) */
const lcpHp = slides[0];
const lcpDk = slides[1];
const MQ_HP = "(max-width: 767px)";
const vhpPoster = await getImage({ src: vHp, widths: [480, 720], format: "avif", quality: 40 });
const vdkPoster = await getImage({ src: vDk, widths: [1024, 1600], format: "avif", quality: 40 });
const vdkPosterW = await getImage({ src: vDk, width: 1280, format: "webp", quality: 65 });
const MQ_DK = "(min-width: 768px)";

const pesanWa = t("wa.umum");
const berendam = [1, 2, 3, 4].map((n) => ({ nama: t(`berendam.${n}.nama`), isi: t(`berendam.${n}.isi`), url: n === 4 ? SIBENTANG_URL : undefined }));
const kataAlt = [2, 3, 4, 5].map((n) => t(`alt.kata${n}`));
const turCap = [2, 3, 4, 5, 6, 7, 8].map((n) => t(`menginap.foto${n}`));
const caraImg = [caraBerdua, caraKeluarga, caraKantor];
const waKey = ["wa.berdua", "wa.keluarga", "wa.kantor"];
const cara = [1, 2, 3].map((n, i) => ({ lbl: t(`cara.${n}.label`), nama: t(`cara.${n}.nama`), isi: t(`cara.${n}.isi`), harga: t(`cara.${n}.harga`).replace("Twin Share", "Twin\u00a0Share").replace(/(\d) (per)/, "$1\u00a0$2"), img: caraImg[i], alt: t(`alt.cara${n}`), wa: t(waKey[i]) }));
const kampungCap = [1, 2, 3, 4].map((n) => t(`seharian.foto${n}`));
const kampungAlt = [1, 2, 3, 4].map((n) => t(`alt.seharian${n}`));
const tipe = ["Bungalow", "Bungalow Siceeh", "Kawung", "Pondok Kalapa", "Junior Suite", "Deluxe Suite", "Babakan Siluhur"];
const telHref = `tel:${TELEPON}`;
const p2 = t("lokasi.p2").split(TELEPON_TAMPIL);
---
<Situs
  lang={lang}
  T={T}
  title={t("meta.title")}
  description={t("meta.desc")}
  waPesan={pesanWa}
  preload={[
    { srcset: lcpHp.hpAvif, sizes: "100vw", media: MQ_HP, type: "image/avif" },
    { srcset: lcpDk.dkAvif, sizes: "100vw", media: MQ_DK, type: "image/avif" },
  ]}
>
  <!-- Layar pertama ala Bambu Indah: carousel gambar, lalu blok logo. Header baru muncul setelah scroll. -->
  <div class="layar1" slot="hero">
    <section class="hero" aria-roledescription="carousel" aria-labelledby="h-hero">
      <h1 id="h-hero" class="sr">{t("hero.h1")}</h1>
      {slides.map((sl) => {
        const awalHp = sl.n === 1;
        const awalDk = sl.n === 2;
        return (
          <figure class:list={["sl", { "hp-saja": sl.n === 1, on: sl.n === 1, "on-dk": sl.n === 2 }]} aria-roledescription="slide" aria-label={`${sl.n} / 5`}>
            <picture>
              <source media={MQ_HP} type="image/avif" srcset={awalHp ? sl.hpAvif : GIF} data-srcset={awalHp ? undefined : sl.hpAvif} sizes="100vw" />
              <source media={MQ_HP} type="image/webp" srcset={awalHp ? sl.hpWebp : GIF} data-srcset={awalHp ? undefined : sl.hpWebp} sizes="100vw" />
              <source media={MQ_DK} type="image/avif" srcset={awalDk || sl.n === 1 ? sl.dkAvif : GIF} data-srcset={awalDk || sl.n === 1 ? undefined : sl.dkAvif} sizes="100vw" />
              <source media={MQ_DK} type="image/webp" srcset={awalDk || sl.n === 1 ? sl.dkWebp : GIF} data-srcset={awalDk || sl.n === 1 ? undefined : sl.dkWebp} sizes="100vw" />
              <img src={GIF} alt={sl.alt} width="1440" height="1800" fetchpriority={awalHp || awalDk ? "high" : "low"} decoding="async" />
            </picture>
            {sl.kata && <p class="kata" aria-hidden="true">{sl.kata}</p>}
          </figure>
        );
      })}
    </section>
    <div class="layar1-logo">
      <img src="/logo/lockup-color.svg" alt="Kampung Sumber Alam Resort" width="1948" height="1396" />
      <p>Cipanas · Garut</p>
    </div>
  </div>
  <script is:inline>(()=>{const h=document.querySelector('.hero');if(!h)return;const S=[...h.querySelectorAll('.sl')];let mulai=false;const muat=()=>{h.querySelectorAll('source[data-srcset]').forEach(x=>{x.srcset=x.dataset.srcset;x.removeAttribute('data-srcset')})};const aktif=()=>S.filter(x=>getComputedStyle(x).display!=='none');const jalan=()=>{if(mulai||matchMedia('(prefers-reduced-motion: reduce)').matches)return;mulai=true;muat();let i=0;setInterval(()=>{if(document.hidden)return;const A=aktif();const c=A.findIndex(x=>x.classList.contains('tampil'));const k=c<0?0:c;const n=(k+1)%A.length;const im=A[n].querySelector('img');const ganti=()=>{A.forEach(x=>x.classList.remove('tampil'));A[n].classList.add('tampil')};if(im.complete&&im.naturalWidth>1)ganti();else im.addEventListener('load',ganti,{once:true})},5000)};S.forEach(x=>x.classList.remove('on','on-dk'));aktif()[0].classList.add('tampil');const t0=()=>setTimeout(jalan,1500);document.readyState==='complete'?t0():addEventListener('load',t0,{once:true})})()</script>

  <!-- Video udara: dimuat saat mendekati layar, tanpa suara -->
  <section class="udara-vid" aria-label={t("video.label")}>
    <picture>
      <source media={MQ_HP} type="image/avif" srcset={vhpPoster.srcSet.attribute} sizes="100vw" />
      <source media={MQ_DK} type="image/avif" srcset={vdkPoster.srcSet.attribute} sizes="100vw" />
      <img src={vdkPosterW.src} alt={t("video.label")} width="1600" height="900" loading="lazy" decoding="async" />
    </picture>
    <video muted loop playsinline preload="none" aria-hidden="true" data-hp="/video/udara-hp" data-dk="/video/udara-dk"></video>
  </section>
  <script is:inline>(()=>{const v=document.querySelector('.udara-vid video');if(!v||matchMedia('(prefers-reduced-motion: reduce)').matches)return;const E=['scroll','pointerdown','keydown','touchstart'];const go=()=>{E.forEach(e=>removeEventListener(e,go));const o=new IntersectionObserver(x=>{if(x[0].isIntersecting){o.disconnect();const b=matchMedia('(max-width: 767px)').matches?v.dataset.hp:v.dataset.dk;v.src=b+(v.canPlayType('video/mp4; codecs="avc1.64001f"')?'.mp4':'.webm');v.addEventListener('playing',()=>v.classList.add('on'),{once:true});v.play().catch(()=>{})}},{rootMargin:'300px'});o.observe(v)};E.forEach(e=>addEventListener(e,go,{passive:true}))})()</script>

  <!-- Penanda brand -->
  <div class="merek">
    <p class="lead">{t("pembuka.lead")}</p>
    <div class="dua"><a class="btn btn-isi" href={waLink(pesanWa)} rel="noopener">{t("penutup.tombol1")}</a><a class="btn" href={BOOKING_URL} rel="noopener">{t("penutup.tombol2")}</a></div>
  </div>

  <!-- Sambutan -->
  <section class="sambut cv" aria-labelledby="h-sambut">
    <div class="teks">
      <p class="lbl">{t("sambut.label")}</p>
      <h2 id="h-sambut">{t("sambut.judul")}</h2>
      <p>{t("sambut.p1")}</p>
      <p>{t("sambut.p2")}</p>
    </div>
    <figure class="f1">
      <Picture src={sambut1} formats={["avif", "webp"]} widths={[400, 640, 900]} sizes="(min-width: 900px) 34vw, 78vw" quality={45} alt={t("alt.sambut1")} loading="lazy" />
    </figure>
    <figure class="f2">
      <Picture src={sambut2} formats={["avif", "webp"]} widths={[360, 560, 800]} sizes="(min-width: 900px) 28vw, 64vw" quality={45} alt={t("alt.sambut2")} loading="lazy" />
    </figure>
  </section>

  <div class="bilik" role="presentation"></div>

  <!-- Berendam -->
  <section id="berendam" class="berendam cv" aria-labelledby="h-berendam">
    <div class="pita-img">
      <picture>
        <source media="(min-width: 768px)" srcset={(await getImage({ src: berendamDesk, widths: [768, 1280, 1920], format: "avif", quality: 45 })).srcSet.attribute} sizes="100vw" type="image/avif" />
        <source media="(max-width: 767px)" srcset={(await getImage({ src: berendamHp, widths: [400, 614], format: "avif", quality: 45 })).srcSet.attribute} sizes="100vw" type="image/avif" />
        <source media="(max-width: 767px)" srcset={(await getImage({ src: berendamHp, widths: [400, 614], format: "webp", quality: 65 })).srcSet.attribute} sizes="100vw" type="image/webp" />
        <img src={(await getImage({ src: berendamDesk, width: 1280, format: "webp", quality: 70 })).src} alt={t("alt.berendam")} width={berendamDesk.width} height={berendamDesk.height} loading="lazy" decoding="async" style="width:100%;height:auto" />
      </picture>
    </div>
    <div class="kepala">
      <div class="judul-garis"><h2 id="h-berendam">{t("berendam.judul")}</h2></div>
      <p class="pengantar">{t("berendam.pengantar")}</p>
    </div>
    <ol class="empat">
      {berendam.map((b, i) => (
        <li>
          <span class="no">0{i + 1}</span>
          <h3>{b.nama}</h3>
          <p>{b.isi}{b.url && <> <a class="panah" href={b.url} rel="noopener">{t("berendam.4.link")}</a></>}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Empat kata -->
  <section class="kata cv" aria-labelledby="h-kata">
    <div class="kepala">
      <h2 id="h-kata">{t("kata.judul")}</h2>
      <p>{t("kata.p")}</p>
    </div>
    <div class="geser" tabindex="0" aria-label={t("kata.judul")}>
      {kataImg.map((img, i) => (
        <figure class="kartu-foto">
          <Picture src={img} formats={["avif", "webp"]} widths={[320, 480, 640, 800]} sizes="(min-width: 1024px) 28vw, (min-width: 640px) 44vw, 78vw" quality={45} alt={kataAlt[i]} loading="lazy" />
          <figcaption><span class="n">0{i + 1}</span><span>/ 04</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- Menginap -->
  <section id="menginap" class="menginap cv" aria-labelledby="h-menginap">
    <div class="kepala">
      <div class="judul-garis"><h2 id="h-menginap">{t("menginap.judul")}</h2></div>
      <p>{t("menginap.p")}</p>
    </div>
    <div class="geser" tabindex="0" aria-label={t("menginap.judul")}>
      <figure class="kartu-foto">
        <Picture src={menginapImg} formats={["avif", "webp"]} widths={[320, 480, 640, 800]} sizes="(min-width: 1024px) 28vw, (min-width: 640px) 44vw, 78vw" quality={45} alt={t("menginap.foto1")} loading="lazy" />
        <figcaption><span class="n">01</span><span>{t("menginap.foto1")}</span></figcaption>
      </figure>
      {turImg.map((img, i) => (
        <figure class="kartu-foto">
          <Picture src={img} formats={["avif", "webp"]} widths={[320, 480, 640, 800]} sizes="(min-width: 1024px) 28vw, (min-width: 640px) 44vw, 78vw" quality={45} alt={turCap[i]} loading="lazy" />
          <figcaption><span class="n">{String(i + 2).padStart(2, "0")}</span><span>{turCap[i]}</span></figcaption>
        </figure>
      ))}
    </div>
    <div class="aksi">
      <a class="btn" href={BOOKING_URL} rel="noopener">{t("menginap.tombol")}</a>
      <a class="panah" href={lang === "en" ? "/en/accommodation/" : "/accommodation/"}>{t("menginap.semua")}</a>
      <p class="tipe">{tipe.map((x) => <span>{x}</span>)}</p>
    </div>
  </section>

  <!-- Tiga cara datang -->
  <section id="datang" class="cara cv" aria-labelledby="h-cara">
    <div class="cara-in">
      <h2 id="h-cara">{t("cara.judul")}</h2>
      <div class="cara-grid">
        {cara.map((c) => (
          <article class="kartu">
            <p class="lbl">{c.lbl}</p>
            <h3>{c.nama}</h3>
            <Picture src={c.img} formats={["avif", "webp"]} widths={[360, 560, 800]} sizes="(min-width: 900px) 30vw, 90vw" quality={45} alt={c.alt} loading="lazy" />
            <p>{c.isi}</p>
            <p class="harga">{c.harga}</p>
            <a class="btn" href={waLink(c.wa)} rel="noopener">{t("cara.tombol")}</a>
          </article>
        ))}
      </div>
      <p class="catatan">{t("cara.catatan")}</p>
      <p class="catatan"><a class="panah" href={lang === "en" ? "/en/meetings/" : "/meetings/"}>{t("cara.semua")}</a></p>
    </div>
  </section>

  <!-- Seharian -->
  <section id="seharian" class="kampung cv" aria-labelledby="h-kampung">
    <div class="kepala">
      <h2 id="h-kampung">{t("seharian.judul")}</h2>
      <p>{t("seharian.p")}</p>
    </div>
    <div class="jajar">
      {kampungImg.map((img, i) => (
        <figure>
          <Picture src={img} formats={["avif", "webp"]} widths={[240, 400, 600]} sizes="(min-width: 900px) 25vw, 50vw" quality={45} alt={kampungAlt[i]} loading="lazy" />
          <figcaption>{kampungCap[i]}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- Guntur + lokasi -->
  <section id="lokasi" class="guntur cv" aria-labelledby="h-lokasi">
    <picture>
      <source media="(min-width: 768px)" srcset={(await getImage({ src: lokasiDesk, widths: [768, 1280, 1920], format: "avif", quality: 45 })).srcSet.attribute} sizes="100vw" type="image/avif" />
      <source media="(max-width: 767px)" srcset={(await getImage({ src: lokasiHp, widths: [400, 614], format: "avif", quality: 45 })).srcSet.attribute} sizes="100vw" type="image/avif" />
      <source media="(max-width: 767px)" srcset={(await getImage({ src: lokasiHp, widths: [400, 614], format: "webp", quality: 65 })).srcSet.attribute} sizes="100vw" type="image/webp" />
      <img src={(await getImage({ src: lokasiDesk, width: 1280, format: "webp", quality: 70 })).src} alt={t("alt.lokasi")} width={lokasiDesk.width} height={lokasiDesk.height} loading="lazy" decoding="async" />
    </picture>
    <div class="kotak">
      <p class="lbl">{t("lokasi.label")}</p>
      <h2 id="h-lokasi">{t("lokasi.judul")}</h2>
      <p>{t("lokasi.p1")}</p>
      <p style="margin-top:12px">{p2[0]}{p2.length > 1 && <><a href={telHref}>{TELEPON_TAMPIL}</a>{p2[1]}</>}</p>
      <a class="btn" href={MAPS_URL} rel="noopener" style="margin-top:20px">{t("lokasi.tombol")}</a>
    </div>
  </section>

  <!-- Ulasan -->
  <section class="ulasan cv" aria-labelledby="h-ulasan">
    <div class="ulasan-in">
      <h2 id="h-ulasan" style="font-size:clamp(1.9rem,3.4vw,2.8rem)">{t("ulasan.judul")}</h2>
      <div class="angka">
        {ULASAN.map((u) => (
          <div>
            <p class="lbl">{u.sumber}</p>
            <p class="skor">{u.nilai}<small> / {u.dari}</small></p>
            <p>{u.jumlah} {t("ulasan.kata")} · {u.catatan[lang]}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="bilik" role="presentation"></div>

  <!-- Penutup -->
  <section class="penutup cv" aria-labelledby="h-tutup">
    <h2 id="h-tutup">{t("penutup.judul")}</h2>
    <div class="dua">
      <a class="btn btn-isi" href={waLink(pesanWa)} rel="noopener">{t("penutup.tombol1")}</a>
      <a class="btn" href={BOOKING_URL} rel="noopener">{t("penutup.tombol2")}</a>
    </div>
  </section>
</Situs>
