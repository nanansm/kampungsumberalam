---
import { altTeks } from "../../data/alt-en";
import Halaman from "../../layouts/Halaman.astro";
import Gbr from "../Gbr.astro";

import T from "../T.astro";
import { NAMA, RESTORAN, SPA, MUSIK, ULASAN } from "../../data/content";
import { lekat, rapiIsi } from "../../data/rag";

/* Halaman tentang. Ragam formal, sapaan "Anda".
   Sumber satu-satunya: Data Master KSA FINAL (9 Nov 2026).
   - Balong dan warga: bab 09 §9.6 (kutipan Pak Uli yang boleh dipakai).
   - Asal air, keramahan Sunda, visi, arti Rest/Recover/Rejuvenate: bab 01 §5
     (bunyi situs resmi). Versi Inggris tiga prinsip dikutip apa adanya.
   - Empat batas: bab 00 §4. Live music: bab 03 §2 (Publish Rate check-in Sabtu).
   Kata "sanctuary" TIDAK dipakai sampai program Bungalow Siceeh lengkap
   (bab 01 §4.6). */

const prinsip = [
  {
    nama: "Rest",
    teks: {
      id: "Anda mendapat ruang untuk jeda dan menarik napas, jauh dari tuntutan sehari-hari.",
      en: "Creating space to pause, breathe, and step away from the demands of daily life.",
    },
  },
  {
    nama: "Recover",
    teks: {
      id: "Kehangatan air panas alami dan keramahan yang tulus memulihkan badan sekaligus pikiran.",
      en: "Embracing the natural warmth of our thermal springs and the comfort of genuine hospitality to restore both body and mind.",
    },
  },
  {
    nama: "Rejuvenate",
    teks: {
      id: "Anda pulang dengan tenaga baru, pikiran yang lebih jernih, dan kenangan yang bertahan lama setelah masa menginap usai.",
      en: "Leaving with renewed energy, clearer thoughts, and memories that continue long after your stay.",
    },
  },
];

const tripadvisor = ULASAN.find((u) => u.sumber === "Tripadvisor")!;
const gmaps = ULASAN.find((u) => u.sumber === "Google Maps")!;
/* Versi Inggris memakai format angka Inggris: 4.5 dan 9,902. */
const nilaiEn = (s: string) => s.replace(",", ".");
const jumlahEn = (s: string) => s.replace(/\./g, ",");
const WS = "Wilujeng\u00a0Sumping";

const judulSeksi = "judul-seksi";
const seksi = "seksi";
interface Props { lang: "id" | "en" }
const { lang } = Astro.props;
---

<Halaman
  lang={lang}
  path="/about/"
  og="/og/about.jpg"
  title={{ id: 'Tentang Kampung Sumber Alam, Resort Air Panas Sunda di Garut | Kampung Sumber Alam', en: 'About Kampung Sumber Alam, a Sundanese hot spring resort in Garut | Kampung Sumber Alam' }}
  description={{ id: 'Kampung Sumber Alam adalah resort bergaya kampung Sunda di Cipanas, Garut, yang mendirikan bungalownya di atas balong dan mengalirkan air panas alami Gunung Guntur ke setiap kamar.', en: 'Kampung Sumber Alam is a Sundanese village-style resort in Cipanas, Garut, with timber bungalows built over fish ponds and natural hot spring water from Mount Guntur in every room.' }}
  penanda={{id: "Tentang", en: "About"}}
  judul={{id: lekat("Kampung Sumber Alam adalah kampung Sunda di kaki Gunung Guntur"),
      en: lekat("Kampung Sumber Alam is a Sundanese village at the foot of Mount Guntur"),}}
  foto="/images/pandang-kolam.webp"
  w={1000}
  h={1250}
  alt="Tamu memandang kolam teratai dari dalam paviliun kayu"
>
    {/* ============ CERITA ============ */}
    <section class="pt-16 sm:pt-24">
      <div class={seksi}>
        <p class="penanda"><T id="Cerita" en="Our story" /></p>
        <h2 class={`${judulSeksi} mt-4 max-w-[24ch]`}>
          <T
            id="Bungalow berdiri di atas balong, sebutan orang Sunda untuk kolam ikan."
            en="The bungalows stand over the balong, the Sundanese word for a fish pond."
          />
        </h2>
        <div class="mt-7 max-w-[46ch] space-y-4 text-tinta-lembut">
          <p>
            <T
              id={lekat(`Sejak awal, ${NAMA} mendirikan bangunannya di atas balong agar kolam-kolam ikan itu tetap terpelihara. Warga sekitar masih memakai air balong tersebut untuk kolam ikan mereka, sehingga tim ${NAMA} memberi tahu warga lebih dulu setiap kali ada kolam yang akan dikuras. Jalan setapak menghubungkan satu bungalow dengan bungalow lain.`)}
              en={lekat(`From the start, ${NAMA} has built over the balong so that the fish ponds are kept. Neighbours still use water from these ponds for their own fish ponds, so the ${NAMA} team lets them know before any pond is drained. Footpaths link one bungalow to the next.`)}
            />
          </p>
          <p>
            <T
              id={rapiIsi(`Air panas di ${NAMA} berasal dari Gunung Guntur. Di kaki gunung itu, mata air panas sudah mengalir dari generasi ke generasi. Keran khusus di setiap kamar mandi mengalirkan air tersebut ke bak rendam, dan air panas yang sama mengisi Kolam Renang Tasik Madu di belakang Lobby serta bilik-bilik Kamar Rendam.`)}
              en={rapiIsi(`The natural hot water at ${NAMA} comes from Mount Guntur, where thermal springs have flowed at the foothills for generations. A dedicated tap in every bathroom runs it into the soaking tub, and the same hot water fills Kolam Renang Tasik Madu behind the Lobby and the private soaking rooms of Kamar Rendam.`)}
            />
          </p>
          <p>
            <T
              id={lekat(`${NAMA} menyebut dirinya Sundanese Thermal Escape Village, yaitu kampung Sunda tempat orang lari sejenak dari rutinitas kota untuk berendam air panas alami selama satu atau dua malam. Selepas berendam, tamu dapat makan di Restoran ${RESTORAN} di tepi kolam renang. ${SPA} menerima pesanan perawatan dari tamu yang menginap. Harga resmi untuk check-in hari Sabtu sudah termasuk makan malam, ${MUSIK}, dan paket pancingan, yaitu memancing di balong lalu ikannya dimasak oleh dapur ${NAMA}.`)}
              en={lekat(`${NAMA} calls itself a Sundanese Thermal Escape Village: a Sundanese village where people step away from city routine to soak in natural hot spring water for a night or two. After a soak, guests can dine at Restoran ${RESTORAN} beside the swimming pool. ${SPA} takes treatment bookings from staying guests. For a Saturday check-in, the official room rate already includes dinner, ${MUSIK} and a fishing package: you fish in the balong, and the ${NAMA} kitchen cooks your catch.`)}
            />
          </p>
        </div>
      </div>
    </section>

    {/* ============ TIGA PRINSIP ============ */}
    <section class="pt-16 sm:pt-24">
      <div class={seksi}>
        <div class="grid items-start gap-9 md:grid-cols-2 md:gap-14">
          <Gbr
            src="/images/kolam-teratai-duduk.webp"
            width="819"
            height="544"
            alt={altTeks("Tamu duduk di tepi kolam teratai yang rimbun", lang)}
            loading="lazy"
            decoding="async"
            class="h-auto w-full"
          />
          <div>
            <p class="penanda"><T id="Filosofi" en="Our philosophy" /></p>
            <h2 class={`${judulSeksi} mt-4 max-w-[20ch]`}>
              <T
                id={lekat("Tamu mengalami tiga tahap selama berada di Kampung Sumber Alam.")}
                en={lekat("Guests move through three stages during their stay at Kampung Sumber Alam.")}
              />
            </h2>
            <dl class="mt-8 border-t border-garis">
              {
                prinsip.map((p) => (
                  <div class="border-b border-garis py-5">
                    <dt class="pernyataan text-2xl text-hutan">{p.nama}</dt>
                    <dd class="mt-2 max-w-[46ch] text-tinta-lembut">
                      <T id={p.teks.id} en={p.teks.en} />
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </div>
    </section>

    {/* ============ KERAMAHAN SUNDA ============ */}
    <section class="pt-16 sm:pt-24">
      <div class={seksi}>
        <p class="penanda"><T id="Keramahan Sunda" en="Sundanese hospitality" /></p>
        <h2 class={`${judulSeksi} mt-4 max-w-[26ch]`}>
          <T
            id={`${WS} adalah ucapan selamat datang dalam bahasa Sunda.`}
            en={`${WS} is how Sundanese people say welcome.`}
          />
        </h2>
        <div class="mt-7 max-w-[46ch] space-y-4 text-tinta-lembut">
          <p>
            <T
              id={lekat(`Dalam budaya Sunda, keramahan ditunjukkan lewat ketulusan, kerendahan hati, dan kepedulian kepada sesama. Di ${NAMA}, tamu yang selesai berendam selama 25 menit di Kamar Rendam, bilik privat berisi air panas alami, mendapat bandrek atau bajigur, minuman hangat khas Sunda. Restoran ${RESTORAN} dan saung menyajikan menu Sunda untuk makan bersama, seperti Nasi Liwet 4 Orang dan Nasi Lulun Botram 4 Orang. Botram adalah tradisi Sunda makan bersama beralas daun pisang.`)}
              en={lekat(`In Sundanese culture, hospitality is expressed through sincerity, humility, and genuine care for others. At ${NAMA}, guests who finish a 25-minute soak in the Kamar Rendam, a private room filled with natural hot spring water, are given bandrek or bajigur, two warm Sundanese drinks. Restoran ${RESTORAN} and the saung serve Sundanese dishes for sharing, such as Nasi Liwet 4 Orang and Nasi Lulun Botram 4 Orang. Botram is the Sundanese custom of eating together from banana leaves.`)}
            />
          </p>
          <p>
            <T
              id={lekat(`Dari ${gmaps.jumlah} ulasan di Google Maps, ${NAMA} memperoleh nilai ${gmaps.nilai} dari ${gmaps.dari}. Di Tripadvisor, nilainya ${tripadvisor.nilai} dari ${tripadvisor.dari} berdasarkan ${tripadvisor.jumlah} ulasan. Tripadvisor juga memberinya penghargaan ${tripadvisor.catatan.id}.`)}
              en={lekat(`From ${jumlahEn(gmaps.jumlah)} reviews on Google Maps, ${NAMA} holds a rating of ${nilaiEn(gmaps.nilai)} out of ${gmaps.dari}. On Tripadvisor, it holds ${nilaiEn(tripadvisor.nilai)} out of ${tripadvisor.dari} from ${jumlahEn(tripadvisor.jumlah)} reviews. Tripadvisor has also given it the ${tripadvisor.catatan.en} award.`)}
            />
          </p>
        </div>
      </div>
    </section>

    {/* ============ KE DEPAN ============ */}
    <section class="pt-16 sm:pt-24">
      <div class={`${seksi} grid items-center gap-9 md:grid-cols-2 md:gap-14`}>
        <div>
          <p class="penanda"><T id="Ke depan" en="Looking ahead" /></p>
          <h2 class={`${judulSeksi} mt-4 max-w-[22ch]`}>
            <T
              id={lekat("Kampung Sumber Alam memegang empat batas dalam setiap rencana barunya.")}
              en={lekat("Kampung Sumber Alam holds every new plan to four limits.")}
            />
          </h2>
          <p class="mt-6 max-w-[46ch] text-tinta-lembut">
            <T
              id={lekat(`Visi ${NAMA} berbunyi “To become Indonesia's leading Sundanese Thermal Wellness Destination”, yaitu menjadi tujuan wisata wellness air panas bergaya Sunda yang terdepan di Indonesia. Selama mengejar visi itu, ${NAMA} menjaga air panas alami tetap menjadi inti dan suasananya tetap tenang, tidak terlalu ramai atau bising. Kegiatan tamu dipilih dengan cermat. ${NAMA} juga menghindari citra sebagai tempat rekreasi massal.`)}
              en={lekat(`The vision of ${NAMA} is “To become Indonesia's leading Sundanese Thermal Wellness Destination”. While pursuing it, the resort keeps natural hot spring water at the heart of every stay and the atmosphere calm, never too crowded or noisy. Guest activities are chosen with care. ${NAMA} also steers clear of becoming a mass-recreation venue.`)}
            />
          </p>
        </div>
        <Gbr
          src="/images/kacapi-suling.webp"
          width="819"
          height="544"
          alt={altTeks(`Pemusik berbusana Sunda membawakan ${MUSIK} di Kampung Sumber Alam`, lang)}
          loading="lazy"
          decoding="async"
          class="h-auto w-full md:order-first"
        />
      </div>
    </section>
  </Halaman>
