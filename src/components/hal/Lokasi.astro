---
import Halaman from "../../layouts/Halaman.astro";
import Gbr from "../Gbr.astro";

import T from "../T.astro";
import {
  ALAMAT,
  ALAMAT_SATU_BARIS,
  GEO,
  MAPS_URL,
  TELEPON,
  TELEPON_TAMPIL,
  TELEPON_ALT_TAMPIL,
  EMAIL,
  waLink,
} from "../../data/content";
import { lekat } from "../../data/rag";
import PetaPerjalanan from "../PetaPerjalanan.astro";

/* Halaman lokasi.
   ⚠️ Jarak dan waktu tempuh dari Bandung atau Jakarta SENGAJA TIDAK ditulis.
   Belum ada sumber yang mengukurnya, dan menaksir sendiri berarti mengarang
   angka yang dipakai orang untuk merencanakan perjalanan. Isi begitu sudah
   diukur, jangan sebelum itu.

   Gerbang, lajur, parkir, dan Lobby: Data Master KSA bab 02 §5.

   Peta tidak disematkan sebagai iframe. Satu sematan Google Maps menarik
   ratusan kilobita skrip pihak ketiga demi gambar yang berakhir diketuk
   sekali lalu ditinggalkan. Tautan langsung ke aplikasi peta lebih cepat
   dan itu memang yang dilakukan tamu. */

const judulSeksi = "judul-seksi";
const seksi = "seksi";
interface Props { lang: "id" | "en" }
const { lang } = Astro.props;
---

<Halaman
  lang={lang}
  path="/location/"
  og="/og/location.jpg"
  title={{ id: 'Lokasi dan Kontak di Cipanas Tarogong Kaler | Kampung Sumber Alam', en: 'Location and contact in Cipanas, Tarogong Kaler | Kampung Sumber Alam' }}
  description={{ id: 'Kampung Sumber Alam berada di Jl. Raya Cipanas No. 122, Tarogong Kaler, Garut, kawasan air panas Gunung Guntur. Halaman ini memuat nomor telepon, WhatsApp, dan tautan peta.', en: 'Kampung Sumber Alam is at Jl. Raya Cipanas No. 122, Tarogong Kaler, Garut, in the Mount Guntur hot spring area. This page lists the phone number, WhatsApp and a map link.' }}
  penanda={{id: "Lokasi", en: "Location"}}
  judul={{id: lekat("Anda tiba di Cipanas, kawasan air panas Gunung Guntur"),
      en: lekat("You arrive in Cipanas, the hot spring area of Mount Guntur"),}}
  foto="/images/kampung-pagi-berkabut.webp"
  w={1080}
  h={810}
  alt="Kabut pagi di atas kolam teratai dan deretan bungalow beratap ijuk"
>
    {/* ============ ALAMAT DAN KONTAK ============ */}
    <section class="pt-16 sm:pt-24">
      <div class={`${seksi} grid gap-10 md:grid-cols-2 md:gap-14`}>
        <div>
          <p class="penanda"><T id="Alamat" en="Address" /></p>
          <p class="font-display mt-4 max-w-[18ch] text-[clamp(1.35rem,4vw,2rem)] leading-tight font-medium">
            {ALAMAT.jalan}
          </p>
          <p class="mt-3 text-tinta-lembut">
            {ALAMAT.kecamatan}, {ALAMAT.kota}<br />
            {ALAMAT.provinsi} {ALAMAT.kodePos}
          </p>
          <p class="penanda mt-5 tabular-nums">{GEO.lat}, {GEO.lng}</p>
          <a
            href={MAPS_URL}
            rel="noopener"
            target="_blank"
            class="btn btn-isi mt-7"
          ><span class="btn-tx"><T id="Buka di Google Maps" en="Open in Google Maps" /></span>
          </a>
        </div>

        <div>
          <p class="penanda"><T id="Kontak" en="Contact" /></p>
          <dl class="mt-4 border-t border-garis">
            <div class="flex items-baseline justify-between gap-6 border-b border-garis py-4">
              <dt class="text-tinta-lembut"><T id="Telepon" en="Telephone" /></dt>
              <dd class="text-right">
                <a href={`tel:${TELEPON}`}>{TELEPON_TAMPIL}</a><br />
                <span class="text-tinta-lembut">{TELEPON_ALT_TAMPIL}</span>
              </dd>
            </div>
            <div class="flex items-baseline justify-between gap-6 border-b border-garis py-4">
              <dt class="text-tinta-lembut">WhatsApp</dt>
              <dd class="text-right">
                <a
                  href={waLink("Halo, saya mau tanya lokasi dan ketersediaan kamar di Kampung Sumber Alam.")}
                  rel="noopener"
                  target="_blank"
                  class="border-b border-hutan pb-0.5 text-hutan"
                >
                  <T id="Kirim pesan" en="Send a message" />
                </a>
              </dd>
            </div>
            <div class="flex items-baseline justify-between gap-6 border-b border-garis py-4">
              <dt class="text-tinta-lembut">Email</dt>
              <dd class="text-right break-all">
                <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
              </dd>
            </div>
          </dl>
          <p class="mt-6 max-w-[46ch] text-sm text-tinta-lembut">
            <T
              id="Cantumkan tanggal menginap pada pesan pertama agar tim reservasi dapat langsung memeriksa ketersediaan kamar."
              en="Include your dates in the first message so the reservations team can check availability straight away."
            />
          </p>
        </div>
      </div>
    </section>

    {/* ============ MENUJU LOKASI ============ */}
    <section class="pt-16 sm:pt-24">
      <div class={`${seksi} grid items-center gap-9 md:grid-cols-2 md:gap-14`}>
        <Gbr
          src="/images/taman-gunung.webp"
          width="819"
          height="544"
          alt="Taman dan kolam Kampung Sumber Alam dengan latar pegunungan Garut"
          loading="lazy"
          decoding="async"
          class="h-auto w-full"
        />
        <div>
          <p class="penanda"><T id="Menuju lokasi" en="Getting here" /></p>
          <h2 class={`${judulSeksi} mt-4 max-w-[28ch]`}>
            <T
              id={lekat("Gerbang Kampung Sumber Alam berada di Jalan\u00a0Raya\u00a0Cipanas nomor\u00a0122.")}
              en={lekat("The Kampung Sumber Alam gate is at number\u00a0122, Jalan\u00a0Raya\u00a0Cipanas.")}
            />
          </h2>
          <div class="mt-5 max-w-[46ch] space-y-4 text-tinta-lembut">
            <p>
              <T
                id={lekat("Cipanas adalah kawasan pemandian air panas di Tarogong Kaler, Garut, dan hotel serta pemandian air panas lain juga berada di Jalan\u00a0Raya\u00a0Cipanas. Gunakan nomor\u00a0122 sebagai patokan.")}
                en={lekat("Cipanas is the hot spring area of Tarogong Kaler, Garut, and other hotels and hot spring baths also stand on Jalan\u00a0Raya\u00a0Cipanas. Use number\u00a0122 as your landmark.")}
              />
            </p>
            <p>
              <T
                id={lekat("Gerbang utama berupa pergola kayu dengan satu pos satpam di tengahnya, yang membagi gerbang menjadi dua lajur. Kendaraan masuk melalui lajur barat dan keluar melalui lajur timur. Parkir di dalam kawasan gratis. Dari area parkir, Anda naik ke teras Lobby, bangunan berdinding bata merah dengan atap ijuk bertingkat, melalui tangga tengah atau ramp di sisi barat.")}
                en={lekat("The main gate is a timber pergola with a security post in the middle that splits it into two lanes. Cars enter through the west lane and leave through the east lane. Parking inside the grounds is free. From the car park, you walk up to the terrace of the Lobby, a red-brick building with a tiered thatched roof, by the central steps or the ramp on the west side.")}
              />
            </p>
          </div>
          <p class="penanda mt-7">{ALAMAT_SATU_BARIS}</p>
        </div>
      </div>
    </section>

    {/* ============ WAKTU TEMPUH KE SEKITAR (Data Master bab 02 §6) ============ */}
    <div class="pt-16 sm:pt-24"><PetaPerjalanan lang={lang} /></div>
  </Halaman>
