---
import { altTeks } from "../../data/alt-en";
import Halaman from "../../layouts/Halaman.astro";
import Gbr from "../Gbr.astro";

import T from "../T.astro";
import { RESTORAN, SPA, IG_URL, IG_HANDLE } from "../../data/content";
import { lekat } from "../../data/rag";

/* Galeri.
   Fotonya ditampilkan UTUH, tidak dipotong ke kotak seragam. Bentuk bangunan
   panggung dan bak rendam hilang begitu fotonya dipaksa masuk bingkai persegi,
   dan di halaman yang isinya cuma foto itu kerugian terbesar.

   Tata letaknya kolom CSS, bukan kisi. Kolom membiarkan tiap foto memakai
   tingginya sendiri tanpa satu baris pun JavaScript.

   Foto bakso dan soto dibuang (20 Nov 2026): kedua hidangan itu tidak ada di
   Menu Resto & Room Service (Data Master bab 06), dan src/assets tidak punya
   foto hidangan yang namanya tercantum di menu. */

const kelompok = [
  {
    penanda: { id: "Kampung", en: "The village" },
    judul: {
      id: "Kabut pagi turun di atas balong, dan lentera menyala di tepi kolam saat malam.",
      en: "Morning mist settles over the fish ponds, and lanterns glow by the water at night.",
    },
    foto: [
      { src: "/images/kampung-kolam-lotus.webp", w: 1200, h: 675, alt: "Bungalow beratap ijuk berdiri di seberang kolam teratai yang sedang berbunga" },
      { src: "/images/malam-lentera-tegak.webp", w: 1000, h: 1250, alt: "Lentera besar menyala di tepi kolam teratai pada malam hari" },
      { src: "/images/kampung-pagi-berkabut.webp", w: 1080, h: 810, alt: "Kabut pagi di atas kolam teratai dan deretan bungalow beratap ijuk" },
      { src: "/images/kampung-teratai.webp", w: 999, h: 756, alt: "Kolam teratai berbunga dengan bungalow beratap ijuk di belakangnya" },
      { src: "/images/pandang-kolam.webp", w: 1000, h: 1250, alt: "Tamu memandang kolam teratai dari dalam paviliun kayu" },
      { src: "/images/kampung-palem.webp", w: 819, h: 461, alt: "Bungalow beratap ijuk di antara pohon palem" },
      { src: "/images/taman-gunung.webp", w: 819, h: 544, alt: "Taman dan kolam Kampung Sumber Alam dengan latar pegunungan" },
      { src: "/images/gerbang-batu.webp", w: 819, h: 462, alt: "Gerbang batu menuju area bungalow Babakan Siluhur" },
      { src: "/images/taman-kampung.webp", w: 1200, h: 501, alt: "Taman terbuka dengan deretan pohon dan bangunan beratap ijuk" },
    ],
  },
  {
    penanda: { id: "Air panas", en: "Hot spring" },
    judul: {
      id: "Air panas alami Gunung Guntur mengisi bak rendam di kamar, private pool di villa, dan Kolam Renang Tasik Madu di belakang Lobby.",
      en: "Natural hot spring water from Mount Guntur fills the tubs in the rooms, the private pools in the villas and Kolam Renang Tasik Madu behind the Lobby.",
    },
    foto: [
      { src: "/images/air-panas-grotto.webp", w: 1600, h: 768, alt: "Kolam air panas berdinding batu menyerupai gua" },
      { src: "/images/bak-rendam.webp", w: 819, h: 544, alt: "Bak rendam air panas alami di dalam kamar dengan lilin di tepinya" },
      { src: "/images/grotto-privat.webp", w: 819, h: 546, alt: "Kolam air panas pribadi berdinding batu" },
      { src: "/images/kolam-privat-putih.webp", w: 1200, h: 675, alt: "Kolam pribadi berdinding putih di halaman villa" },
      { src: "/images/kolam-utama-tegak.webp", w: 675, h: 900, alt: "Kolam renang utama dilihat dari tepi" },
      { src: "/images/kolam-renang-utama.webp", w: 840, h: 460, alt: "Kolam renang utama beratap kanopi" },
      { src: "/images/kolam-utama.webp", w: 1100, h: 825, alt: "Kolam renang utama Kampung Sumber Alam pada siang hari" },
      { src: "/images/kolam-teratai-duduk.webp", w: 819, h: 544, alt: "Tamu duduk di tepi kolam teratai yang rimbun" },
      { src: "/images/halaman-kolam.webp", w: 1200, h: 560, alt: "Halaman berumput di tepi kolam dengan bungalow di kejauhan" },
    ],
  },
  {
    penanda: { id: "Kamar", en: "Rooms" },
    judul: {
      id: "Kamar berdinding kayu, sebagian dengan jendela yang menghadap balong.",
      en: "Rooms have timber walls, and some have windows facing the fish ponds.",
    },
    foto: [
      { src: "/images/bungalow-interior.webp", w: 900, h: 675, alt: "Interior bungalow kayu dengan tempat tidur dan jendela menghadap kolam" },
      { src: "/images/kamar-twin.webp", w: 1200, h: 675, alt: "Kamar dengan dua tempat tidur menghadap taman" },
      { src: "/images/suite-ranjang.webp", w: 900, h: 600, alt: "Kamar suite dengan tempat tidur besar dan dinding kayu" },
      { src: "/images/suite-gazebo.webp", w: 900, h: 600, alt: "Gazebo kayu di samping kolam pribadi suite" },
      { src: "/images/suite-kolam-senja.webp", w: 960, h: 640, alt: "Suite dengan kolam pribadi pada sore hari" },
    ],
  },
  {
    penanda: { id: "Makan", en: "Dining" },
    judul: {
      id: `Restoran ${RESTORAN} menyajikan menu Sunda di tepi kolam renang.`,
      en: `Restoran ${RESTORAN} serves Sundanese dishes beside the swimming pool.`,
    },
    foto: [
      { src: "/images/restoran-tunjung.webp", w: 819, h: 544, alt: `Ruang makan Restoran ${RESTORAN} berdinding kayu menghadap kolam` },
      { src: "/images/restoran-tegak.webp", w: 675, h: 900, alt: "Sudut restoran dengan meja kayu dan bukaan ke arah taman" },
    ],
  },
  {
    penanda: { id: "Di dalam kawasan", en: "On the grounds" },
    judul: {
      id: `${SPA} dan area bermain anak ada di dalam kawasan.`,
      en: `${SPA} and the children's play area are on the grounds.`,
    },
    foto: [
      { src: "/images/kacapi-suling.webp", w: 819, h: 544, alt: "Pemusik berbusana Sunda membawakan live music di Kampung Sumber Alam" },
      { src: "/images/pitaloka-spa.webp", w: 819, h: 546, alt: `Terapis memijat tamu di ${SPA}` },
      { src: "/images/spa-benda.webp", w: 800, h: 533, alt: "Perlengkapan pijat tertata di meja spa" },
      { src: "/images/bermain-anak.webp", w: 819, h: 544, alt: "Anak-anak bermain di area bermain Kampung Sumber Alam" },
      { src: "/images/keluarga-taman.webp", w: 819, h: 546, alt: "Keluarga duduk di bangku taman Kampung Sumber Alam" },
      { src: "/images/purba-dewata.webp", w: 819, h: 544, alt: "Ruang pertemuan Purba Dewata ditata dengan meja bundar berkain" },
    ],
  },
];

const judulSeksi = "judul-seksi";
const seksi = "seksi";
interface Props { lang: "id" | "en" }
const { lang } = Astro.props;
---

<Halaman
  lang={lang}
  path="/gallery/"
  og="/og/gallery.jpg"
  title={{ id: 'Galeri Foto Kampung Sumber Alam Garut | Kampung Sumber Alam', en: 'Photo gallery of Kampung Sumber Alam, Garut | Kampung Sumber Alam' }}
  description={{ id: 'Galeri ini memperlihatkan bungalow beratap ijuk di atas balong, bak rendam air panas alami, kolam renang, Restoran Tunjung Balebat, dan Pitaloka Spa di Kampung Sumber Alam, Garut.', en: 'This gallery shows the thatched bungalows over the fish ponds, natural hot spring tubs, the swimming pool, Restoran Tunjung Balebat and Pitaloka Spa at Kampung Sumber Alam, Garut.' }}
  penanda={{id: "Galeri", en: "Gallery"}}
  judul={{id: lekat("Inilah suasana Kampung Sumber Alam dari pagi sampai malam"),
      en: lekat("This is Kampung Sumber Alam, from morning to night"),}}
  foto="/images/kampung-kolam-lotus.webp"
  w={1200}
  h={675}
  alt="Bungalow beratap ijuk berdiri di seberang kolam teratai yang sedang berbunga"
>
    {
      kelompok.map((g) => (
        <section class="pt-16 sm:pt-24 cv">
          <div class={seksi}>
            <p class="penanda">
              <T id={g.penanda.id} en={g.penanda.en} />
            </p>
            <h2 class={`${judulSeksi} mt-4 max-w-[24ch]`}>
              <T id={lekat(g.judul.id)} en={lekat(g.judul.en)} />
            </h2>
          </div>
          {/* kelompok berfoto sedikit (Makan: dua foto sampai ada foto menu asli) memakai dua kolom
              selebar halaman, supaya kolom ketiga tidak bolong */}
          <div class={g.foto.length <= 2 ? `${seksi} mt-8 galeri-dua` : `${seksi} mt-8 columns-2 gap-3 lg:columns-3`}>
            {g.foto.map((f) => (
              <Gbr
                sizes={g.foto.length <= 2 ? "(min-width: 640px) 60vw, 100vw" : "(min-width: 1024px) 33vw, 50vw"}
                src={f.src}
                width={f.w}
                height={f.h}
                alt={altTeks(f.alt, lang)}
                loading="lazy"
                decoding="async"
                class={g.foto.length <= 2 ? "galeri-dua-foto" : "mb-3 h-auto w-full break-inside-avoid"}
              />
            ))}
          </div>
        </section>
      ))
    }

    <section class="pt-16 sm:pt-24">
      <div class={seksi}>
        <div class="max-w-[56ch] border-t border-garis pt-7">
          <p class="text-sm text-tinta-lembut">
            <T
              id={lekat("Foto terbaru Kampung Sumber Alam lebih dulu diunggah ke Instagram.")}
              en={lekat("The latest photos of Kampung Sumber Alam appear first on Instagram.")}
            />
          </p>
          <a
            href={IG_URL}
            rel="noopener"
            target="_blank"
            class="mt-3 inline-block border-b border-hutan pb-0.5 text-hutan"
          >
            {IG_HANDLE}
          </a>
        </div>
      </div>
    </section>
  </Halaman>
