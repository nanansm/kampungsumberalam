---
import Halaman from "../../layouts/Halaman.astro";
import Gbr from "../Gbr.astro";

import T from "../T.astro";
import { KAMAR, TERMASUK_KAMAR, THERMAL_RESET, BOOKING_URL, SIBENTANG_URL, waLink } from "../../data/content";
import { lekat } from "../../data/rag";

/* Halaman menginap. Beranda cuma mengelompokkan kamar menurut jumlah orang
   karena itu yang dipakai tamu untuk menyaring. Di sini urutannya menurut
   jenis bangunan, sebab tamu yang sampai halaman ini sudah tahu dia berapa
   orang dan sekarang mau tahu bentuk kamarnya.

   Harga = Publish Rate dari Data Master KSA (bab 03), ditulis "mulai" karena
   KSA memakai dynamic pricing. Harga di DIP bisa beda per tanggal.
   Halaman menampilkan 14 nama unit (bab 03 §1), jadi teks menyebut 14 tipe.
   Villa Sibentang ada di dalam kawasan (zona 21, ±130 m dari Lobby) dan
   tidak diberi harga di sini (bab 09 §9.3). */

/* Versi Inggris memakai format mata uang Inggris: Rp1,189,000. */
const rpEn = (s: string) => s.replace(/\./g, ",");

const kelompok = [
  {
    kunci: "bungalow" as const,
    penanda: { id: "Bungalow", en: "Bungalows" },
    judul: {
      id: "Kawung dan empat tipe bungalow menampung dua sampai empat orang per unit.",
      en: "Kawung and four bungalow types sleep two to four guests per unit.",
    },
    teks: {
      id: "Kawung, Pondok Kalapa, dan Bungalow 1-14 berjarak ±60 sampai ±100 m dari Lobby, dekat Kolam Renang Tasik Madu dan Kamar Rendam. Bungalow Siceeh berada di area belakang, ±250 m dari Lobby. Bungalow Arileu menampung empat orang. Lantai bawahnya berupa ruang lesehan.",
      en: "Kawung, Pondok Kalapa and Bungalow 1-14 are ±60 to ±100 m from the Lobby, close to Kolam Renang Tasik Madu and the Kamar Rendam. Bungalow Siceeh is in the rear area, ±250 m from the Lobby. Bungalow Arileu sleeps four. Its ground floor is a floor-seating lounge.",
    },
    foto: "/images/bungalow-interior.webp",
    w: 900,
    h: 675,
    alt: "Interior bungalow kayu dengan tempat tidur dan jendela menghadap kolam",
  },
  {
    kunci: "suite" as const,
    penanda: { id: "Suite", en: "Suites" },
    judul: {
      id: "Lima tipe suite memiliki private whirlpool atau private pool sendiri.",
      en: "Each of the five suite types has its own private whirlpool or private pool.",
    },
    teks: {
      id: "Suite Couple, Suite Room, Suite Arileu, dan Junior Suite menampung empat orang, dengan satu kamar privat di lantai bawah dan satu kamar terbuka di lantai atas. Deluxe Suite menampung enam orang dalam tiga kamar tidur privat dan dilengkapi private pool serta pendopo.",
      en: "Suite Couple, Suite Room, Suite Arileu and Junior Suite sleep four, with a private bedroom downstairs and an open bedroom upstairs. Deluxe Suite sleeps six in three private bedrooms and comes with a private pool and a pendopo, an open-sided pavilion.",
    },
    foto: "/images/suite-ranjang.webp",
    w: 900,
    h: 600,
    alt: "Kamar suite dengan tempat tidur besar dan dinding kayu",
  },
  {
    kunci: "rombongan" as const,
    penanda: { id: "Rombongan", en: "Groups" },
    judul: {
      id: "Babakan Siluhur menampung 12 sampai 18 orang dalam satu kompleks.",
      en: "Babakan Siluhur houses 12 to 18 guests in a single compound.",
    },
    teks: {
      id: "Babakan Siluhur 1 terdiri atas tiga bungalow untuk 18 orang, sedangkan Babakan Siluhur 2 terdiri atas dua bungalow berhadapan untuk 12 orang. Kedua kompleks berada di area belakang, ±250 m dari Lobby, dan dilengkapi private whirlpool, gazebo, serta pendopo. Keluarga besar dapat memesannya untuk Siluhur Private Escape, sedangkan kantor dapat memakainya untuk Siluhur Private Meeting.",
      en: "Babakan Siluhur 1 has three bungalows for 18 guests, and Babakan Siluhur 2 has two facing bungalows for 12. Both compounds sit in the rear area, ±250 m from the Lobby, with a private whirlpool, a gazebo and a pendopo. Extended families can book one for Siluhur Private Escape, and companies can use one for Siluhur Private Meeting.",
    },
    foto: "/images/grotto-privat.webp",
    w: 819,
    h: 546,
    alt: "Kolam air panas pribadi berdinding batu",
  },
];

const pendukung = [
  { foto: "/images/kamar-twin.webp", w: 1200, h: 675, alt: "Kamar dengan dua tempat tidur menghadap taman" },
  { foto: "/images/bak-rendam.webp", w: 819, h: 544, alt: "Bak rendam air panas alami di dalam kamar dengan lilin di tepinya" },
  { foto: "/images/suite-gazebo.webp", w: 900, h: 600, alt: "Gazebo kayu di samping kolam pribadi suite" },
  { foto: "/images/kolam-utama-tegak.webp", w: 675, h: 900, alt: "Kolam renang utama Kampung Sumber Alam dilihat dari tepi" },
];

const villa = KAMAR.filter((k) => k.kelompok === "villa");

const judulSeksi = "judul-seksi";
const seksi = "seksi";
interface Props { lang: "id" | "en" }
const { lang } = Astro.props;
---

<Halaman
  lang={lang}
  path="/accommodation/"
  og="/og/accommodation.jpg"
  title={{ id: 'Bungalow dan Suite Air Panas Alami di Garut | Kampung Sumber Alam', en: 'Bungalows and suites with natural hot spring water in Garut | Kampung Sumber Alam' }}
  description={{ id: 'Kampung Sumber Alam memiliki 14 tipe kamar untuk dua sampai 18 orang. Setiap kamar dilengkapi bak rendam berisi air panas alami Gunung Guntur.', en: 'Kampung Sumber Alam offers 14 room types for two to 18 guests. Every room has a soaking tub filled with natural hot spring water from Mount Guntur.' }}
  penanda={{id: "Menginap", en: "Stay"}}
  judul={{id: lekat("Anda dapat berendam air panas alami Gunung Guntur tanpa keluar kamar"),
      en: lekat("Soak in Mount Guntur's natural hot spring water without leaving your room"),}}
  foto="/images/menginap-balong.jpg"
  w={1600}
  h={1200}
  alt="Bungalow kayu beratap ijuk berdiri di atas balong berdaun teratai"
>
    {/* ============ PEMBUKA ============ */}
    <section class="pt-16 sm:pt-24">
      <div class={seksi}>
        <div class="max-w-[46ch] space-y-4 text-tinta-lembut">
          <p>
            <T
              id={lekat("Keran khusus di setiap kamar mandi mengalirkan air panas alami dari Gunung Guntur ke bak rendam. Anda dapat berendam pada malam hari, lalu berendam sekali lagi pada pagi hari sebelum check-out pukul\u00a012.00.")}
              en={lekat("A dedicated tap in every bathroom runs natural hot spring water from Mount Guntur into the soaking tub. You can soak at night, then once more in the morning before check-out at\u00a0noon.")}
            />
          </p>
          <p>
            <T
              id={lekat("Kampung Sumber Alam memiliki 80 kamar dalam 14 tipe. Satu pemesanan dapat menampung dua sampai 18 orang, dan jalan setapak di antara taman dan balong menghubungkan satu bungalow dengan bungalow lain. Villa Sibentang berada di kawasan yang sama dan memiliki situs sendiri.")}
              en={lekat("Kampung Sumber Alam has 80 rooms across 14 types. A single booking can hold two to 18 guests, and footpaths between gardens and fish ponds link one bungalow to the next. Villa Sibentang stands within the same grounds and has its own website.")}
            />
          </p>
        </div>
      </div>
    </section>

    {/* ============ PER KELOMPOK ============
        Foto dan daftar bergantian sisi. Foto ditampilkan utuh, tidak
        dipotong, supaya bentuk bangunannya kebaca. */}
    {
      kelompok.map((g, i) => {
        const isi = KAMAR.filter((k) => k.kelompok === g.kunci);
        return (
          <section class="pt-16 sm:pt-24">
            <div class={`${seksi} grid items-start gap-9 md:grid-cols-2 md:gap-14`}>
              <Gbr
                src={g.foto}
                width={g.w}
                height={g.h}
                alt={g.alt}
                loading="lazy"
                decoding="async"
                class={`h-auto w-full ${i % 2 === 1 ? "md:order-2" : ""}`}
              />
              <div>
                <p class="penanda"><T id={g.penanda.id} en={g.penanda.en} /></p>
                <h2 class={`${judulSeksi} mt-4`}>
                  <T id={lekat(g.judul.id)} en={lekat(g.judul.en)} />
                </h2>
                <p class="mt-5 max-w-[46ch] text-tinta-lembut">
                  <T id={lekat(g.teks.id)} en={lekat(g.teks.en)} />
                </p>

                <ul class="mt-9 border-t border-garis">
                  {isi.map((k) => (
                    <li class="border-b border-garis py-4">
                      <div class="flex items-baseline justify-between gap-4">
                        <h3 class="font-display text-lg font-medium">{k.nama}</h3>
                        <span class="penanda shrink-0">
                          <T id={`${k.pax} orang`} en={`${k.pax} guests`} />
                        </span>
                      </div>
                      <p class="mt-1 text-[0.9375rem]">
                        <span class="text-tinta-lembut">{k.kelas} · <T id={`${k.unit}\u00a0unit`} en={`${k.unit}\u00a0${k.unit === 1 ? "unit" : "units"}`} /> · </span>
                        <span class="tabular-nums"><T id={`mulai\u00a0Rp${k.harga.weekday}`} en={`from\u00a0Rp${rpEn(k.harga.weekday)}`} /></span>
                      </p>
                      {k.fakta.length > 0 && (
                        <p class="mt-1.5 text-[0.9375rem] text-tinta-lembut">
                          {k.fakta.map((f, j) => (
                            <>
                              {j > 0 && <span aria-hidden="true"> · </span>}
                              <T id={lekat(f.id)} en={lekat(f.en)} />
                            </>
                          ))}
                        </p>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </section>
        );
      })
    }

    {/* ============ FOTO PENDUKUNG ============ */}
    <section class="pt-16 sm:pt-24">
      <div class={`${seksi} grid grid-cols-2 gap-3 lg:grid-cols-4`}>
        {
          pendukung.map((p) => (
            <Gbr
              src={p.foto}
              width={p.w}
              height={p.h}
              alt={p.alt}
              loading="lazy"
              decoding="async"
              class="aspect-[3/4] w-full object-cover sm:aspect-[4/5]"
            />
          ))
        }
      </div>
    </section>

    {/* ============ VILLA SIBENTANG ============ */}
    <section class="pt-16 sm:pt-24">
      <div class={`${seksi} grid items-center gap-9 md:grid-cols-2 md:gap-14`}>
        <div>
          <p class="penanda"><T id="Villa" en="Villa" /></p>
          <h2 class={`${judulSeksi} mt-4`}>
            <T
              id={lekat("Setiap Villa Sibentang memiliki private pool berair panas alami di halamannya.")}
              en={lekat("Every Villa Sibentang has a private pool of natural hot spring water in its own yard.")}
            />
          </h2>
          <p class="mt-5 max-w-[46ch] text-tinta-lembut">
            <T
              id={lekat("Villa Sibentang terdiri atas empat villa satu kamar tidur (1 BR) dan lima villa dua kamar tidur (2 BR) di dalam kawasan Kampung Sumber Alam, ±130 m dari Lobby. Di villa inilah Sibentang Thermal Reset Journey berlangsung, rangkaian menginap wellness yang dirancang untuk pasangan.")}
              en={lekat("Villa Sibentang has four one-bedroom (1 BR) and five two-bedroom (2 BR) villas inside Kampung Sumber Alam, ±130 m from the Lobby. These villas host the Sibentang Thermal Reset Journey, a wellness stay designed for couples.")}
            />
          </p>
          <ul class="mt-8 border-t border-garis">
            {
              villa.map((k) => (
                <li class="border-b border-garis py-4">
                  <div class="flex items-baseline justify-between gap-4">
                    <h3 class="font-display text-lg font-medium">{k.nama}</h3>
                    <span class="penanda shrink-0">
                      <T id={`${k.pax} orang`} en={`${k.pax} guests`} />
                    </span>
                  </div>
                  <p class="mt-1 text-[0.9375rem]"><span class="text-tinta-lembut">{k.kelas} · <T id={`${k.unit}\u00a0villa`} en={`${k.unit}\u00a0villas`} /> · </span><T id={lekat("harga tersedia di situs Villa Sibentang")} en={lekat("rates on the Villa Sibentang website")} /></p>
                </li>
              ))
            }
          </ul>
          <p class="penanda mt-9">Sibentang Thermal Reset Journey</p>
          <ul class="mt-3 border-t border-garis">
            {THERMAL_RESET.map((r) => (
              <li class="border-b border-garis py-4">
                <div class="flex items-baseline justify-between gap-4">
                  <h3 class="font-display text-lg font-medium">{r.nama}</h3>
                  <span class="penanda shrink-0">{r.durasi}</span>
                </div>
                {/* arahan CD 20 Nov 2026: kata "sanctuary" tidak tampil di situs, jadi janji resmi yang memuatnya tidak ditampilkan */}
                {!/sanctuary/i.test(r.janji) && <p class="mt-1 max-w-[46ch] text-[0.9375rem] italic text-tinta-lembut">{r.janji}</p>}
                <p class="mt-1 max-w-[46ch] text-[0.9375rem] text-tinta-lembut"><T id={lekat(r.isi.id)} en={lekat(r.isi.en)} /></p>
              </li>
            ))}
          </ul>
          <a href={SIBENTANG_URL} rel="noopener" class="btn btn-sibentang mt-7"><span class="btn-tx"><T id="Buka situs Villa Sibentang" en="Open the Villa Sibentang site" /></span></a>
        </div>
        <Gbr
          src="/images/kolam-privat-putih.webp"
          width="1200"
          height="675"
          alt="Kolam air panas pribadi berdinding putih di halaman Villa Sibentang"
          loading="lazy"
          decoding="async"
          class="h-auto w-full md:order-first"
        />
      </div>
    </section>

    {/* ============ TARIF DAN PEMESANAN ============ */}
    <section class="pt-16 sm:pt-24">
      <div class={seksi}>
        <div class="border-t border-hutan pt-7">
          <p class="penanda"><T id="Tarif" en="Rates" /></p>
          <h2 class={`${judulSeksi} mt-4 max-w-[22ch]`}>
            <T
              id="Harga di atas berlaku untuk check-in Minggu sampai Jumat."
              en="Prices above apply to check-in from Sunday to Friday."
            />
          </h2>
          <p class="mt-5 max-w-[46ch] text-tinta-lembut">
            <T
              id="Harga tersebut adalah Publish Rate, yaitu harga resmi per kamar per malam yang sudah termasuk pajak dan pelayanan. Tarif harian dapat berbeda. Kampung Sumber Alam menyesuaikan tarif mengikuti tanggal, musim, dan ketersediaan kamar, sehingga angka pastinya baru tampil di halaman pemesanan setelah Anda memilih tanggal."
              en="These figures are the Publish Rate, the official price per room per night with tax and service included. Daily rates can differ. Kampung Sumber Alam adjusts them by date, season and room availability, so the exact figure only appears on the booking page once you choose your dates."
            />
          </p>
          <ul class="mt-5 max-w-[46ch] space-y-2 text-[0.9375rem] text-tinta-lembut">
            <li><T id={lekat(TERMASUK_KAMAR.weekday.id)} en={lekat(TERMASUK_KAMAR.weekday.en)} /></li>
            <li><T id={lekat(TERMASUK_KAMAR.weekend.id)} en={lekat(TERMASUK_KAMAR.weekend.en)} /></li>
          </ul>
          <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
            <a href={BOOKING_URL} rel="noopener" class="btn btn-isi"><span class="btn-tx"><T id="Cek kamar dan tanggal" en="Check rooms and dates" /></span></a>
            <a href={waLink("Halo, saya mau tanya ketersediaan kamar di Kampung Sumber Alam.")} rel="noopener" target="_blank" class="btn btn-wa"><span class="btn-tx"><T id="Tanyakan melalui WhatsApp" en="Ask on WhatsApp" /></span></a>
          </div>
        </div>
      </div>
    </section>
  </Halaman>
