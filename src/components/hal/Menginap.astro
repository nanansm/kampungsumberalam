---
import Halaman from "../../layouts/Halaman.astro";
import Gbr from "../Gbr.astro";

import T from "../T.astro";
import { KAMAR, TERMASUK_KAMAR, THERMAL_RESET, BOOKING_URL, SIBENTANG_URL, waLink } from "../../data/content";

/* Halaman menginap. Beranda cuma mengelompokkan kamar menurut jumlah orang
   karena itu yang dipakai tamu untuk menyaring. Di sini urutannya menurut
   jenis bangunan, sebab tamu yang sampai halaman ini sudah tahu dia berapa
   orang dan sekarang mau tahu bentuk kamarnya.

   Harga = Publish Rate dari Data Master KSA (bab 03), ditulis "mulai" karena
   KSA memakai dynamic pricing. Harga di DIP bisa beda per tanggal. */

const kelompok = [
  {
    kunci: "bungalow" as const,
    penanda: { id: "Bungalow", en: "Bungalows" },
    judul: {
      id: "Rumah kayu satu sampai dua lantai, berdiri di atas kolam.",
      en: "Timber houses of one or two storeys, standing over the ponds.",
    },
    teks: {
      id: "Lima tipe, 60 unit, semuanya beratap ijuk. Yang membedakan cuma jumlah lantai, jumlah orang, dan jarak jalan kaki ke lobi.",
      en: "Five types, 60 units, all thatched in palm fibre. What separates them is the number of storeys, the head count, and the walk back to the lobby.",
    },
    foto: "/images/bungalow-interior.webp",
    w: 900,
    h: 675,
    alt: "Interior bungalow kayu dengan tempat tidur dan jendela menghadap kolam",
  },
  {
    kunci: "suite" as const,
    penanda: { id: "Suite", en: "Suites" },
    judul: {
      id: "Lima tipe suite untuk yang mau berendam tanpa keluar kamar.",
      en: "Five suite types for guests who want to soak without leaving the room.",
    },
    teks: {
      id: "Suite Couple, Suite Room, Suite Arileu, dan Junior Suite punya private whirlpool, untuk empat orang. Deluxe Suite punya tiga kamar tidur, private pool, dan pendopo, untuk enam orang.",
      en: "Suite Couple, Suite Room, Suite Arileu and Junior Suite each have a private whirlpool and sleep four. The Deluxe Suite has three bedrooms, a private pool and a pendopo, and sleeps six.",
    },
    foto: "/images/suite-ranjang.webp",
    w: 900,
    h: 600,
    alt: "Kamar suite dengan tempat tidur besar dan dinding kayu",
  },
  {
    kunci: "rombongan" as const,
    penanda: { id: "Rombongan", en: "Groups" },
    judul: {
      id: "Babakan Siluhur, satu pemesanan untuk dua belas sampai delapan belas orang.",
      en: "Babakan Siluhur, one booking for twelve to eighteen people.",
    },
    teks: {
      id: "Dua penginapan yang berdiri terpisah dari blok kamar lain, masing-masing dengan kolam air panas sendiri. Dipakai rombongan keluarga besar dan kantor yang tidak mau berbagi kolam dengan tamu lain.",
      en: "Two lodgings set apart from the other room blocks, each with its own hot spring pool. Extended families and office groups take them when they would rather not share a pool with other guests.",
    },
    foto: "/images/grotto-privat.webp",
    w: 819,
    h: 546,
    alt: "Kolam air panas pribadi berdinding batu di Babakan Siluhur",
  },
];

const pendukung = [
  { foto: "/images/kamar-twin.webp", w: 1200, h: 675, alt: "Kamar dengan dua tempat tidur menghadap taman" },
  { foto: "/images/bak-rendam.webp", w: 819, h: 544, alt: "Bak rendam air panas alami di dalam kamar, ditemani lilin" },
  { foto: "/images/suite-gazebo.webp", w: 900, h: 600, alt: "Gazebo kayu di samping kolam pribadi suite" },
  { foto: "/images/kolam-utama-tegak.webp", w: 675, h: 900, alt: "Kolam renang utama Kampung Sumber Alam dilihat dari tepi" },
];

const villa = KAMAR.filter((k) => k.kelompok === "villa");

const judulSeksi = "judul-seksi";
const seksi = "seksi";
interface Props { lang: "id" | "en" }
const { lang } = Astro.props;
---

<Halaman
  lang={lang}
  path="/accommodation/"
  og="/og/accommodation.jpg"
  title={{ id: 'Bungalow dan Suite Air Panas Alami di Garut | Kampung Sumber Alam', en: 'Bungalows and suites with natural hot spring water in Garut | Kampung Sumber Alam' }}
  description={{ id: 'Empat belas tipe kamar di Kampung Sumber Alam, dari bungalow untuk berdua sampai Babakan Siluhur untuk delapan belas orang. Semuanya dialiri air panas alami Gunung Guntur.', en: 'Fourteen room types at Kampung Sumber Alam, from bungalows for two to Babakan Siluhur for eighteen. Every one runs on natural hot spring water from Mount Guntur.' }}
  penanda={{id: "Menginap", en: "Stay"}}
  judul={{id: "Empat belas tipe kamar, semuanya berair panas alami",
      en: "Fourteen room types, all on hot spring water",}}
  foto="/images/menginap-balong.jpg"
  w={1600}
  h={1200}
  alt="Bungalow kayu beratap ijuk berdiri di atas balong berdaun teratai"
>
    {/* ============ PEMBUKA ============ */}
    <section class="pt-16 sm:pt-24">
      <div class={seksi}>
        <div class="max-w-[56ch] space-y-4 text-tinta-lembut">
          <p>
            <T
              id="Tidak ada kamar yang cuma dapat air panas lewat kolam umum. Tiap unit punya bak rendam yang dialiri air panas alami dari Gunung Guntur, jadi berendam tidak perlu menunggu pagi."
              en="No room here gets its hot water only through a shared pool. Every unit has a soaking tub fed with natural hot spring water from Mount Guntur, so a soak never means waiting for morning."
            />
          </p>
          <p>
            <T
              id="Kapasitasnya mulai dari dua orang sampai delapan belas orang dalam satu pemesanan. Villa Sibentang dikelola manajemen yang sama tapi dijual di situsnya sendiri."
              en="Capacity runs from two people to eighteen under a single booking. Villa Sibentang is run by the same management but sold on its own site."
            />
          </p>
        </div>
      </div>
    </section>

    {/* ============ PER KELOMPOK ============
        Foto dan daftar bergantian sisi. Foto ditampilkan utuh, tidak
        dipotong, supaya bentuk bangunannya kebaca. */}
    {
      kelompok.map((g, i) => {
        const isi = KAMAR.filter((k) => k.kelompok === g.kunci);
        return (
          <section class="pt-16 sm:pt-24">
            <div class={`${seksi} grid items-start gap-9 md:grid-cols-2 md:gap-14`}>
              <Gbr
                src={g.foto}
                width={g.w}
                height={g.h}
                alt={g.alt}
                loading="lazy"
                decoding="async"
                class={`h-auto w-full ${i % 2 === 1 ? "md:order-2" : ""}`}
              />
              <div>
                <p class="penanda"><T id={g.penanda.id} en={g.penanda.en} /></p>
                <h2 class={`${judulSeksi} mt-4`}>
                  <T id={g.judul.id} en={g.judul.en} />
                </h2>
                <p class="mt-5 max-w-[52ch] text-tinta-lembut">
                  <T id={g.teks.id} en={g.teks.en} />
                </p>

                <ul class="mt-9 border-t border-garis">
                  {isi.map((k) => (
                    <li class="border-b border-garis py-4">
                      <div class="flex items-baseline justify-between gap-4">
                        <h3 class="font-display text-lg font-medium">{k.nama}</h3>
                        <span class="penanda shrink-0">
                          <T id={`${k.pax} orang`} en={`${k.pax} guests`} />
                        </span>
                      </div>
                      <p class="mt-1 text-[0.9375rem]">
                        <span class="text-tinta-lembut">{k.kelas} · {k.unit} unit · </span>
                        <span class="tabular-nums"><T id={`mulai Rp${k.harga.weekday}`} en={`from Rp${k.harga.weekday}`} /></span>
                      </p>
                      {k.fakta.length > 0 && (
                        <p class="mt-1.5 text-[0.9375rem] text-tinta-lembut">
                          {k.fakta.map((f, j) => (
                            <>
                              {j > 0 && <span aria-hidden="true"> · </span>}
                              <T id={f.id} en={f.en} />
                            </>
                          ))}
                        </p>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </section>
        );
      })
    }

    {/* ============ FOTO PENDUKUNG ============ */}
    <section class="pt-16 sm:pt-24">
      <div class={`${seksi} grid grid-cols-2 gap-3 lg:grid-cols-4`}>
        {
          pendukung.map((p) => (
            <Gbr
              src={p.foto}
              width={p.w}
              height={p.h}
              alt={p.alt}
              loading="lazy"
              decoding="async"
              class="aspect-[3/4] w-full object-cover sm:aspect-[4/5]"
            />
          ))
        }
      </div>
    </section>

    {/* ============ VILLA SIBENTANG ============ */}
    <section class="pt-16 sm:pt-24">
      <div class={`${seksi} grid items-center gap-9 md:grid-cols-2 md:gap-14`}>
        <div>
          <p class="penanda"><T id="Villa" en="Villa" /></p>
          <h2 class={`${judulSeksi} mt-4`}>
            <T
              id="Private Villa Sibentang berdiri di lahannya sendiri."
              en="Private Villa Sibentang sits on its own grounds."
            />
          </h2>
          <p class="mt-5 max-w-[52ch] text-tinta-lembut">
            <T
              id="Sembilan villa, satu kamar dan dua kamar, semuanya dengan private pool berair panas alami. Di villa ini KSA menjalankan Sibentang Thermal Reset Journey, rangkaian menginap untuk pasangan."
              en="Nine villas, one bedroom and two bedrooms, each with a private pool of natural hot spring water. This is where KSA runs the Sibentang Thermal Reset Journey, a stay designed for couples."
            />
          </p>
          <ul class="mt-8 border-t border-garis">
            {
              villa.map((k) => (
                <li class="border-b border-garis py-4">
                  <div class="flex items-baseline justify-between gap-4">
                    <h3 class="font-display text-lg font-medium">{k.nama}</h3>
                    <span class="penanda shrink-0">
                      <T id={`${k.pax} orang`} en={`${k.pax} guests`} />
                    </span>
                  </div>
                  <p class="mt-1 text-[0.9375rem]"><span class="text-tinta-lembut">{k.kelas} · {k.unit} villa · </span><T id="harga di situs Villa Sibentang" en="rates on the Villa Sibentang site" /></p>
                </li>
              ))
            }
          </ul>
          <p class="penanda mt-9">Sibentang Thermal Reset Journey</p>
          <ul class="mt-3 border-t border-garis">
            {THERMAL_RESET.map((r) => (
              <li class="border-b border-garis py-4">
                <div class="flex items-baseline justify-between gap-4">
                  <h3 class="font-display text-lg font-medium">{r.nama}</h3>
                  <span class="penanda shrink-0">{r.durasi}</span>
                </div>
                <p class="mt-1 text-[0.9375rem] italic text-tinta-lembut">{r.janji}</p>
                <p class="mt-1 text-[0.9375rem] text-tinta-lembut"><T id={r.isi.id} en={r.isi.en} /></p>
              </li>
            ))}
          </ul>
          <a href={SIBENTANG_URL} rel="noopener" class="btn btn-sibentang mt-7"><span class="btn-tx"><T id="Buka situs Villa Sibentang" en="Open the Villa Sibentang site" /></span></a>
        </div>
        <Gbr
          src="/images/kolam-privat-putih.webp"
          width="1200"
          height="675"
          alt="Kolam air panas pribadi berdinding putih di halaman Villa Sibentang"
          loading="lazy"
          decoding="async"
          class="h-auto w-full md:order-first"
        />
      </div>
    </section>

    {/* ============ TARIF DAN PEMESANAN ============ */}
    <section class="pt-16 sm:pt-24">
      <div class={seksi}>
        <div class="border-t border-hutan pt-7">
          <p class="penanda"><T id="Tarif" en="Rates" /></p>
          <h2 class={`${judulSeksi} mt-4 max-w-[22ch]`}>
            <T
              id="Harga di atas adalah harga weekday. Isinya beda untuk weekday dan weekend."
              en="Prices above are weekday rates. What is included differs on weekdays and weekends."
            />
          </h2>
          <p class="mt-5 max-w-[54ch] text-tinta-lembut">
            <T
              id="Harga resmi (Publish Rate) per kamar per malam, sudah termasuk pajak dan pelayanan. Harga mengikuti tanggal, jadi angka pasti muncul di halaman pemesanan setelah tanggal dipilih."
              en="Official prices (Publish Rate) per room per night, tax and service included. Prices follow the date, so the exact figure appears on the booking page once dates are picked."
            />
          </p>
          <ul class="mt-5 max-w-[60ch] space-y-2 text-[0.9375rem] text-tinta-lembut">
            <li><T id={TERMASUK_KAMAR.weekday.id} en={TERMASUK_KAMAR.weekday.en} /></li>
            <li><T id={TERMASUK_KAMAR.weekend.id} en={TERMASUK_KAMAR.weekend.en} /></li>
          </ul>
          <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
            <a href={BOOKING_URL} rel="noopener" class="btn btn-isi"><span class="btn-tx"><T id="Cek kamar dan tanggal" en="Check rooms and dates" /></span></a>
            <a href={waLink("Halo, saya mau tanya ketersediaan kamar di Kampung Sumber Alam.")} rel="noopener" target="_blank" class="btn btn-wa"><span class="btn-tx"><T id="Tanya lewat WhatsApp" en="Ask on WhatsApp" /></span></a>
          </div>
        </div>
      </div>
    </section>
  </Halaman>
