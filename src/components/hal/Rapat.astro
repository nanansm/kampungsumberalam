---
import { altTeks } from "../../data/alt-en";
import Halaman from "../../layouts/Halaman.astro";
import Gbr from "../Gbr.astro";

import T from "../T.astro";
import {
  RUANG_MICE,
  TARIF_FULLBOARD,
  TARIF_OUTING,
  PAKET_TANPA_MENGINAP,
  TERMASUK_SEMUA,
  TERMASUK_MEETING,
  TERMASUK_OUTING,
  KAMAR,
  waLink,
} from "../../data/content";
import { lekat } from "../../data/rag";

/* Halaman rapat, outing, dan family gathering.
   Beranda sengaja cuma menyebut titik masuk termurah. Tabel tarif penuh
   tempatnya di sini, sebab tamu yang membuka halaman ini sudah menyusun
   anggaran dan justru butuh membandingkan baris per baris.

   Sumber angka: Data Master KSA bab 05 (Catalog KSA hlm 21–25).
   Nama susunan ruang mengikuti Data Master: Theatre, Classroom, U-Shape,
   Round Table. ⚠️ Catatan konfirmasi ulang di bawah wajib ada. */

/* Versi Inggris memakai format mata uang Inggris: Rp1,433,000. */
const rpEn = (s: string) => s.replace(/\./g, ",");

const rombongan = KAMAR.filter((k) => k.kelompok === "rombongan");

const judulSeksi = "judul-seksi";
const seksi = "seksi";
interface Props { lang: "id" | "en" }
const { lang } = Astro.props;
---

<Halaman
  lang={lang}
  path="/meetings/"
  og="/og/meetings.jpg"
  title={{ id: 'Paket Fullboard Meeting dan Outing di Garut | Kampung Sumber Alam', en: 'Fullboard meeting and outing packages in Garut | Kampung Sumber Alam' }}
  description={{ id: 'Kampung Sumber Alam di Garut memiliki tiga ruang meeting untuk 15 sampai 350 orang. Fullboard Meeting mulai Rp1.143.000 per orang sudah termasuk menginap, tiga kali makan, pajak, dan pelayanan.', en: 'Kampung Sumber Alam in Garut has three meeting rooms for 15 to 350 people. Fullboard Meeting starts from Rp1,143,000 per person, including the stay, three meals, tax and service.' }}
  penanda={{id: "Rapat dan outing", en: "Meetings and outings"}}
  judul={{id: lekat("Rapat selesai, rombongan berendam lalu makan bersama"),
      en: lekat("After the meeting, the group soaks and then dines together"),}}
  foto="/images/kampung-kolam-teratai.webp"
  w={1600}
  h={768}
  alt="Bungalow beratap ijuk berdiri di atas kolam teratai dengan pegunungan Garut di kejauhan"
>
    {/* ============ PEMBUKA ============ */}
    <section class="pt-16 sm:pt-24">
      <div class={`${seksi} grid items-start gap-9 md:grid-cols-2 md:gap-14`}>
        <div class="max-w-[46ch] space-y-4 text-tinta-lembut">
          <p>
            <T
              id={lekat("Setelah sesi rapat selesai, peserta dapat berendam air panas alami Gunung Guntur di bak kamar masing-masing, lalu berkumpul lagi untuk makan malam bersama yang sudah termasuk dalam paket. Paket menginap rombongan juga sudah mencakup tiket Kolam Renang Tasik Madu dan Kamar Rendam.")}
              en={lekat("When the session ends, participants can soak in Mount Guntur's natural hot spring water in their own room tubs, then gather again for the dinner included in the package. The overnight group packages also include access to Kolam Renang Tasik Madu and the Kamar Rendam.")}
            />
          </p>
          <p>
            <T
              id={lekat("Kampung Sumber Alam menyediakan dua paket menginap untuk rombongan. Fullboard Meeting ditujukan untuk rapat dan sudah termasuk ruang pertemuan beserta perlengkapannya, sedangkan Outing Family Gathering ditujukan untuk kantor yang mengajak keluarga karyawan dan dilengkapi fun games serta entertainment malam pukul 18.30–22.00.")}
              en={lekat("Kampung Sumber Alam offers two overnight packages for groups. Fullboard Meeting is built for meetings and includes the meeting room and its equipment, while Outing Family Gathering suits companies that bring employees' families and comes with fun games and evening entertainment from 6:30 to 10 pm.")}
            />
          </p>
        </div>
        <Gbr
          src="/images/purba-dewata.webp"
          width="819"
          height="544"
          alt={altTeks("Ruang pertemuan Purba Dewata ditata dengan meja bundar berkain", lang)}
          loading="lazy"
          decoding="async"
          class="h-auto w-full"
        />
      </div>
    </section>

    {/* ============ TARIF ============ */}
    <section class="pt-16 sm:pt-24">
      <div class={seksi}>
        <p class="penanda"><T id="Tarif per orang" en="Rate per person" /></p>
        <h2 class={`${judulSeksi} mt-4 max-w-[24ch]`}>
          <T
            id="Tarif per orang semakin rendah jika lebih banyak peserta berbagi satu kamar."
            en="The more participants share a room, the lower the rate per person."
          />
        </h2>

        <div class="mt-9 grid gap-10 lg:grid-cols-2">
          {[
            { nama: "Fullboard Meeting", data: TARIF_FULLBOARD },
            { nama: "Outing Family Gathering", data: TARIF_OUTING },
          ].map((tb) => (
            <div>
              <h3 class="font-display text-lg font-medium">{tb.nama}</h3>
              <table class="mt-3 w-full border-collapse text-left text-[0.9375rem]">
                <thead>
                  <tr class="border-b border-tinta">
                    <th class="penanda py-3 pr-3 text-tinta"><T id="Okupansi" en="Occupancy" /></th>
                    <th class="penanda py-3 pr-3 text-tinta">Weekday</th>
                    <th class="penanda py-3 text-tinta">Weekend</th>
                  </tr>
                </thead>
                <tbody>
                  {tb.data.map((t) => (
                    <tr class="border-b border-garis">
                      <td class="py-3.5 pr-3"><T id={t.isi.id} en={t.isi.en} /></td>
                      <td class="py-3.5 pr-3 tabular-nums"><T id={`Rp${t.weekday}`} en={`Rp${rpEn(t.weekday)}`} /></td>
                      <td class="py-3.5 text-tinta-lembut tabular-nums"><T id={`Rp${t.weekend}`} en={`Rp${rpEn(t.weekend)}`} /></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
        </div>

        <div class="mt-11 grid gap-8 sm:grid-cols-3 sm:gap-10">
          <div>
            <p class="penanda"><T id="Termasuk dalam kedua paket" en="Included in both packages" /></p>
            <ul class="mt-3 space-y-1.5 text-[0.9375rem] text-tinta-lembut">
              {TERMASUK_SEMUA.map((x) => <li><T id={lekat(x.id)} en={lekat(x.en)} /></li>)}
            </ul>
          </div>
          <div>
            <p class="penanda"><T id="Tambahan Fullboard Meeting" en="Fullboard Meeting adds" /></p>
            <ul class="mt-3 space-y-1.5 text-[0.9375rem] text-tinta-lembut">
              {TERMASUK_MEETING.map((x) => <li><T id={lekat(x.id)} en={lekat(x.en)} /></li>)}
            </ul>
          </div>
          <div>
            <p class="penanda"><T id="Tambahan Outing Family Gathering" en="Outing Family Gathering adds" /></p>
            <ul class="mt-3 space-y-1.5 text-[0.9375rem] text-tinta-lembut">
              {TERMASUK_OUTING.map((x) => <li><T id={lekat(x.id)} en={lekat(x.en)} /></li>)}
            </ul>
          </div>
        </div>

        <p class="mt-9 max-w-[46ch] text-sm text-tinta-lembut">
          <T
            id={lekat("Tarif berlaku per orang dan dikonfirmasi ulang saat pemesanan. Tim reservasi mengirimkan rincian sesuai jumlah peserta, termasuk kebutuhan kamar dan susunan acara, melalui WhatsApp.")}
            en={lekat("Rates are per person and are reconfirmed at booking. The reservations team sends a breakdown by group size, including room needs and the event schedule, via WhatsApp.")}
          />
        </p>
      </div>
    </section>

    {/* ============ RUANG ============ */}
    <section class="pt-16 sm:pt-24">
      <div class={seksi}>
        <p class="penanda"><T id="Kapasitas ruang" en="Room capacity" /></p>
        <h2 class={`${judulSeksi} mt-4 max-w-[26ch]`}>
          <T
            id={lekat("Purba Dewata dan Intan Dewata dapat dipakai utuh atau dibagi dua.")}
            en={lekat("Purba Dewata and Intan Dewata can be used whole or split in two.")}
          />
        </h2>
        <p class="mt-5 max-w-[46ch] text-tinta-lembut">
          <T
            id={lekat("Purba Dewata berada di gedung besar di tengah kawasan, satu bangunan dengan Restoran Ligar Wangi. Saat dipakai utuh, ruang ini menampung hingga 350 orang dengan susunan theatre. Intan Dewata berada di sisi kolam renang. Gambir Wangi, ruang yang paling kecil, hanya memakai susunan round table untuk 15 orang.")}
            en={lekat("Purba Dewata is in the large building at the centre of the grounds, shared with Restoran Ligar Wangi. Used whole, it seats up to 350 people in theatre style. Intan Dewata sits beside the swimming pool. Gambir Wangi, the smallest room, takes only a round table for 15 people.")}
          />
        </p>

        <table class="mt-9 w-full border-collapse text-left text-[0.9375rem]">
          <thead>
            <tr class="border-b border-tinta">
              <th class="penanda py-3 pr-3 text-tinta"><T id="Ruang" en="Room" /></th>
              <th class="penanda py-3 pr-3 text-tinta">Theatre</th>
              <th class="penanda py-3 pr-3 text-tinta">Classroom</th>
              <th class="penanda hidden py-3 pr-3 text-tinta sm:table-cell">U-Shape</th>
              <th class="penanda py-3 text-tinta">Round Table</th>
            </tr>
          </thead>
          <tbody>
            {
              RUANG_MICE.map((r) => (
                <tr class="border-b border-garis">
                  <td class="py-3.5 pr-3">{r.nama}</td>
                  <td class="py-3.5 pr-3 text-tinta-lembut tabular-nums">{r.theater === "tanya" ? "*" : (r.theater ?? "-")}</td>
                  <td class="py-3.5 pr-3 text-tinta-lembut tabular-nums">{r.kelas === "tanya" ? "*" : (r.kelas ?? "-")}</td>
                  <td class="hidden py-3.5 pr-3 text-tinta-lembut tabular-nums sm:table-cell">
                    {r.uShape === "tanya" ? "*" : (r.uShape ?? "-")}
                  </td>
                  <td class="py-3.5 text-tinta-lembut tabular-nums">{r.bundar === "tanya" ? "*" : (r.bundar ?? "-")}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="mt-3 max-w-[46ch] text-sm text-tinta-lembut">
          <T
            id="Kolom U-Shape tampil di layar lebar. Tanda * berarti kapasitas ruang perlu ditanyakan kepada tim reservasi, sedangkan tanda - berarti susunan tersebut tidak tersedia di ruang itu."
            en="The U-Shape column appears on wider screens. * means please ask the reservations team for the capacity, and - means that layout is not available in the room."
          />
        </p>
      </div>
    </section>

    {/* ============ MENGINAP ROMBONGAN ============ */}
    <section class="pt-16 sm:pt-24">
      <div class={`${seksi} grid items-center gap-9 md:grid-cols-2 md:gap-14`}>
        <Gbr
          src="/images/gerbang-batu.webp"
          width="819"
          height="462"
          alt={altTeks("Gerbang batu menuju area penginapan Babakan Siluhur", lang)}
          loading="lazy"
          decoding="async"
          class="h-auto w-full"
        />
        <div>
          <p class="penanda"><T id="Menginap rombongan" en="Group lodging" /></p>
          <h2 class={`${judulSeksi} mt-4 max-w-[22ch]`}>
            <T
              id={lekat("Babakan Siluhur menampung satu rombongan dalam satu kompleks.")}
              en={lekat("Babakan Siluhur keeps one group together in a single compound.")}
            />
          </h2>
          <ul class="mt-8 border-t border-garis">
            {
              rombongan.map((k) => (
                <li class="border-b border-garis py-4">
                  <div class="flex items-baseline justify-between gap-4">
                    <h3 class="font-display text-lg font-medium">{k.nama}</h3>
                    <span class="penanda shrink-0">
                      <T id={`${k.pax} orang`} en={`${k.pax} guests`} />
                    </span>
                  </div>
                  <p class="mt-1 text-[0.9375rem] tabular-nums"><T id={`Rp${k.harga.weekday}\u00a0weekday · Rp${k.harga.weekend}\u00a0weekend`} en={`Rp${rpEn(k.harga.weekday)}\u00a0weekday · Rp${rpEn(k.harga.weekend)}\u00a0weekend`} /></p>
                  <p class="mt-1.5 text-[0.9375rem] text-tinta-lembut">
                    {k.fakta.map((f, j) => (
                      <>
                        {j > 0 && <span aria-hidden="true"> · </span>}
                        <T id={lekat(f.id)} en={lekat(f.en)} />
                      </>
                    ))}
                  </p>
                </li>
              ))
            }
          </ul>
          <p class="mt-6 max-w-[46ch] text-tinta-lembut">
            <T
              id={lekat("Tim kecil dapat rapat dan menginap di kompleks Babakan Siluhur sendiri, lengkap dengan gazebo, pendopo, dan private whirlpool.")}
              en={lekat("A small team can meet and stay in its own Babakan Siluhur compound, complete with a gazebo, a pendopo and a private whirlpool.")}
            />
          </p>
        </div>
      </div>
    </section>

    {/* ============ TANPA MENGINAP ============ */}
    <section class="pt-16 sm:pt-24">
      <div class={seksi}>
        <p class="penanda"><T id="Tanpa menginap dan kelompok kecil" en="Day packages and small groups" /></p>
        <h2 class={`${judulSeksi} mt-4 max-w-[26ch]`}>
          <T id="Non Residental Meeting dan Fullday Gathering melayani rombongan yang tidak menginap." en="Non Residental Meeting and Fullday Gathering serve groups that are not staying overnight." />
        </h2>
        <ul class="mt-9 grid gap-x-10 border-t border-garis md:grid-cols-3">
          {PAKET_TANPA_MENGINAP.map((p) => (
            <li class="border-b border-garis py-5">
              <h3 class="font-display text-lg font-medium">{p.nama}</h3>
              <p class="mt-1 text-[0.9375rem] tabular-nums"><T id={p.harga.id} en={p.harga.en} /></p>
              <p class="mt-2 text-[0.9375rem] text-tinta-lembut"><T id={lekat(p.isi.id)} en={lekat(p.isi.en)} /></p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ============ AJAKAN ============ */}
    <section class="pt-16 sm:pt-24">
      <div class={seksi}>
        <div class="max-w-[64ch] border-t border-hutan pt-7">
          <p class="penanda"><T id="Langkah berikutnya" en="Next step" /></p>
          <p class="mt-4 max-w-[46ch] text-tinta-lembut">
            <T
              id="Kirimkan tanggal acara, jumlah peserta, dan jenis kegiatan, misalnya rapat atau outing, agar tim reservasi dapat langsung menyusun penawaran beserta pembagian kamarnya."
              en="Send the event dates, the number of participants and the type of event, such as a meeting or an outing, so the reservations team can prepare a quotation and the room allocation straight away."
            />
          </p>
          <a
            href={waLink("Halo, saya mau tanya paket rapat dan gathering di Kampung Sumber Alam.")}
            rel="noopener"
            target="_blank"
            class="btn btn-isi btn-wa mt-8"
          ><span class="btn-tx"><T id="Minta penawaran melalui WhatsApp" en="Request a quotation on WhatsApp" /></span>
          </a>
        </div>
      </div>
    </section>
  </Halaman>
