---
import { altTeks } from "../../data/alt-en";
import Halaman from "../../layouts/Halaman.astro";
import Gbr from "../Gbr.astro";

import T from "../T.astro";
import { ACARA, RUANG_MICE, waLink } from "../../data/content";
import { lekat } from "../../data/rag";

/* Halaman acara dan perayaan.
   Angkanya ditayangkan penuh, beda dengan tarif kamar. Alasannya paket acara
   itu keputusan yang direncanakan berminggu-minggu dan orang membandingkan
   penawaran sebelum menghubungi siapa pun. Menyembunyikan angka di halaman
   ini berarti kalah sebelum ditanya.

   Tarifnya dari flyer resmi KSA 2026 (Data Master bab 05 §5–6, bab 07).
   Flyer tidak bertanggal masa berlaku. Catatan konfirmasi ulang di bawah
   WAJIB tetap ada. Harga dan satuannya tidak boleh terpisah di akhir baris. */

/* Versi Inggris memakai format mata uang Inggris: Rp180,000. */
const rpEn = (s: string) => s.replace(/\./g, ",");

const terbesar = RUANG_MICE[0];

const judulSeksi = "judul-seksi";
const seksi = "seksi";
interface Props { lang: "id" | "en" }
const { lang } = Astro.props;
---

<Halaman
  lang={lang}
  path="/events/"
  og="/og/events.jpg"
  title={{ id: 'Paket Pernikahan, Ulang Tahun, dan Acara di Garut | Kampung Sumber Alam', en: 'Weddings, birthdays and event packages in Garut | Kampung Sumber Alam' }}
  description={{ id: 'Kampung Sumber Alam di Garut menawarkan sembilan pilihan paket acara, termasuk Engagement Package mulai Rp180.000 per orang, Akad Package mulai Rp205.000 per orang, dan Pre Wedding Package Rp800.000 per paket.', en: 'Kampung Sumber Alam in Garut offers nine event package options, including Engagement Package from Rp180,000 per person, Akad Package from Rp205,000 per person and Pre Wedding Package at Rp800,000 per package.' }}
  penanda={{id: "Acara dan perayaan", en: "Events"}}
  judul={{id: lekat("Keluarga berkumpul untuk lamaran, akad, dan ulang tahun"),
      en: lekat("Families gather for engagements, weddings and birthdays"),}}
  foto="/images/taman-kampung.webp"
  w={1200}
  h={501}
  alt="Taman terbuka Kampung Sumber Alam dengan deretan pohon dan bangunan beratap ijuk"
>
    {/* ============ PEMBUKA ============ */}
    <section class="pt-16 sm:pt-24">
      <div class={seksi}>
        <div class="max-w-[46ch] space-y-4 text-tinta-lembut">
          <p>
            <T
              id={lekat(`Engagement Package, Akad Package, dan Intimate Wedding Package dapat digelar di ruang pertemuan Intan Dewata atau Purba Dewata, maupun di restoran Kampung Sumber Alam. Ruang terbesar, ${terbesar.nama}, menampung ${terbesar.theater} orang dengan susunan theatre.`)}
              en={lekat(`Engagement Package, Akad Package and Intimate Wedding Package can be held in the Intan Dewata or Purba Dewata meeting rooms, or in a Kampung Sumber Alam restaurant. The largest room, ${terbesar.nama}, seats ${terbesar.theater} people in theatre style.`)}
            />
          </p>
          <p>
            <T
              id={lekat("Social Event at Private Villa Sibentang dan Swimming at Private Villa Sibentang memakai private pool berair panas alami di halaman villa tanpa perlu menginap, dengan pemesanan minimal enam orang. Pre Wedding Package Paket 2 juga memberi akses ke Private Villa Sibentang.")}
              en={lekat("Social Event at Private Villa Sibentang and Swimming at Private Villa Sibentang use the villa's private pool of natural hot spring water with no overnight stay required, for a minimum of six guests. Pre Wedding Package Paket 2 also includes access to Private Villa Sibentang.")}
            />
          </p>
        </div>
      </div>
    </section>

    {/* ============ KARTU PAKET ============
        Ukuran fotonya diseragamkan lewat object-cover supaya tepi bawah
        kartu sejajar di satu baris. Foto utuh dipakai di bagian editorial,
        bukan di kisi kartu. */}
    <section class="pt-12 sm:pt-16">
      <div class={`${seksi} grid gap-x-7 gap-y-12 sm:grid-cols-2 lg:grid-cols-3`}>
        {
          ACARA.map((a) => (
            <article class="flex flex-col">
              <Gbr
                src={a.foto}
                width={a.w}
                height={a.h}
                alt={altTeks(a.alt, lang)}
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full object-cover"
              />

              <h2 class="font-display mt-5 text-xl font-medium">
                <T id={a.nama.id} en={a.nama.en} />
              </h2>

              {/* label harga di barisnya sendiri; harga dan satuannya satu baris dengan ukuran sejajar,
                  supaya tidak terbaca sebagai baris timpang (rag putaran 2) */}
              <p class="penanda mt-3">
                {a.satuan === "orang" ? <T id="Mulai" en="From" /> : <T id="Harga paket" en="Package price" />}
              </p>
              <p class="harga-acara"><span class="font-display text-3xl font-medium text-hutan"><T id={`Rp${a.harga}`} en={`Rp${rpEn(a.harga)}`} /></span>{a.satuan === "orang" && (<span class="text-tinta-lembut">{"\u00a0"}<T id={"per\u00a0orang"} en={"per\u00a0person"} /></span>)}</p>

              {a.minimal !== null && (
                <p class="penanda mt-2">
                  <T id={`Minimal ${a.minimal}\u00a0orang`} en={`Minimum ${a.minimal}\u00a0guests`} />
                </p>
              )}

              <ul class="mt-5 space-y-1.5 text-[0.9375rem] text-tinta-lembut">
                {a.termasuk.map((t) => (
                  <li>
                    <T id={lekat(t.id)} en={lekat(t.en)} />
                  </li>
                ))}
              </ul>

              {a.tambahan.length > 0 && (
                <p class="mt-4 text-[0.9375rem] text-tinta-lembut">
                  <span class="penanda">
                    <T id="Tambahan berbayar" en="Paid extras" />
                  </span>
                  <br />
                  {a.tambahan.map((t, j) => (
                    <>
                      {j > 0 && <span aria-hidden="true"> · </span>}
                      <T id={lekat(t.id)} en={lekat(t.en)} />
                    </>
                  ))}
                </p>
              )}

              {a.catatan && (
                <p class="mt-4 text-sm text-tinta-lembut">
                  <T id={lekat(a.catatan.id)} en={lekat(a.catatan.en)} />
                </p>
              )}

              <a
                href={waLink(`Halo, saya mau tanya paket ${a.nama.id} di Kampung Sumber Alam.`)}
                rel="noopener"
                target="_blank"
                class="mt-auto inline-block self-start border-b border-hutan pt-6 pb-0.5 text-hutan"
              >
                <T id="Tanyakan paket ini" en="Ask about this package" />
              </a>
            </article>
          ))
        }
      </div>
    </section>

    {/* ============ CATATAN TARIF ============ */}
    <section class="pt-16 sm:pt-24">
      <div class={seksi}>
        <div class="max-w-[64ch] border-t border-hutan pt-7">
          <p class="penanda"><T id="Sebelum menghitung anggaran" en="Before you budget" /></p>
          <p class="mt-4 max-w-[46ch] text-tinta-lembut">
            <T
              id={lekat("Harga di atas dikonfirmasi ulang saat pemesanan. Syarat dan ketentuan berlaku. Total biaya dapat berubah mengikuti tanggal acara, jumlah tamu, dan tambahan berbayar seperti dekorasi, MC, atau foto yang belum termasuk dalam paket. Rincian menu prasmanan dapat ditanyakan langsung kepada tim Kampung Sumber Alam melalui WhatsApp.")}
              en={lekat("Prices above are reconfirmed at booking. Terms and conditions apply. The total can change with the event date, the number of guests and paid extras not covered by the package, such as decoration, an MC or photography. Buffet menu details can be requested directly from the Kampung Sumber Alam team on WhatsApp.")}
            />
          </p>
          <a
            href={waLink("Halo, saya mau tanya paket acara di Kampung Sumber Alam.")}
            rel="noopener"
            target="_blank"
            class="btn btn-isi btn-wa mt-8"
          ><span class="btn-tx"><T id="Tanyakan paket melalui WhatsApp" en="Ask about packages on WhatsApp" /></span>
          </a>
        </div>
      </div>
    </section>
  </Halaman>
