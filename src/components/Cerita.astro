---
/**
 * Cerita beranda (naskah v3, disetujui Ryan 20 Nov 2026), diturunkan dari Our Story situs resmi:
 * keyakinan KSA (yang dirasakan tamu) -> air -> Rest -> Recover -> Rejuvenate -> janji dan nama
 * konsep. Teks persis dari naskah (src/i18n); kalau tidak muat, yang disesuaikan tata letaknya.
 *
 * Pembuka: penanda + judul + isi, lalu klip drone lebar kampung beratap ijuk (gerak pelan).
 * Babak: satu bidang warna rata per babak (Creative Direction 2027). Jumlah babak mengikuti
 * daftar BABAK (4-6 bisa), jenisnya klip, foto, atau teks. Penutup: judul, isi, tagline, lalu
 * klip drone yang naik menjauh dari kampung, mengantar ke peta foto udara di bawahnya.
 * Klip main sekali saat 45% terlihat lalu diam di frame terakhir; tanpa JS / gerak dikurangi,
 * posternya saja.
 */
import { Picture } from "astro:assets";
import { KLIP_ZONA, KLIP_CERITA } from "../data/drone";
import { rapiIsi, lekat, lekatJudul, kelompokJudul } from "../data/rag";
import KlipCerita from "./KlipCerita.astro";
/* sementara: foto malam lama sampai foto malam butir 5 lulus gerbang */
import fotoMalam from "../assets/images/hero-2-malam.webp";
import fotoPulang from "../assets/cerita/cerita-pulang.jpg";
/* Rest: frame drone 0085 setinggi mata (naskah v3), digrade lewat pipa butir 7 */
import fotoRest from "../assets/peta/zona-19-belakang-udara.jpg";

interface Props { t: (k: string) => string }
const { t } = Astro.props;

type Klip = (typeof KLIP_ZONA)[string];
type Babak = {
  n: number;
  jenis: "klip" | "teks" | "foto";
  bidang: "kertas" | "alam" | "petang" | "udara";
  foto?: ImageMetadata;
  klip?: Klip;
  goresan?: "kelapa" | "bunga" | "teratai" | "rumah";
  /** singkap halus: foto 1,06 -> 1 selama 1,4 dtk (babak malam) */
  halus?: boolean;
};
const BABAK: Babak[] = [
  /* klip Air khusus Cerita: segmen zona-02 dengan potongan tanpa motor, mobil, dan unit AC */
  { n: 1, jenis: "klip", bidang: "alam", klip: KLIP_CERITA["air"] ?? KLIP_ZONA["02"], goresan: "teratai" },
  { n: 2, jenis: "foto", bidang: "kertas", foto: fotoRest, goresan: "rumah" },
  { n: 3, jenis: "foto", bidang: "petang", foto: fotoMalam, goresan: "bunga", halus: true },
  { n: 4, jenis: "foto", bidang: "udara", foto: fotoPulang },
];
/* Aturan Ryan 20 Nov: dua media penuh lebar tidak boleh bersentuhan, dan tiap klip harus menjelaskan
   teks di dekatnya (klip tegak lurus yang abstrak diganti). Klip Cerita punya berkas sendiri
   (manifest `cerita`), terpisah dari klip zona yang dipakai panel peta:
   - pembuka: deret rumah kayu beratap ijuk dengan lereng Guntur (0080), duduk di antara judul dan isi
     pembuka, jadi isi memisahkannya dari klip babak Air;
   - penutup: rumah panggung beratap ijuk di atas balong, miring (0084 akhir), duduk SEBELUM coda:
     kampungnya terlihat dulu, lalu teks menyebut namanya, dan coda memisahkannya dari foto udara peta. */
const KLIP_BUKA = KLIP_CERITA["pembuka"];
const KLIP_TUTUP = KLIP_CERITA["penutup"];
/* kelompok makna judul (ID dan EN): baris hanya patah di antara frasa ini */
const GRUP: Record<string, string[]> = {
  /* pembuka v3.1 (dipilih Ryan 20 Nov): nama resort utuh, "dari apa yang tamu rasakan" satu kelompok */
  "cerita.judul": ["Kampung Sumber Alam", "mengukur liburan", "dari apa yang tamu rasakan.", "measures a holiday", "by how its guests feel."],
  "cerita.1.judul": ["Air panasnya sudah mengalir", "jauh sebelum", "resor ini berdiri.", "The hot springs were flowing", "long before", "the resort was built."],
  "cerita.2.judul": ["Tamu memakai", "hari pertamanya", "untuk berhenti", "dari urusan", "yang biasa dikejar.", "The first day is for", "stepping away", "from the usual chase."],
  "cerita.3.judul": ["Air hangat", "dan sambutan yang tulus", "membuat badan", "kembali segar.", "Warm water", "and a sincere welcome", "bring the body back."],
  "cerita.4.judul": ["Tamu pulang", "dengan tenaga baru", "dan cerita bersama", "orang terdekat.", "Guests leave", "with fresh energy", "and stories shared", "with the people", "closest to them."],
  /* coda: satu klausa per baris (lihat .coda-judul di situs.css), tiga baris terakhir = tiga gerak Rest, Recover, Rejuvenate */
  "cerita.coda.judul": ["Kampung Sumber Alam", "mengajak tamunya", "menepi sebentar,", "berkumpul lagi,", "lalu pulang lebih segar.", "invites its guests", "to step away for a while,", "gather again,", "and go home refreshed."],
  "cerita.coda": ["Rest –", "Recover –"],
};
const judul = (k: string) => kelompokJudul(t(k), GRUP[k]);
const no = (n: number) => String(n).padStart(2, "0");
const adaKlip = (k?: Klip) => !!(k && (k.desktop || k.hp));
---
<section class="cerita" id="cerita" aria-labelledby="h-cerita">
  {/* Pembuka: judul -> klip kampung -> isi. Isi berdiri di antara klip pembuka dan klip babak Air,
      jadi dua klip penuh lebar itu tidak bersentuhan; tanpa klip, isi kembali di bawah judul. */}
  <header class="cerita-kepala">
    <p class="lbl" data-muncul>{t("cerita.label")}</p>
    <h2 id="h-cerita" data-judul>{judul("cerita.judul")}</h2>
    {!adaKlip(KLIP_BUKA) && <p class="cerita-isi" data-nyala>{lekat(t("cerita.isi"))}</p>}
    <span class="goresan goresan--kelapa" aria-hidden="true"></span>
  </header>
  {adaKlip(KLIP_BUKA) && (
    <>
      <KlipCerita k={KLIP_BUKA!} alt={t("cerita.alt")} />
      <div class="cerita-lede"><p class="cerita-isi" data-nyala>{lekat(t("cerita.isi"))}</p></div>
    </>
  )}

  <ol class="babak-daftar">
    {BABAK.map((b) => {
      const video = b.jenis === "klip" && adaKlip(b.klip);
      const jenis = b.jenis === "teks" ? "babak--teks" : video ? "babak--video" : "babak--foto";
      return (
        <li class:list={["babak", `bidang-${b.bidang}`, jenis, { "babak--balik": b.jenis === "foto" && b.n % 2 === 0 }]} aria-labelledby={`h-babak-${b.n}`}>
          {video && (
            <figure class="babak-media" data-singkap>
              <KlipCerita k={b.klip!} alt={t(`cerita.${b.n}.alt`)} dalam />
            </figure>
          )}
          {b.jenis === "foto" && b.foto && (
            <figure class="babak-media" data-singkap={b.halus ? "halus" : ""}>
              <Picture src={b.foto} formats={["avif", "webp"]} widths={[480, 720, 960, 1200]} sizes="(min-width: 900px) 38vw, 100vw" quality={52} alt={t(`cerita.${b.n}.alt`)} loading="lazy" decoding="async" />
            </figure>
          )}
          <div class="babak-teks">
            <p class="babak-waktu" data-muncul><span class="babak-no">{no(b.n)}</span><span class="babak-garis" aria-hidden="true"></span><span lang={b.n > 1 ? "en" : undefined}>{t(`cerita.${b.n}.penanda`)}</span></p>
            {b.jenis === "teks" ? (
              <h3 id={`h-babak-${b.n}`} data-nyala>{judul(`cerita.${b.n}.judul`)}</h3>
            ) : (
              <h3 id={`h-babak-${b.n}`} data-judul>{judul(`cerita.${b.n}.judul`)}</h3>
            )}
            {b.jenis === "teks" ? (
              <p class="babak-isi" data-muncul-sesudah={`h-babak-${b.n}`}>{rapiIsi(t(`cerita.${b.n}.isi`))}</p>
            ) : (
              <p class="babak-isi" data-muncul>{rapiIsi(t(`cerita.${b.n}.isi`))}</p>
            )}
          </div>
          {/* goresan di pojok bawah bidang: tenggelam tegas di tepi bawah, bidang sesudahnya beda warna */}
          {b.goresan && <span class:list={["goresan", "goresan-babak", `goresan--${b.goresan}`]} aria-hidden="true"></span>}
        </li>
      );
    })}
  </ol>

  {adaKlip(KLIP_TUTUP) && <KlipCerita k={KLIP_TUTUP!} alt={t("cerita.coda.alt")} />}
  <div class="cerita-coda">
    <h3 class="coda-judul" data-judul>{judul("cerita.coda.judul")}</h3>
    <p class="coda-isi" data-muncul>{rapiIsi(t("cerita.coda.isi"))}</p>
    <p class="coda-kata" data-judul lang="en">{judul("cerita.coda")}</p>
  </div>
</section>

<script>
  import { gerakBoleh } from "../scripts/gerak";

  /* Klip drone babak: dimuat saat mendekat, main sekali saat terlihat, diam di frame terakhir.
     Gerak dikurangi / tanpa JS: poster saja. */
  const hp = () => window.matchMedia("(max-width: 767px)").matches;
  const videos = [...document.querySelectorAll<HTMLVideoElement>(".babak-video")];
  if (gerakBoleh() && videos.length && "IntersectionObserver" in window) {
    const siap = new WeakSet<HTMLVideoElement>();
    const pasang = (v: HTMLVideoElement) => {
      if (siap.has(v)) return;
      siap.add(v);
      const k = hp() ? "Hp" : "Dk";
      const webm = v.dataset[`webm${k}` as "webmHp"];
      const mp4 = v.dataset[`mp4${k}` as "mp4Hp"];
      if (webm) v.insertAdjacentHTML("beforeend", `<source src="${webm}" type="video/webm">`);
      if (mp4) v.insertAdjacentHTML("beforeend", `<source src="${mp4}" type="video/mp4">`);
      v.addEventListener("playing", () => v.classList.add("main"), { once: true });
      v.preload = "auto";
      v.load();
    };
    const dekat = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && pasang(e.target as HTMLVideoElement)), { rootMargin: "60% 0px" });
    const lihat = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) {
            pasang(v);
            if (!v.ended) v.play().catch(() => {});
          } else if (!v.paused) v.pause();
        }),
      { threshold: 0.45 },
    );
    videos.forEach((v) => {
      dekat.observe(v);
      lihat.observe(v);
    });
  }
</script>
