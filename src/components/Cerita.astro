---
/**
 * "Satu hari di Kampung Sumber Alam": cerita beranda dari check-in sampai check-out.
 *
 * Urutan babak mengikuti alur tamu di Data Master bab 01 §4.3
 * (Arrive → Slow Down → Soak → Recover → Renew → Return): datang, melambat,
 * berendam, malam di saung, pagi di atas balong, pulang. Semua fakta dari Data
 * Master (jam check-in/out bab 02 §7, keran air panas bab 01 §4.2, waktu terbaik
 * berendam bab 00 §4, menu Sunda bab 01 §4.4). Tawaran dan harga sengaja tidak ada
 * di sini: semuanya muncul sesudah cerita, sebagai akibatnya.
 *
 * Tiap babak satu bidang warna rata (Creative Direction 2027): siang Kertas,
 * petang Alam, malam Petang, pagi Udara. Dua babak memakai klip drone yang main
 * sekali lalu diam di frame terakhir; tanpa JS / gerak dikurangi, posternya saja.
 */
import { Picture } from "astro:assets";
import { KLIP_ZONA } from "../data/drone";
import { rapi as lekat, rapiIsi } from "../data/rag";
import fotoDatang from "../assets/cerita/cerita-datang.jpg";
import fotoBerendam from "../assets/cerita/cerita-berendam.jpg";
/* malam & pagi: foto malam dan pagi berkabut milik situs resmi lama Kampung Sumber Alam
   (src/assets/images); belum ada foto saung petang atau makan bersama yang jujur */
import fotoMalam from "../assets/images/hero-2-malam.webp";
import fotoPagi from "../assets/images/kampung-pagi-berkabut.webp";
import fotoPulang from "../assets/cerita/cerita-pulang.jpg";
import cadangan2 from "../assets/peta/henti-kumpul.jpg";

interface Props { t: (k: string) => string }
const { t } = Astro.props;

type Babak = {
  n: number;
  bidang: "kertas" | "alam" | "petang" | "udara";
  foto?: ImageMetadata;
  klip?: (typeof KLIP_ZONA)[string];
  cadangan?: ImageMetadata;
  goresan?: "kelapa" | "bunga" | "teratai" | "rumah";
};
const BABAK: Babak[] = [
  { n: 1, bidang: "kertas", foto: fotoDatang, goresan: "rumah" },
  { n: 2, bidang: "kertas", klip: KLIP_ZONA["19"], cadangan: cadangan2 },
  { n: 3, bidang: "alam", foto: fotoBerendam, goresan: "teratai" },
  { n: 4, bidang: "petang", foto: fotoMalam, goresan: "bunga" },
  { n: 5, bidang: "udara", foto: fotoPagi, goresan: "kelapa" },
  { n: 6, bidang: "kertas", foto: fotoPulang },
];
const no = (n: number) => String(n).padStart(2, "0");
---
<section class="cerita" aria-labelledby="h-cerita">
  <header class="cerita-kepala">
    <p class="lbl" data-muncul>{t("cerita.label")}</p>
    <h2 id="h-cerita" data-judul>{lekat(t("cerita.judul"))}</h2>
    <span class="goresan goresan--kelapa" aria-hidden="true"></span>
  </header>

  <ol class="babak-daftar">
    {BABAK.map((b) => {
      const k = b.klip;
      const video = !!(k && (k.desktop || k.hp));
      return (
        <li class:list={["babak", `bidang-${b.bidang}`, video ? "babak--video" : "babak--foto", { "babak--balik": b.n % 2 === 0 }]} aria-labelledby={`h-babak-${b.n}`}>
          {video ? (
            <figure class="babak-media" data-singkap>
              <picture class="babak-poster">
                {k!.hp?.posterAvif && <source media="(max-width: 767px)" srcset={k!.hp.posterAvif} type="image/avif" />}
                {k!.hp?.poster && <source media="(max-width: 767px)" srcset={k!.hp.poster} type="image/jpeg" />}
                {k!.desktop?.posterAvif && <source srcset={k!.desktop.posterAvif} type="image/avif" />}
                <img src={k!.desktop?.poster ?? k!.hp?.poster} width={k!.desktop?.w ?? 1280} height={k!.desktop?.h ?? 720} alt={t(`cerita.${b.n}.alt`)} loading="lazy" decoding="async" />
              </picture>
              <video class="babak-video" muted playsinline preload="none" aria-hidden="true"
                data-mp4-dk={k!.desktop?.mp4} data-webm-dk={k!.desktop?.webm}
                data-mp4-hp={k!.hp?.mp4 ?? k!.desktop?.mp4} data-webm-hp={k!.hp?.webm ?? k!.desktop?.webm}></video>
            </figure>
          ) : (
            <figure class="babak-media" data-singkap>
              <Picture src={(b.foto ?? b.cadangan)!} formats={["avif", "webp"]} widths={[480, 720, 960, 1200]} sizes="(min-width: 900px) 38vw, 100vw" quality={52} alt={t(`cerita.${b.n}.alt`)} loading="lazy" decoding="async" />
            </figure>
          )}
          <div class="babak-teks">
            <p class="babak-waktu" data-muncul><span class="babak-no">{no(b.n)}</span><span class="babak-garis" aria-hidden="true"></span><span>{t(`cerita.${b.n}.waktu`)}</span></p>
            <h3 id={`h-babak-${b.n}`} data-judul>{lekat(t(`cerita.${b.n}.judul`))}</h3>
            <p class="babak-isi" data-muncul>{rapiIsi(t(`cerita.${b.n}.isi`))}</p>
          </div>
          {/* goresan di pojok bidang, menjauhi teks dan terpotong tepi bidang (CD 2027) */}
          {b.goresan && <span class:list={["goresan", "goresan-babak", `goresan--${b.goresan}`]} aria-hidden="true"></span>}
        </li>
      );
    })}
  </ol>

  <div class="cerita-coda">
    <div class="bilik bilik-lebar" role="presentation"></div>
    <p class="coda-kata" data-judul lang="en">{t("cerita.coda")}</p>
    <ol class="coda-arti">
      {["Rest", "Recover", "Rejuvenate"].map((k, i) => (
        <li data-muncul><p class="coda-kunci" lang="en">{k}</p><p>{rapiIsi(t(`cerita.coda.${i + 1}`))}</p></li>
      ))}
    </ol>
    <div class="bilik bilik-lebar" role="presentation"></div>
  </div>
</section>

<script>
  import { gerakBoleh } from "../scripts/gerak";

  /* Klip drone babak: dimuat saat mendekat, main sekali saat terlihat, diam di frame terakhir.
     Gerak dikurangi / tanpa JS: poster saja. */
  const hp = () => window.matchMedia("(max-width: 767px)").matches;
  const videos = [...document.querySelectorAll<HTMLVideoElement>(".babak-video")];
  if (gerakBoleh() && videos.length && "IntersectionObserver" in window) {
    const siap = new WeakSet<HTMLVideoElement>();
    const pasang = (v: HTMLVideoElement) => {
      if (siap.has(v)) return;
      siap.add(v);
      const k = hp() ? "Hp" : "Dk";
      const webm = v.dataset[`webm${k}` as "webmHp"];
      const mp4 = v.dataset[`mp4${k}` as "mp4Hp"];
      if (webm) v.insertAdjacentHTML("beforeend", `<source src="${webm}" type="video/webm">`);
      if (mp4) v.insertAdjacentHTML("beforeend", `<source src="${mp4}" type="video/mp4">`);
      v.addEventListener("playing", () => v.classList.add("main"), { once: true });
      v.preload = "auto";
      v.load();
    };
    const dekat = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && pasang(e.target as HTMLVideoElement)), { rootMargin: "60% 0px" });
    const lihat = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) {
            pasang(v);
            if (!v.ended) v.play().catch(() => {});
          } else if (!v.paused) v.pause();
        }),
      { threshold: 0.45 },
    );
    videos.forEach((v) => {
      dekat.observe(v);
      lihat.observe(v);
    });
  }
</script>
