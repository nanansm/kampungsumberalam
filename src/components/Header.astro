---
import { NAMA_PANJANG } from "../data/content";
---

<header class="mx-auto flex max-w-[1200px] items-center justify-between px-5 py-5 sm:px-8">
  <a href="/" aria-label={NAMA_PANJANG} class="shrink-0">
    <img
      src="/logo/logotype-color.svg"
      alt={NAMA_PANJANG}
      width="140"
      height="30"
      class="h-6 w-auto sm:h-7"
    />
  </a>

  <div class="flex items-center gap-1 text-[0.8125rem]">
    <button
      type="button"
      data-set-lang="id"
      class="lang px-2 py-1 text-tinta-lembut"
      aria-label="Bahasa Indonesia">ID</button
    >
    <span aria-hidden="true" class="text-garis">/</span>
    <button
      type="button"
      data-set-lang="en"
      class="lang px-2 py-1 text-tinta-lembut"
      aria-label="English">EN</button
    >
  </div>
</header>
